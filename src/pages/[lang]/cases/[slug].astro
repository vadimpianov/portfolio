---
/**
 * Адрес кейса (прямой заход, перезагрузка): та же главная, а кейс поверх неё — в модалке,
 * уже открытой (как после клика по плитке). Закрыть — главная, адрес /<lang>/.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseArticle from '../../../components/CaseArticle.astro';
import CaseDrawer from '../../../components/CaseDrawer.astro';
import HomeContent from '../../../components/HomeContent.astro';
import { getCases, parseCaseId } from '../../../i18n/content';
import { locales } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (lang) =>
      (await getCases(lang)).map((entry) => ({
        params: { lang, slug: parseCaseId(entry.id).slug },
        props: { entry },
      })),
    ),
  );
  return paths.flat();
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <HomeContent />
  <CaseDrawer open>
    <CaseArticle entry={entry} />
  </CaseDrawer>
</BaseLayout>
