---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCases, parseCaseId } from '../../i18n/content';
import type { Locale } from '../../i18n/ui';
import { getLocaleStaticPaths, localePath, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLocaleStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const cases = await getCases(lang);
---

<BaseLayout>
  <section class="hero">
    <h1 class="hero__title" data-reveal>
      {t('home.heading')}
    </h1>
    <p class="hero__lead" data-reveal>
      {t('home.lead')}
    </p>
  </section>

  {cases.length > 0 && (
    <section>
      <h2>{t('home.cases')}</h2>
      <ul>
        {cases.map((entry) => (
          <li>
            <a href={localePath(lang, `cases/${parseCaseId(entry.id).slug}`)}>{entry.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: clamp(3rem, 2rem + 6vw, 8rem) var(--page-gutter);
  }

  .hero__title {
    max-width: 72rem;
    font-size: var(--text-display);
    font-weight: var(--weight-heavy);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 47.5rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    color: var(--color-text-body);
    text-wrap: pretty;
  }
</style>

<script>
  import { onPage, gsap } from '../../scripts/motion';

  // Проверка связки GSAP + View Transitions. Заменим настоящими анимациями.
  onPage(({ reducedMotion }) => {
    if (reducedMotion) return;
    gsap.from('[data-reveal]', { y: 16, autoAlpha: 0, duration: 0.6, stagger: 0.08, ease: 'power2.out' });
  });
</script>
