---
import CaseDrawer from '../../components/CaseDrawer.astro';
import HomeContent from '../../components/HomeContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleStaticPaths } from '../../i18n/utils';

export const getStaticPaths = getLocaleStaticPaths;
---

<BaseLayout>
  <HomeContent />
  <CaseDrawer />
</BaseLayout>

<script>
  import { onPage, gsap } from '../../scripts/motion';

  // Проверка связки GSAP + View Transitions. Заменим настоящими анимациями.
  onPage(({ reducedMotion }) => {
    if (reducedMotion) return;
    gsap.from('[data-reveal]', { y: 16, autoAlpha: 0, duration: 0.6, stagger: 0.08, ease: 'power2.out' });
  });
</script>
