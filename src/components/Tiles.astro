---
import type { Locale } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

/** Второй слайд: плитки 2 × 2 — проект, подпись и картинка (подпись и картинка пока заглушки). */
const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
// Фон каждой плашки — одна крупная абстрактная композиция «по мотивам» растений:
// широкие формы на всю плашку, уходят за края. Координаты — в поле 400 × 450 (пропорция плитки).
const petal = (cx: number, cy: number, length: number, width: number, angle: number) =>
  `<path d="M0 0 C ${width} ${-length * 0.3} ${width * 0.8} ${-length * 0.85} 0 ${-length} C ${-width * 0.8} ${-length * 0.85} ${-width} ${-length * 0.3} 0 0 Z" transform="translate(${cx} ${cy}) rotate(${angle})"/>`;

// Лист с центральной прожилкой: основание в (cx, cy), угол от вертикали вверх.
const veinedLeaf = (cx: number, cy: number, length: number, width: number, angle: number) =>
  petal(cx, cy, length, width, angle) +
  `<path class="vein" d="M0 0 Q ${width * 0.12} ${-length * 0.5} 0 ${-length * 0.94}" transform="translate(${cx} ${cy}) rotate(${angle})"/>`;

const PRINTS = [
  // Веер из трёх длинных листьев из левого нижнего угла.
  veinedLeaf(-20, 480, 620, 150, 14) +
    veinedLeaf(-20, 480, 540, 135, 44) +
    veinedLeaf(-20, 480, 450, 115, 74),
  // Два огромных листа крест-накрест с центральными прожилками (утверждён).
  petal(-30, 470, 560, 170, 28) +
    petal(430, 500, 520, 150, -34) +
    '<path d="M-30 470 Q 90 250 230 -20" class="vein"/><path d="M430 500 Q 330 260 150 60" class="vein"/>',
  // Два листа из верхних углов, скрещиваются внизу.
  veinedLeaf(430, -30, 580, 165, -148) + veinedLeaf(-30, -40, 520, 145, 150),
  // Огромный лист по диагонали из правого нижнего угла и второй поперёк слева.
  veinedLeaf(440, 490, 660, 205, -42) + veinedLeaf(-50, 250, 400, 115, 68),
];
const TITLE_KEYS = ['tiles.1.title', 'tiles.2.title', 'tiles.3.title', 'tiles.4.title'] as const;
// Бегущая строка с логотипами компаний — между рядами проектов (после второй плитки).
// Файлы — public/logos/ (viewBox обрезан по содержимому); scale — оптическая подгонка высоты:
// у значков с подписью и у узких надписей разная «визуальная масса».
const LOGOS: { name: string; src: string; scale: number }[] = [
  { name: t('tiles.1.title'), src: '/logos/alfa-bank.svg', scale: 0.8 },
  { name: 'Quantori', src: '/logos/quantori.svg', scale: 0.95 },
  { name: 'BelkaCar', src: '/logos/belkacar.svg', scale: 0.62 },
  { name: 'MAPS.ME', src: '/logos/mapsme.svg', scale: 1.2 },
  { name: t('tiles.4.title'), src: '/logos/m2.svg', scale: 1.1 },
  { name: 'Parity', src: '/logos/parity.svg', scale: 1 },
];
const MARQUEE_AFTER = 2;
// Логотипы повторены, чтобы одной группы хватало на самый широкий экран; групп две — для бесшовного цикла.
const marqueeGroup = Array.from({ length: 4 }, () => LOGOS).flat();
const tiles = TITLE_KEYS.map((key) => ({
  title: t(key),
  lead: t('tiles.placeholder.lead'),
}));
---

<section class="tiles" data-tiles>
  {tiles.map(({ title, lead }, i) => (
    <>
      {i === MARQUEE_AFTER && (
        <div class="tiles__marquee" data-bleed>
          <div class="tiles__marquee-track">
            {[0, 1].map((copy) => (
              <ul class="tiles__marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                {marqueeGroup.map(({ name, src, scale }) => (
                  <li class="tiles__logo" style={`--logo-scale: ${scale}`}>
                    <img src={src} alt={copy === 0 ? name : ''} loading="lazy" />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      )}
      <article class="tiles__item" style={`--tile-color: var(--tile-color-${(i % 4) + 1})`}>
        <div class="tiles__plate" aria-hidden="true">
          <svg
            class="tiles__print"
            viewBox="0 0 400 450"
            preserveAspectRatio="xMidYMid slice"
            set:html={PRINTS[i % PRINTS.length]}
          />
        </div>
        <div class="tiles__body">
          <h2 class="tiles__title">{title}</h2>
          <p class="tiles__lead">{lead}</p>
          <div class="tiles__image" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <circle cx="9" cy="10" r="2" />
              <path d="m21 16-5-5-9 9" />
            </svg>
          </div>
        </div>
      </article>
    </>
  ))}
</section>

<style>
  /* От линии до линии сетки (--gutter), между плитками — --tile-gap. */
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--tile-gap);
    /* Плитки заезжают на первый слайд: верх первого ряда — на --tiles-start от верха экрана.
       Проявляются при скролле (см. Hero.astro). */
    margin-top: calc(var(--tiles-start) - 100dvh);
    /* Снизу — место, чтобы последний ряд тоже мог встать верхом на --tiles-final-top (snap). */
    padding: 0 var(--gutter) max(var(--tile-gap), calc(100dvh - var(--tiles-final-top) - var(--tile-est-h)));
    /* Оценка высоты плитки: ширина колонки × (высота / ширина). */
    --tile-est-h: calc((100vw - 2 * var(--gutter)) * 1.5);
  }

  @media (min-width: 768px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
      --tile-est-h: calc((100vw - 2 * var(--gutter) - var(--tile-gap)) / 2 * 1.125);
    }
  }

  /* Плашка (фон) и содержимое проявляются раздельно (см. Hero.astro):
     содержимое — с запаздыванием и своим параллаксом, в финале без прозрачности. */
  .tiles__item {
    position: relative;
    isolation: isolate;
    aspect-ratio: var(--tile-ratio);
    overflow: hidden;
    border-radius: var(--tile-radius);
    color: var(--color-text);
  }

  .tiles__plate {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--tile-color, #fff) var(--tile-bg-opacity), transparent);
  }

  /* Принт — крупные формы поверх заливки плашки, проявляются вместе с ней. */
  .tiles__print {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--tile-print-fill);
    stroke: var(--tile-print);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .tiles__print :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .tiles__print :global(.vein) {
    fill: none;
  }

  /* Текст сверху, картинка занимает остаток и уходит в нижний край плитки. */
  .tiles__body {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--tile-padding) var(--tile-padding) 0;
  }

  .tiles__title {
    font-size: var(--text-tile-title);
    font-weight: var(--weight-heavy);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tiles__lead {
    max-width: 36rem;
    margin-top: 0.75rem;
    font-size: var(--text-tile-lead);
    line-height: 1.5;
    color: var(--color-text-body);
  }

  /* Бегущая строка с логотипами: на всю ширину экрана, между рядами плиток, едет влево без конца. */
  .tiles__marquee {
    grid-column: 1 / -1;
    margin-inline: calc(-1 * var(--gutter));
    padding-block: 4px;
    overflow: hidden;
    color: var(--color-text);
    /* Края растворяются, логотипы появляются и уходят мягко. */
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .tiles__marquee-track {
    display: flex;
    width: max-content;
    animation: tiles-marquee 80s linear infinite;
  }

  .tiles__marquee-group {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
    margin: 0;
    list-style: none;
  }

  /* Высота строки — по самому высокому логотипу, чтобы ни один не обрезался сверху и снизу. */
  .tiles__logo {
    display: flex;
    flex: none;
    align-items: center;
  }

  /* Логотипы — в своих фирменных цветах. */
  .tiles__logo img {
    height: calc(var(--marquee-logo-h) * var(--logo-scale, 1));
    width: auto;
  }

  @keyframes tiles-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tiles__marquee-track {
      animation: none;
    }
  }

  /* Условная картинка — пока заглушка. */
  .tiles__image {
    display: grid;
    flex: 1;
    place-items: center;
    margin-top: 2rem;
    border-radius: calc(var(--tile-radius) - 4px) calc(var(--tile-radius) - 4px) 0 0;
    background: #e2e2e2;
  }

  .tiles__image svg {
    width: 48px;
    height: 48px;
    fill: none;
    stroke: #a3a3a3;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
