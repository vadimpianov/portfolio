---
/** Второй слайд: сетка плиток 3 × 2. Пока пустые — контент решим позже. */
const tiles = Array.from({ length: 6 });
---

<section class="tiles" data-tiles>
  {tiles.map(() => (
    <div class="tiles__item" />
  ))}
</section>

<style>
  /* От линии до линии сетки (--gutter), между плитками — --tile-gap. */
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--tile-gap);
    /* Плитки заезжают на первый слайд: верх первого ряда — на --tiles-start от верха экрана.
       Проявляются при скролле (см. Hero.astro). */
    margin-top: calc(var(--tiles-start) - 100dvh);
    padding: 0 var(--gutter) var(--tile-gap);
  }

  @media (min-width: 768px) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tiles__item {
    height: var(--tile-h);
    border-radius: var(--tile-radius);
    background: var(--tile-bg);
  }
</style>
