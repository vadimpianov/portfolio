---
import { asset } from '../utils/asset';
import type { Locale, UIKey } from '../i18n/ui';
import { getLocaleFromUrl, localePath, useTranslations } from '../i18n/utils';

/** Второй слайд: плитки 2 × 2 — год, проект, подпись и картинка; ниже ещё 6 карточек по 3 в ряд — год, проект, подпись.
    Подписи, картинки и годы пока заглушки. */
const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
// Фон каждой плашки — одна крупная абстрактная композиция «по мотивам» растений:
// широкие формы на всю плашку, уходят за края. Координаты — в поле 400 × 450 (пропорция плитки).
const petal = (cx: number, cy: number, length: number, width: number, angle: number) =>
  `<path d="M0 0 C ${width} ${-length * 0.3} ${width * 0.8} ${-length * 0.85} 0 ${-length} C ${-width * 0.8} ${-length * 0.85} ${-width} ${-length * 0.3} 0 0 Z" transform="translate(${cx} ${cy}) rotate(${angle})"/>`;

// Лист с центральной прожилкой: основание в (cx, cy), угол от вертикали вверх.
const veinedLeaf = (cx: number, cy: number, length: number, width: number, angle: number) =>
  petal(cx, cy, length, width, angle) +
  `<path class="vein" d="M0 0 Q ${width * 0.12} ${-length * 0.5} 0 ${-length * 0.94}" transform="translate(${cx} ${cy}) rotate(${angle})"/>`;

const PRINTS = [
  // Веер из трёх длинных листьев из левого нижнего угла.
  veinedLeaf(-20, 480, 620, 150, 14) +
    veinedLeaf(-20, 480, 540, 135, 44) +
    veinedLeaf(-20, 480, 450, 115, 74),
  // Два огромных листа крест-накрест с центральными прожилками (утверждён).
  petal(-30, 470, 560, 170, 28) +
    petal(430, 500, 520, 150, -34) +
    '<path d="M-30 470 Q 90 250 230 -20" class="vein"/><path d="M430 500 Q 330 260 150 60" class="vein"/>',
  // Два листа из верхних углов, скрещиваются внизу.
  veinedLeaf(430, -30, 580, 165, -148) + veinedLeaf(-30, -40, 520, 145, 150),
  // Огромный лист по диагонали из правого нижнего угла и второй поперёк слева.
  veinedLeaf(440, 490, 660, 205, -42) + veinedLeaf(-50, 250, 400, 115, 68),
];
// Бегущая строка с логотипами компаний — между рядами проектов (после второй плитки).
// Файлы — public/logos/ (viewBox обрезан по содержимому); scale — оптическая подгонка высоты:
// у значков с подписью и у узких надписей разная «визуальная масса».
// url — сайт компании (открывается в новой вкладке); без url логотип не кликается.
const LOGOS: { name: string; src: string; scale: number; url?: string }[] = [
  { name: t('tiles.1.title'), src: '/logos/alfa-bank.svg', scale: 0.8, url: 'https://alfabank.ru/' },
  { name: 'Quantori', src: '/logos/quantori.svg', scale: 0.95, url: 'https://www.quantori.com/' },
  { name: 'BelkaCar', src: '/logos/belkacar.svg', scale: 0.62, url: 'https://belkacar.ru/' },
  { name: 'MAPS.ME', src: '/logos/mapsme.svg', scale: 1.2 },
  { name: t('tiles.4.title'), src: '/logos/m2.svg', scale: 1.1, url: 'https://m2.ru/' },
  { name: 'Parity', src: '/logos/parity.svg', scale: 1, url: 'https://parity.com/' },
  { name: 'LEXION development', src: '/logos/lexion.svg', scale: 1.9, url: 'https://lexion-development.ru/' },
  {
    name: locale === 'ru' ? '2ГИС' : '2GIS',
    src: '/logos/2gis.svg',
    scale: 0.85,
    url: 'https://2gis.ru/moscow',
  },
  {
    name: locale === 'ru' ? 'Лига Ставок' : 'Liga Stavok',
    src: '/logos/ligastavok.svg',
    scale: 0.9,
    url: 'https://www.ligastavok.ru/',
  },
  { name: 'Brighty', src: '/logos/brighty.svg', scale: 1, url: 'https://brighty.app/en' },
];
const MARQUEE_AFTER = 2;
// Логотипы повторены, чтобы одной группы хватало на самый широкий экран; групп две — для бесшовного цикла.
const marqueeGroup = Array.from({ length: 4 }, () => LOGOS).flat();
// Проекты по убыванию дат (от свежих к старым). Годы одинаковы в обеих локалях.
// Картинки проектов вместо заглушки: WebP с прозрачностью, 600 и 1200px по ширине
// (исходники — в design/cases/, в сборку не попадают). Нет картинки — серая заглушка.
const TILE_IMAGES: Partial<Record<string, string>> = {
  // Betting — экраны из обложки кейса, мельче, чем у «Метра квадратного».
  'tiles.2.title': 'betting-tile',
  // Quantori — карточки экранов PharmaKB внахлёст (design/cases/quantori/tile.py).
  'tiles.3.title': 'quantori-tile',
  'tiles.4.title': 'metr-kvadratny',
};
// Страницы кейсов: плитка целиком ведёт на кейс (ссылка в заголовке растянута на плитку).
const TILE_CASES: Partial<Record<string, string>> = {
  'tiles.2.title': 'betting',
  'tiles.3.title': 'quantori',
  'tiles.4.title': 'metr-kvadratny',
};
// Описания плиток (у остальных пока заглушка).
const TILE_LEADS: Partial<Record<string, UIKey>> = {
  'tiles.2.title': 'tiles.2.lead',
  'tiles.3.title': 'tiles.3.lead',
  'tiles.4.title': 'tiles.4.lead',
};

// Подпись заглушки для плиток, у которых кейс ещё не готов (нет картинки).
const soon = t('case.soon');
const tiles = (
  [
    ['tiles.1.title', '2024–2026'],
    ['tiles.2.title', '2023–2024'],
    ['tiles.3.title', '2022–2023'],
    ['tiles.4.title', '2020–2022'],
  ] as const
).map(([key, year]) => ({
  year,
  title: t(key),
  lead: t(TILE_LEADS[key] ?? 'tiles.placeholder.lead'),
  image: TILE_IMAGES[key],
  href: TILE_CASES[key] && localePath(locale, `cases/${TILE_CASES[key]}`),
}));
// Карточки ниже основных плиток: без картинки, 3 в ряд (на планшете 2, на мобиле 1).
const more = (
  [
    ['tiles.6.title', '2019–2020'],
    ['tiles.5.title', '2018–2019'],
    ['tiles.7.title', '2017–2018'],
    ['tiles.10.title', '2015–2017'],
    ['tiles.9.title', '2014–2015'],
    ['tiles.8.title', '2012–2014'],
  ] as const
).map(([key, year]) => ({ year, title: t(key), lead: t(key.replace('.title', '.lead') as UIKey) }));
---

<section class="tiles" data-tiles>
  {tiles.map(({ year, title, lead, image, href }, i) => (
    <>
      {i === MARQUEE_AFTER && (
        <div class="tiles__marquee" data-bleed>
          <div class="tiles__marquee-track">
            {[0, 1].map((copy) => (
              <ul class="tiles__marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
                {marqueeGroup.map(({ name, src, scale, url }, j) => {
                  // Для клавиатуры и скринридеров — только первый набор логотипов, повторы скрыты.
                  const primary = copy === 0 && j < LOGOS.length;
                  const img = <img src={src} alt={primary ? name : ''} loading="lazy" />;
                  return (
                    <li class="tiles__logo" style={`--logo-scale: ${scale}`}>
                      {url ? (
                        <a
                          href={url}
                          target="_blank"
                          rel="noopener noreferrer"
                          tabindex={primary ? undefined : -1}
                          aria-hidden={primary ? undefined : 'true'}
                        >
                          {img}
                        </a>
                      ) : (
                        img
                      )}
                    </li>
                  );
                })}
              </ul>
            ))}
          </div>
        </div>
      )}
      <article class="tiles__item" style={`--tile-color: var(--tile-color-${(i % 4) + 1})`}>
        <div class="tiles__plate" aria-hidden="true">
          <svg
            class="tiles__print"
            viewBox="0 0 400 450"
            preserveAspectRatio="xMidYMid slice"
            set:html={PRINTS[i % PRINTS.length]}
          />
        </div>
        <div class="tiles__body">
          <p class="tiles__year">{year}</p>
          <h2 class="tiles__title">
            {href ? (
              <a class="tiles__link" href={href} data-case-link>
                {title}
              </a>
            ) : (
              title
            )}
          </h2>
          <p class="tiles__lead">{lead}</p>
          {image ? (
            <div class="tiles__image tiles__image--shot">
              <img
                src={asset(`/images/cases/${image}-600.webp`)}
                srcset={`${asset(`/images/cases/${image}-600.webp`)} 600w, ${asset(`/images/cases/${image}-1200.webp`)} 1200w`}
                sizes="(min-width: 768px) 40vw, 90vw"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            // Кейс ещё не готов: экран телефона сам собирается по блокам, курсор их «расставляет»,
            // поперёк — лента «Кейс в разработке».
            <div class="tiles__image tiles__soon" aria-label={soon} role="img">
              <svg class="tiles__soon-phone" viewBox="0 0 240 420" aria-hidden="true">
                <rect class="tiles__soon-body" x="20.5" y="10.5" width="199" height="399" rx="34" />
                <rect class="tiles__soon-notch" x="95" y="22" width="50" height="10" rx="5" />
                <rect class="tiles__soon-b b1" x="40" y="48" width="90" height="12" rx="6" />
                <circle class="tiles__soon-b b2" cx="190" cy="54" r="10" />
                <g class="tiles__soon-b b3">
                  <rect x="40" y="76" width="160" height="96" rx="16" fill="#ef3124" />
                  <rect x="56" y="92" width="28" height="20" rx="4" fill="#fff" opacity="0.85" />
                  <rect x="56" y="146" width="96" height="8" rx="4" fill="#fff" opacity="0.85" />
                </g>
                <g class="tiles__soon-b b4">
                  <circle cx="54" cy="210" r="14" />
                  <rect x="78" y="200" width="96" height="9" rx="4.5" />
                  <rect x="78" y="215" width="60" height="7" rx="3.5" opacity="0.6" />
                </g>
                <g class="tiles__soon-b b5">
                  <circle cx="54" cy="258" r="14" />
                  <rect x="78" y="248" width="110" height="9" rx="4.5" />
                  <rect x="78" y="263" width="72" height="7" rx="3.5" opacity="0.6" />
                </g>
                <rect class="tiles__soon-b b6 tiles__soon-cta" x="40" y="340" width="160" height="40" rx="20" />
                <path
                  class="tiles__soon-cursor"
                  d="M0 0v22l6-6 4 10 4-2-4-9.5h8.5z"
                  fill="#141414"
                  stroke="#fff"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
              <div class="tiles__soon-tape" aria-hidden="true">
                <div class="tiles__soon-track">
                  {Array.from({ length: 12 }, () => (
                    <span>{soon} ✦</span>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      </article>
    </>
  ))}
  <div class="tiles__more">
    {more.map(({ year, title, lead }, i) => (
      <article
        class="tiles__item tiles__item--small"
        style={`--tile-color: var(--tile-color-${((i + 4) % 4) + 1})`}
      >
        <div class="tiles__plate" aria-hidden="true">
          <svg
            class="tiles__print"
            viewBox="0 0 400 450"
            preserveAspectRatio="xMidYMid slice"
            set:html={PRINTS[(i + 1) % PRINTS.length]}
          />
        </div>
        <div class="tiles__body">
          <p class="tiles__year">{year}</p>
          <h2 class="tiles__title">{title}</h2>
          <p class="tiles__lead">{lead}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* От линии до линии сетки (--gutter), между плитками — --tile-gap. */
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--tile-gap);
    /* Плитки заезжают на первый слайд: верх первого ряда — на --tiles-start от верха экрана.
       Проявляются при скролле (см. Hero.astro). */
    margin-top: calc(var(--tiles-start) - 100svh);
    /* Снизу — место, чтобы последний ряд тоже мог встать верхом на --tiles-final-top (snap). */
    padding: 0 var(--gutter)
      round(max(var(--tile-gap), calc(100svh - var(--tiles-final-top) - var(--tile-est-h))), 2px);
    /* Оценка высоты плитки: ширина колонки × (высота / ширина). */
    --tile-est-h: calc((100vw - 2 * var(--gutter)) * 1.5);
  }

  @media (min-width: 768px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
      --tile-est-h: calc((100vw - 2 * var(--gutter) - var(--tile-gap)) / 2 * 1.125);
    }
  }

  /* Плашка (фон) и содержимое проявляются раздельно (см. Hero.astro):
     содержимое — с запаздыванием и своим параллаксом, в финале без прозрачности. */
  .tiles__item {
    position: relative;
    /* Реакция на наведение — через top: GSAP ставит свои transform/translate инлайном. */
    top: 0;
    transition:
      top 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.5s ease;
    isolation: isolate;
    aspect-ratio: var(--tile-ratio);
    overflow: hidden;
    border-radius: var(--tile-radius);
    color: var(--color-text);
  }

  .tiles__link {
    color: inherit;
    text-decoration: none;
  }

  /* Вся плитка кликабельна: зона ссылки растянута на плитку. */
  .tiles__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .tiles__link:focus-visible {
    outline: none;
  }

  .tiles__item:has(.tiles__link:focus-visible) {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .tiles__plate {
    transition: --tile-bg-opacity 0.5s ease;
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--tile-color, #fff) var(--tile-bg-opacity), transparent);
  }

  /* Принт — крупные формы поверх заливки плашки, проявляются вместе с ней. */
  .tiles__print {
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    transform-origin: 50% 60%;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--tile-print-fill);
    stroke: var(--tile-print);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .tiles__print :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .tiles__print :global(.vein) {
    fill: none;
  }

  /* Текст сверху, картинка занимает остаток и уходит в нижний край плитки. */
  .tiles__body {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--tile-padding) var(--tile-padding) 0;
  }

  /* Год — над названием, тем же кеглем, что и подпись. */
  .tiles__year {
    margin-bottom: 8px;
    font-size: var(--text-tile-lead);
    --lh: 1.5;
    color: var(--color-text-body);
  }

  .tiles__title {
    font-size: var(--text-tile-title);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    letter-spacing: var(--tracking-title);
  }

  .tiles__lead {
    max-width: 576px;
    margin-top: 12px;
    font-size: var(--text-tile-lead);
    --lh: 1.5;
    color: var(--color-text-body);
  }

  /* Ещё 6 карточек под основными плитками: ширина — от полей и зазора сетки (3 в ряд на десктопе,
     2 на планшете, 1 на мобиле), высота — не меньше ширины × --tile-small-ratio (3:4) и растёт,
     если текст не влезает; все ряды одной высоты — по самой высокой карточке. */
  .tiles__more {
    --more-cols: 1;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(var(--more-cols), minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--tile-gap);
    container-type: inline-size;
  }

  @media (min-width: 768px) {
    .tiles__more {
      --more-cols: 2;
    }
  }

  @media (min-width: 1280px) {
    .tiles__more {
      --more-cols: 3;
    }
  }

  /* Обрезает принт сама плашка, а не карточка — тогда карточка может вырасти под длинный текст. */
  .tiles__item--small {
    min-height: round(
      calc((100cqw - (var(--more-cols) - 1) * var(--tile-gap)) / var(--more-cols) * var(--tile-small-ratio)),
      2px
    );
    aspect-ratio: auto;
    overflow: visible;
  }

  .tiles__item--small .tiles__plate {
    overflow: hidden;
    border-radius: inherit;
  }

  .tiles__item--small .tiles__body {
    height: auto;
    padding-bottom: var(--tile-padding);
  }

  .tiles__item--small .tiles__title {
    font-size: var(--text-tile-small-title);
  }

  /* Бегущая строка с логотипами: на всю ширину экрана, между рядами плиток, едет влево без конца. */
  .tiles__marquee {
    grid-column: 1 / -1;
    margin-inline: calc(-1 * var(--gutter));
    padding-block: 4px;
    /* Отступ до карточек — половина зазора между ними (сетка даёт полный --tile-gap, забираем половину). */
    margin-block: calc(var(--tile-gap) / -2);
    overflow: hidden;
    color: var(--color-text);
    /* Края растворяются, логотипы появляются и уходят мягко. */
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .tiles__marquee-track {
    display: flex;
    width: max-content;
    animation: tiles-marquee 160s linear infinite;
  }

  .tiles__marquee-group {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
    margin: 0;
    list-style: none;
  }

  /* Высота строки — по самому высокому логотипу, чтобы ни один не обрезался сверху и снизу. */
  .tiles__logo {
    display: flex;
    flex: none;
    align-items: center;
  }

  /* Логотипы — в своих фирменных цветах. */
  .tiles__logo img {
    height: round(calc(var(--marquee-logo-h) * var(--logo-scale, 1)), 2px);
    width: auto;
  }

  /* Логотипы-ссылки: строка встаёт на паузу под курсором, логотип чуть увеличивается. */
  .tiles__logo a {
    display: block;
    border-radius: 4px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tiles__logo a:hover {
    transform: scale(1.08);
  }

  .tiles__logo a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }

  /* Пауза — только пока курсор над строкой или логотип в фокусе с клавиатуры.
     Не :focus-within: после клика ссылка остаётся в фокусе, и строка стояла бы после возврата. */
  .tiles__marquee:not([data-resumed]):hover .tiles__marquee-track,
  .tiles__marquee:has(a:focus-visible) .tiles__marquee-track {
    animation-play-state: paused;
  }

  @keyframes tiles-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tiles__marquee-track {
      animation: none;
    }
  }

  /* Условная картинка — пока заглушка. */
  .tiles__image {
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    display: grid;
    flex: 1;
    place-items: center;
    margin-top: 32px;
    border-radius: calc(var(--tile-radius) - 4px) calc(var(--tile-radius) - 4px) 0 0;
    background: #e2e2e2;
  }

  /* Картинка проекта: без серой подложки, на всю область до нижнего края плитки;
     прижата к верху по центру — низ макета уходит под край. */
  .tiles__image--shot {
    position: relative;
    overflow: hidden;
    background: none;
  }

  .tiles__image--shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Заглушка «Кейс в разработке» (у плитки нет картинки): светлая подложка, телефон собирается по блокам
     (6с по кругу, блоки по очереди с шагом 0.45с, курсор переходит от блока к блоку), поперёк — чёрная лента
     с бегущей надписью. При reduced motion всё стоит, экран собран. */
  .tiles__soon {
    position: relative;
    overflow: hidden;
    place-items: start center;
    background: rgb(255 255 255 / 0.5);
  }

  /* Телефон с отступом сверху, низ уходит под край плитки — как экраны в других плитках. */
  .tiles__soon-phone {
    width: min(70%, 320px);
    height: auto;
    margin-top: round(8%, 2px);
    filter: drop-shadow(0 20px 40px rgb(20 20 20 / 0.12));
  }

  .tiles__soon-body {
    fill: #fff;
    stroke: rgb(20 20 20 / 0.08);
  }

  .tiles__soon-notch {
    fill: #e6e2dc;
  }

  .tiles__soon-b {
    fill: #dcd6cd;
    transform-box: fill-box;
    transform-origin: center;
    animation: tiles-soon-build 6s cubic-bezier(0.3, 1.4, 0.5, 1) infinite both;
  }

  .tiles__soon-cta {
    fill: #141414;
  }

  .tiles__soon-b.b2 {
    animation-delay: 0.45s;
  }

  .tiles__soon-b.b3 {
    animation-delay: 0.9s;
  }

  .tiles__soon-b.b4 {
    animation-delay: 1.35s;
  }

  .tiles__soon-b.b5 {
    animation-delay: 1.8s;
  }

  .tiles__soon-b.b6 {
    animation-delay: 2.25s;
  }

  @keyframes tiles-soon-build {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.9);
    }

    8%,
    70% {
      opacity: 1;
      transform: none;
    }

    80%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  .tiles__soon-cursor {
    animation: tiles-soon-cursor 6s ease-in-out infinite;
  }

  /* Курсор приходит к каждому блоку чуть раньше, чем тот появляется. */
  @keyframes tiles-soon-cursor {
    0%,
    3% {
      translate: 136px 62px;
    }

    7.5%,
    10% {
      translate: 198px 64px;
    }

    15%,
    18% {
      translate: 176px 150px;
    }

    22.5%,
    25% {
      translate: 168px 216px;
    }

    30%,
    33% {
      translate: 186px 264px;
    }

    37.5%,
    60% {
      translate: 150px 366px;
    }

    75%,
    100% {
      translate: 136px 62px;
    }
  }

  .tiles__soon-tape {
    position: absolute;
    right: -10%;
    bottom: 22%;
    left: -10%;
    padding-block: 12px;
    background: #141414;
    color: var(--case-accent);
    font-size: var(--text-tile-lead);
    font-weight: 600;
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    rotate: -6deg;
    box-shadow: 0 12px 30px rgb(20 20 20 / 0.2);
  }

  .tiles__soon-track {
    display: flex;
    width: max-content;
    animation: tiles-soon-tape 24s linear infinite;
  }

  /* Отступ после каждой надписи (не gap) — тогда половина ленты ровно повторяет вторую, шов не виден. */
  .tiles__soon-track span {
    padding-right: 24px;
  }

  @keyframes tiles-soon-tape {
    to {
      translate: -50% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tiles__soon-b,
    .tiles__soon-cursor,
    .tiles__soon-track {
      animation: none;
    }

    .tiles__soon-cursor {
      translate: 150px 366px;
    }
  }

  /* Наведение (только у мыши): плитка приподнимается, заливка плотнее, листья медленно
     разворачиваются, картинка чуть подаётся вперёд. */
  @property --tile-bg-opacity {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 50%;
  }

  @media (hover: hover) and (pointer: fine) {
    .tiles__item:hover {
      top: -10px;
      box-shadow: 0 28px 60px -20px rgb(20 20 20 / 0.25);
    }

    .tiles__item:hover .tiles__plate {
      --tile-bg-opacity: 75%;
    }

    .tiles__item:hover .tiles__print {
      transform: scale(1.08) rotate(2deg);
    }

    .tiles__item:hover .tiles__image {
      transform: translateY(-6px) scale(1.015);
    }
  }
</style>

<script>
  // После клика по логотипу лента сразу едет дальше, даже если курсор остался над ней
  // (при возврате со стороннего сайта браузер снимает :hover только после движения мыши).
  // Пауза под курсором снова включается, когда курсор уйдёт с ленты и вернётся.
  // Делегирование на document: работает и после переходов View Transitions.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest('.tiles__logo a');
    link?.closest<HTMLElement>('.tiles__marquee')?.setAttribute('data-resumed', '');
  });
  document.addEventListener(
    'mouseleave',
    (event) => {
      const target = event.target as Element | null;
      if (target instanceof Element && target.matches('.tiles__marquee'))
        target.removeAttribute('data-resumed');
    },
    true,
  );
</script>
