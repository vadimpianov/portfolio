---
/**
 * Кейс: шапка (годы, обложка, заголовок, теги) и текст из MDX. Показывается в модалке поверх
 * главной (CaseDrawer) — и при переходе с главной, и при прямом заходе / перезагрузке по адресу кейса.
 */
import type { CollectionEntry } from 'astro:content';
import { readFileSync } from 'node:fs';
import { render } from 'astro:content';
import { typograph } from '../i18n/typograph';
import { asset } from '../utils/asset';
import CoverSlider from './case/CoverSlider.astro';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, period, tags, theme, cover, slides } = entry.data;

// Размеры обложки (WebP с альфой, заголовок VP8X) — чтобы место под картинку было сразу, без скачка.
const coverSize = (() => {
  if (!cover) return undefined;
  const head = readFileSync(`public/images/cases/${cover}-600.webp`).subarray(0, 30);
  if (head.toString('ascii', 12, 16) !== 'VP8X') return undefined;
  return { width: head.readUIntLE(24, 3) + 1, height: head.readUIntLE(27, 3) + 1 };
})();
---

<article class:list={['case', `case--${theme}`]} data-bleed>
  {/* Обложка на широком кейсе — справа, обтекается: верх — по верху годов, рядом с ней идут
      годы, заголовок, теги и первый текст кейса, а под ней текст снова во всю ширину (см. стили). */}
  <header class:list={['case__hero', { 'case__hero--cover': cover || slides }]}>
    {slides ? (
      <div class="case__cover">
        <CoverSlider slides={slides} />
      </div>
    ) : (
      cover && (
        <img
          class="case__cover"
          src={asset(`/images/cases/${cover}-600.webp`)}
          srcset={`${asset(`/images/cases/${cover}-600.webp`)} 600w, ${asset(`/images/cases/${cover}-1200.webp`)} 1200w`}
          sizes="(min-width: 1024px) 40vw, 90vw"
          width={coverSize?.width}
          height={coverSize?.height}
          alt=""
          fetchpriority="high"
        />
      )
    )}
    {period && <p class="case__period">{period}</p>}
    <h1 class="case__title">{typograph(title)}</h1>
    {tags.length > 0 && (
      <ul class="case__chips">
        {tags.map((tag, i) => (
          <li class="case__chip" style={`--tag-color: var(--case-tag-${(i % 2) + 1})`}>
            {typograph(tag)}
          </li>
        ))}
      </ul>
    )}
  </header>
  <div class="case__body">
    <Content />
  </div>
</article>

<style>
  .case {
    --case-surface: var(--color-bg);
    container: case / inline-size;
    min-height: 100dvh;
    padding: var(--case-pad-top, round(calc(var(--header-h) + clamp(48px, 32px + 4vw, 96px)), 2px))
      var(--gutter) var(--case-section-gap);
    background: var(--case-surface);
    color: var(--color-text);
  }

  /* Тёмная тема: цвета — из макета кейса. */
  .case--dark {
    --case-surface: var(--case-bg);
    --color-text: var(--case-text);
    --color-text-body: var(--case-muted);
    color: var(--case-text);
  }

  /* Узкий кейс (и модалка): всё в колонку, обложка — под тегами. */
  .case__hero--cover {
    display: flex;
    flex-direction: column;
  }

  .case__cover {
    display: block;
    order: 1;
    width: 100%;
    max-width: 576px;
    height: auto;
    margin: var(--case-lead-gap) auto 0;
  }

  /* Широкий: обложка справа и обтекается. Верх — вровень с заголовком (тот же отступ от годов);
     рядом — заголовок, теги и первый текст кейса; ниже обложки текст идёт во всю ширину. */
  @container case (min-width: 800px) {
    .case__hero--cover {
      display: block;
    }

    /* Обложка — шириной с правую колонку текста (<Columns>): текст рядом — шириной с левую. */
    .case__cover {
      float: right;
      width: calc((100% - var(--case-col-gap)) / 2);
      /* Кегль текста — чтобы отступ ниже считался как у маркеров списков. */
      font-size: var(--text-case-body);
      margin: 0 0 var(--case-block-gap) var(--case-col-gap);
    }

    /* Слайдер — от маркера списков правой колонки (красная строка) до правого края (края крестика). */
    .case__cover :global(.case-slider) {
      width: auto;
      margin-left: var(--case-indent);
    }

    /* Маркеры списков рядом с обложкой не залезают под неё. */
    .case__body :global(ul) {
      overflow: hidden;
    }
  }

  /* Годы — тем же кеглем, что и текст кейса. */
  .case__period {
    font-size: var(--text-case-body);
    --lh: var(--leading-body);
    color: var(--case-muted);
  }

  .case__title {
    margin-top: var(--case-hero-gap);
    font-size: round(min(var(--text-display), 11cqi), 1px);
    font-weight: 600;
    --lh: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .case__chips {
    display: flex;
    flex-wrap: wrap;
    /* Между тегами — вдвое больше обычного зазора чипсов. */
    gap: calc(var(--chip-gap) * 2);
    /* Отступ от заголовка до тегов — вдвое больше, чем от годов до заголовка. */
    margin: calc(var(--case-hero-gap) * 2) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Теги — цветные плашки (цвета по порядку: --case-tag-1, -2), кегль и начертание — как у текста кейса. */
  .case__chip {
    padding: round(0.25em, 2px) round(0.75em, 2px);
    border-radius: var(--case-tag-radius);
    background: var(--tag-color);
    color: #fff;
    font-size: var(--text-case-body);
    --lh: var(--leading-body);
  }

  /* Текст кейса: заголовки секций, метки, абзацы, списки. */
  .case__body {
    max-width: 1320px;
    /* От тегов до текста. */
    margin-top: var(--case-lead-gap);
    font-size: var(--text-case-body);
    --lh: var(--leading-body);
    color: var(--color-text-body);
  }

  /* Заголовки разделов — начертанием как заголовок в hero главной (800, трекинг display). */
  .case__body :global(h2) {
    margin-top: var(--case-section-gap);
    font-size: var(--text-tile-title);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
  }

  /* Красная строка: абзацы текста кейса начинаются с отступа первой строки
     (подзаголовки капсом, подписи и числа — без него). */
  .case__body :global(p:not([class])) {
    text-indent: var(--case-indent);
  }

  .case__body :global(h2 + p) {
    text-indent: 0;
    margin-top: 12px;
    font-size: var(--case-label-size);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .case__body :global(h3) {
    margin-top: var(--case-block-gap);
    font-size: var(--case-label-size);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  /* Между абзацами — пустая строка (отступ абзаца); списки к абзацам — без промежутков. */
  .case__body :global(p:not([class]) + p:not([class])) {
    margin-top: round(1em, 2px);
  }

  /* Списки: маркер — под первой буквой абзаца (на красной строке), текст пункта — после него. */
  .case__body :global(ul:not([class])) {
    padding-left: 0;
    list-style: none;
  }

  .case__body :global(ul:not([class]) > li) {
    position: relative;
    padding-left: calc(var(--case-indent) + var(--case-bullet-gap));
  }

  .case__body :global(ul:not([class]) > li)::before {
    content: '•';
    position: absolute;
    left: var(--case-indent);
  }

  /* Выделение в тексте — как обычный текст: без белого цвета и жирности. */
  .case__body :global(strong) {
    color: inherit;
    font-weight: inherit;
  }
</style>
