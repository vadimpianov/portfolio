---
import { locales, localeNames } from '../i18n/ui';
import { getLocaleFromUrl, switchLocalePath, useTranslations } from '../i18n/utils';

const current = getLocaleFromUrl(Astro.url);
const t = useTranslations(current);
// Языков два: иконка ведёт на другой.
const target = locales.find((locale) => locale !== current) ?? current;
---

<a
  class="lang"
  href={switchLocalePath(Astro.url, target)}
  hreflang={target}
  data-set-lang={target}
  aria-label={`${t('lang.switch')}: ${localeNames[target]}`}
  title={localeNames[target]}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" />
  </svg>
</a>

<style>
  .lang {
    display: block;
    padding: 0.375rem 0;
    color: inherit;
  }

  /* 24px, толщина линии 1.7px. */
  .lang svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  import { keepViewOnNextSwap } from '../scripts/motion';

  // Смена языка — мгновенная:
  // 1) страница на другом языке заранее лежит в памяти (грузим сразу после открытия страницы),
  //    при клике берём её оттуда, без запроса к серверу;
  // 2) без снимка старой страницы для View Transition: анимация перехода при смене языка всё равно
  //    пропускается, а сам снимок (особенно с WebGL-фоном) и давал заметную паузу.
  const pages = new Map<string, string>();

  const prefetchOther = () => {
    const link = document.querySelector<HTMLAnchorElement>('[data-set-lang]');
    if (!link || pages.has(link.href)) return;
    fetch(link.href)
      .then((response) => (response.ok ? response.text() : null))
      .then((html) => html && pages.set(link.href, html))
      .catch(() => {});
  };
  document.addEventListener('astro:page-load', prefetchOther);

  let instant = false;

  // Одноразовая подмена startViewTransition: DOM обновляется сразу, без снимка.
  const skipNextSnapshot = () => {
    const native = document.startViewTransition;
    if (typeof native !== 'function') return;
    document.startViewTransition = ((update?: ViewTransitionUpdateCallback | StartViewTransitionOptions) => {
      document.startViewTransition = native;
      const callback = typeof update === 'function' ? update : update?.update;
      const done = Promise.resolve()
        .then(() => callback?.())
        .then(() => undefined);
      return {
        updateCallbackDone: done,
        ready: done,
        finished: done,
        skipTransition() {},
        types: new Set<string>(),
      } as unknown as ViewTransition;
    }) as typeof document.startViewTransition;
  };

  // Ручной выбор языка запоминается на год и важнее геолокации (см. functions/index.ts).
  // Делегирование на document: работает и после переходов View Transitions.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-set-lang]');
    if (!link) return;
    document.cookie = `lang=${link.dataset.setLang}; Path=/; Max-Age=31536000; SameSite=Lax`;
    // Меняется только текст: прокрутка и анимации остаются как были.
    keepViewOnNextSwap();
    instant = true;
    skipNextSnapshot();
  });

  // Готовая страница из памяти вместо запроса к серверу.
  document.addEventListener('astro:before-preparation', (event) => {
    if (!instant) return;
    instant = false;
    const html = pages.get(event.to.href);
    if (!html) return;
    event.loader = async () => {
      event.newDocument = new DOMParser().parseFromString(html, 'text/html');
    };
  });
</script>
