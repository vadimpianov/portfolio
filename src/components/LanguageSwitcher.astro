---
import { locales, localeNames } from '../i18n/ui';
import { getLocaleFromUrl, switchLocalePath, useTranslations } from '../i18n/utils';

const current = getLocaleFromUrl(Astro.url);
const t = useTranslations(current);
// Порядок в списке: EN, RU.
const items = [...locales].sort((a, b) => (a === 'en' ? -1 : b === 'en' ? 1 : 0));
---

<div class="lang" data-lang-switcher>
  <button
    class="lang__toggle"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="lang-menu"
    aria-label={t('lang.switch')}
  >
    <svg class="lang__globe" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" />
    </svg>
    <svg class="lang__chevron" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <ul class="lang__menu" id="lang-menu" hidden>
    {items.map((locale) => (
      <li>
        <a
          href={switchLocalePath(Astro.url, locale)}
          hreflang={locale}
          lang={locale}
          data-set-lang={locale}
          aria-current={locale === current ? 'true' : undefined}
          title={localeNames[locale]}
        >
          <span>{locale.toUpperCase()}</span>
          <svg class="lang__check" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5 12.5 4.5 4.5L19 7.5" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang {
    position: relative;
  }

  .lang svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lang__toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0;
    border: 0;
    color: inherit;
    background: none;
    cursor: pointer;
  }

  .lang__globe {
    width: 20px;
    height: 20px;
  }

  /* Толщина иконок в кнопке — под вес логотипа (~2px на экране). */
  .lang__toggle .lang__globe {
    stroke-width: 2.4;
  }

  .lang__toggle .lang__chevron {
    stroke-width: 3.2;
  }

  .lang__chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .lang__toggle[aria-expanded='true'] .lang__chevron {
    transform: rotate(180deg);
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 7.5rem;
    padding: 0.375rem;
    border-radius: 0.75rem;
    list-style: none;
    background: rgb(20 20 20 / 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .lang__menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .lang__menu a:hover,
  .lang__menu a:focus-visible {
    background: rgb(255 255 255 / 0.12);
  }

  .lang__check {
    width: 16px;
    height: 16px;
    visibility: hidden;
  }

  .lang__menu a[aria-current] .lang__check {
    visibility: visible;
  }
</style>

<script>
  // Делегирование на document: работает и после переходов View Transitions.
  const close = (root: Element) => {
    root.querySelector('.lang__toggle')?.setAttribute('aria-expanded', 'false');
    root.querySelector<HTMLElement>('.lang__menu')?.setAttribute('hidden', '');
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;

    // Ручной выбор языка запоминается на год и важнее геолокации (см. functions/index.ts).
    const link = target?.closest<HTMLAnchorElement>('[data-set-lang]');
    if (link) document.cookie = `lang=${link.dataset.setLang}; Path=/; Max-Age=31536000; SameSite=Lax`;

    const root = document.querySelector('[data-lang-switcher]');
    if (!root) return;
    const toggle = target?.closest('.lang__toggle');
    if (toggle && root.contains(toggle)) {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      root.querySelector('.lang__menu')?.toggleAttribute('hidden', !open);
      return;
    }
    // Клик мимо меню или по пункту — закрыть.
    close(root);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const root = document.querySelector('[data-lang-switcher]');
    if (!root) return;
    close(root);
    root.querySelector<HTMLElement>('.lang__toggle')?.focus();
  });
</script>
