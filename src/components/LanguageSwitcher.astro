---
import { locales, localeNames } from '../i18n/ui';
import { getLocaleFromUrl, switchLocalePath, useTranslations } from '../i18n/utils';

const current = getLocaleFromUrl(Astro.url);
const t = useTranslations(current);
// Языков два: иконка ведёт на другой.
const target = locales.find((locale) => locale !== current) ?? current;
---

<a
  class="lang"
  href={switchLocalePath(Astro.url, target)}
  hreflang={target}
  data-set-lang={target}
  aria-label={`${t('lang.switch')}: ${localeNames[target]}`}
  title={localeNames[target]}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" />
  </svg>
</a>

<style>
  .lang {
    display: block;
    padding: 0.375rem 0;
    color: inherit;
  }

  /* 24px, толщина линии 1.5px. */
  .lang svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  // Ручной выбор языка запоминается на год и важнее геолокации (см. functions/index.ts).
  // Делегирование на document: работает и после переходов View Transitions.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('[data-set-lang]');
    if (!link) return;
    document.cookie = `lang=${link.dataset.setLang}; Path=/; Max-Age=31536000; SameSite=Lax`;
  });
</script>
