---
import { asset } from '../../utils/asset';
/**
 * Картинка кейса: подпись-метка сверху (как в макете), картинка со скруглением.
 * `scroll` — длинная лента экранов: высота фиксирована, листается по горизонтали.
 * `bleed` — на всю ширину экрана (без полей сетки); только там, где пользователь попросит.
 */
import { typograph } from '../../i18n/typograph';

interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption?: string;
  scroll?: boolean;
  bleed?: boolean;
  /** Рядом с текстом в `<Columns>`: высотой с колонку текста, крупнее и уходит за правый край панели. */
  side?: boolean;
  /** Листаемая рамка высотой --case-figure-box-h; "ширина / высота" (например "3200 / 2443") — от неё считается размер картинки. */
  box?: string;
  /** Для `scroll`: заголовок и/или подзаголовок слева в начале ленты, по середине её высоты (листаются вместе с картинкой). */
  title?: string;
  lead?: string;
  /** Широкая схема: на узком контейнере не мельчит, а листается вбок (не уже --case-flow-min-w, как схема старой регистрации). */
  wide?: boolean;
  /** Для `scroll`: карусель — лента в край панели (за поля слева и справа), по умолчанию по центру,
      листается по кругу (картинка повторена 3 раза, прокрутку держит в средней копии CaseDrawer). */
  loop?: boolean;
  /** Для `box`: картинка нарезана плитками этого размера (px исходника) — `src` тогда папка с `r{ряд}c{колонка}.webp`
      (`design/cases/betting/scenarios-tiles.py`, нахлёст 2px). Большая картинка целиком декодируется долго и выгружается
      из памяти — на быстрой прокрутке появлялись пустые места; плитки декодируются по одной, только видимые. */
  tiles?: number;
  /** Для `box`: высота картинки = ширина текста × (высота / ширина из `box`) × zoom; что не влезло — листается вбок и вниз. */
  zoom?: number;
  /** Для `box`: точка картинки "x y" (доли 0…1), которая при открытии кейса стоит в центре рамки
      (у края — рамка прижата к краю). По умолчанию — середина по высоте, левый край. */
  focus?: string;
}

const {
  src,
  width,
  height,
  alt,
  caption,
  scroll = false,
  bleed = false,
  side = false,
  box,
  zoom = 1,
  title,
  lead,
  loop = false,
  wide = false,
  tiles,
  focus,
} = Astro.props;

// Плитки большой картинки: положение и размер — в % от всей картинки (с нахлёстом 2px справа и снизу).
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(5)}%`;
const tileList = tiles
  ? Array.from({ length: Math.ceil(height / tiles) }, (_, r) =>
      Array.from({ length: Math.ceil(width / tiles) }, (_, c) => {
        const x = c * tiles;
        const y = r * tiles;
        const w = Math.min(width, x + tiles + 2) - x;
        const h = Math.min(height, y + tiles + 2) - y;
        return {
          src: asset(`${src}/r${r}c${c}.webp`),
          w,
          h,
          style: `left: ${pct(x, width)}; top: ${pct(y, height)}; width: ${pct(w, width)}; height: ${pct(h, height)}`,
        };
      }),
    ).flat()
  : [];
---

<figure
  class:list={[
    'case-figure',
    {
      'case-figure--scroll': scroll || box,
      'case-figure--bleed': bleed,
      'case-figure--side': side,
      'case-figure--box': box,
      'case-figure--intro': title || lead,
      'case-figure--loop': scroll && loop,
      'case-figure--wide': wide,
    },
  ]}
  style={box ? `--figure-box-k: calc(${box.split('/')[1].trim()} / ${box.split('/')[0].trim()}); --figure-zoom: ${zoom}; --figure-ratio: calc(${width} / ${height})` : undefined}
>
  {caption && <figcaption class="case-figure__label">{typograph(caption)}</figcaption>}
  <div class="case-figure__frame" tabindex={scroll || box ? 0 : undefined} data-focus={box ? focus : undefined}>
    {
      (title || lead) && (
        <div class="case-figure__intro">
          {title && <h2 class="case-figure__title">{typograph(title)}</h2>}
          {lead && <p class="case-figure__lead">{typograph(lead)}</p>}
        </div>
      )
    }
    {
      scroll && loop ? (
        [0, 1, 2].map((i) => (
          <img
            src={asset(src)}
            width={width}
            height={height}
            alt={i === 1 ? alt : ''}
            aria-hidden={i === 1 ? undefined : 'true'}
            decoding="async"
            draggable="false"
          />
        ))
      ) : tiles ? (
        <div class="case-figure__tiles" role="img" aria-label={alt}>
          {tileList.map((t) => (
            <img src={t.src} width={t.w} height={t.h} alt="" style={t.style} decoding="async" draggable="false" />
          ))}
        </div>
      ) : (
        <img src={asset(src)} width={width} height={height} alt={alt} decoding="async" />
      )
    }
  </div>
</figure>

<style>
  .case-figure {
    margin-block: var(--case-block-gap);
  }

  .case-figure__label {
    margin-bottom: var(--case-caption-gap);
    /* Подпись — как раньше «До / После»: белым, вес 500, обычным регистром (стили поменяны местами). */
    font-size: var(--text-case-body);
    font-weight: 500;
    color: var(--case-text);
  }

  .case-figure__frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--tile-radius);
  }

  /* Лента экранов: листается по горизонтали в пределах полей, высота — как у экрана телефона. */
  .case-figure--scroll .case-figure__frame {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  /* Мышью ленту таскают (рука → зажатая рука, `pointerdown` в CaseDrawer). */
  @media (pointer: fine) {
    .case-figure--scroll .case-figure__frame {
      cursor: grab;
      user-select: none;
    }

    .case-figure--scroll .case-figure__frame.is-dragging {
      cursor: grabbing;
    }
  }

  .case-figure--scroll .case-figure__frame img {
    width: auto;
    max-width: none;
    height: var(--case-strip-h);
  }

  /* Листаемая рамка: высота фиксирована (--case-figure-box-h), в пределах полей панели (за правый край
     не уходит). Картинка внутри листается свободно и вбок, и вниз. */
  .case-figure--box .case-figure__frame {
    display: flex;
    align-items: flex-start;
    height: var(--case-figure-box-h);
    overflow: auto;
    overscroll-behavior: contain;
  }

  /* Мышью карту таскают (рука → зажатая рука), колесо листает кейс, а не карту.
     На сенсорных экранах — обычная прокрутка пальцем. */
  @media (pointer: fine) {
    .case-figure--box .case-figure__frame {
      overflow: hidden;
      /* Прокрутка над картой уходит странице (contain её останавливал). */
      overscroll-behavior: auto;
      cursor: grab;
      user-select: none;
    }

    .case-figure--box .case-figure__frame.is-dragging {
      cursor: grabbing;
    }
  }

  .case-figure--box .case-figure__frame .case-figure__tiles {
    --figure-img-h: round(calc(100cqi * var(--figure-box-k) * var(--figure-zoom)), 2px);
    position: relative;
    flex: none;
    width: round(calc(var(--figure-img-h) * var(--figure-ratio)), 2px);
    height: var(--figure-img-h);
  }

  .case-figure--box .case-figure__frame .case-figure__tiles img {
    position: absolute;
    display: block;
    max-width: none;
    border-radius: 0;
  }

  .case-figure--box .case-figure__frame img {
    --figure-img-h: round(calc(100cqi * var(--figure-box-k) * var(--figure-zoom)), 2px);
    flex: none;
    width: round(calc(var(--figure-img-h) * var(--figure-ratio)), 2px);
    height: var(--figure-img-h);
  }

  /* Лента с заголовком в начале: текст слева, по середине высоты ленты, дальше — экраны. */
  .case-figure--intro .case-figure__frame {
    display: flex;
    align-items: center;
    gap: var(--case-strip-intro-gap);
  }

  .case-figure__intro .case-figure__lead:first-child {
    margin-top: 0;
  }

  .case-figure--intro .case-figure__frame img {
    flex: none;
  }

  .case-figure__intro {
    flex: none;
    width: round(min(var(--case-strip-intro-w), 70cqi), 2px);
  }

  /* Заголовок в ленте — как заголовок раздела кейса (h2): тот же кегль, начертание и цвет. */
  .case-figure__intro .case-figure__title {
    margin: 0;
    font-size: var(--text-tile-title);
    font-weight: 600;
    --lh: var(--leading-title);
    letter-spacing: var(--tracking-title);
    text-transform: none;
    color: var(--color-text);
  }

  .case-figure__intro .case-figure__lead {
    margin-top: var(--case-strip-intro-lead-gap);
    font-size: var(--text-case-body);
    --lh: var(--leading-body);
    text-indent: 0;
    /* Не подзаголовок капсом (общее правило h2 + p): обычный регистр. */
    text-transform: none;
    letter-spacing: normal;
    color: var(--case-muted);
  }

  /* Карусель: в край панели слева и справа, копии ленты — через тот же зазор, что между экранами.
     Полосы прокрутки нет (при переходе между копиями она прыгала бы); мышью — перетаскиванием. */
  .case-figure--loop .case-figure__frame {
    display: flex;
    gap: var(--case-strip-loop-gap);
    margin-inline: calc(-1 * var(--gutter));
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
  }

  .case-figure--loop .case-figure__frame::-webkit-scrollbar {
    display: none;
  }

  .case-figure--loop .case-figure__frame.is-dragging {
    cursor: grabbing;
  }

  .case-figure--loop .case-figure__frame img {
    flex: none;
    border-radius: 0;
  }

  .case-figure--bleed .case-figure__frame {
    margin-inline: calc(-1 * var(--gutter));
  }

  .case-figure--bleed .case-figure__frame img {
    border-radius: 0;
  }

  /* Картинка рядом с текстом: слева — по левому краю правой колонки, справа уходит за край панели
     на --case-side-figure-overhang (лишнее обрезается). По высоте ряд задаёт текст (отступ от заголовка
     до текста прежний), а картинка стоит по середине текста и может выступать выше и ниже него. */
  @container case (min-width: 800px) {
    :global(:has(> .case-figure--side)) {
      position: relative;
    }

    .case-figure--side {
      position: absolute;
      top: 50%;
      left: 0;
      right: calc(-1 * var(--gutter));
      margin: 0;
      translate: 0 -50%;
    }

    .case-figure--side .case-figure__frame {
      overflow: clip;
    }

    .case-figure--side .case-figure__frame img {
      width: calc(100% + var(--case-side-figure-overhang));
      max-width: none;
      border-radius: 0;
    }
  }

  /* На узком — картинка рядом с текстом тоже уходит за правый край панели. */
  @container case (max-width: 799px) {
    .case-figure--side .case-figure__frame {
      margin-right: calc(-1 * var(--gutter));
      overflow: clip;
    }

    .case-figure--side .case-figure__frame img {
      width: calc(100% + var(--case-side-figure-overhang));
      max-width: none;
      border-radius: 0;
    }
  }

  /* Широкая схема: уже --case-flow-min-w — листается вбок, текст не мельчит. */
  .case-figure--wide .case-figure__frame {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .case-figure--wide .case-figure__frame img {
    min-width: var(--case-flow-min-w);
  }
</style>
