---
import { asset } from '../../utils/asset';
/**
 * Картинка кейса: подпись-метка сверху (как в макете), картинка со скруглением.
 * `scroll` — длинная лента экранов: высота фиксирована, листается по горизонтали.
 * `bleed` — на всю ширину экрана (без полей сетки); только там, где пользователь попросит.
 */
import { typograph } from '../../i18n/typograph';

interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption?: string;
  scroll?: boolean;
  bleed?: boolean;
}

const { src, width, height, alt, caption, scroll = false, bleed = false } = Astro.props;
---

<figure class:list={['case-figure', { 'case-figure--scroll': scroll, 'case-figure--bleed': bleed }]}>
  {caption && <figcaption class="case-figure__label">{typograph(caption)}</figcaption>}
  <div class="case-figure__frame" tabindex={scroll ? 0 : undefined}>
    <img src={asset(src)} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  </div>
</figure>

<style>
  .case-figure {
    margin-block: var(--case-block-gap);
  }

  .case-figure__label {
    margin-bottom: var(--case-caption-gap);
    /* Подпись — кеглем текста кейса, акцентным жёлтым (как «Передо мной стояло…»). */
    font-size: var(--text-case-body);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--case-accent);
  }

  .case-figure__frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--tile-radius);
  }

  /* Лента экранов: листается по горизонтали в пределах полей, высота — как у экрана телефона. */
  .case-figure--scroll .case-figure__frame {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .case-figure--scroll .case-figure__frame img {
    width: auto;
    max-width: none;
    height: var(--case-strip-h);
  }

  .case-figure--bleed .case-figure__frame {
    margin-inline: calc(-1 * var(--gutter));
  }

  .case-figure--bleed .case-figure__frame img {
    border-radius: 0;
  }
</style>
