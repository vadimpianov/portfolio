---
/**
 * Кейс «Метр квадратный»: сквозной путь пользователя — переключатель этапов («1. Поиск объекта / 2. Ипотека /
 * 3. Сделка») и схема этапа кодом (SVG, наш шрифт, тексты по локали). Раскладка — из макета (Frame 5, 1320 × 332):
 * три ряда плашек, связи считаются от плашек (справа → слева, снизу → сверху с поворотом, обход слева, вверх).
 * «Поиск объекта» — из макета; «Ипотека» — по той же раскладке, по логике сервиса из кейса (короткая анкета,
 * выбор банков, остальное — после предварительного одобрения). У «Сделки» — заглушка «Кейс в разработке».
 * Переключение без JS (радиокнопки + :has). Уже --case-flow-min-w схема листается по горизонтали.
 */
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl } from '../../../i18n/utils';
import Soon from '../Soon.astro';

const en = getLocaleFromUrl(Astro.url) === 'en';
const tr = (ru: string, eng: string) => (en ? eng : ru);

const steps = [tr('1. Поиск объекта', '1. Finding a property'), tr('2. Ипотека', '2. Mortgage'), tr('3. Сделка', '3. Deal')];
const name = `user-path-${Math.random().toString(36).slice(2, 8)}`;

type Node = { x: number; y: number; w: number; label: string; tone?: 'success' | 'touch' };
// h — с правого края на левый (один ряд); down — снизу вниз-вверх с поворотом посередине;
// detour — снизу, обходом слева, в левый край; up — вертикально вверх по центру цели.
type LinkSpec = [from: string, to: string, kind: 'h' | 'down' | 'detour' | 'up'];
type Diagram = { nodes: Record<string, Node>; links: LinkSpec[] };

const H = 40;
const R = 20;

const search: Diagram = {
  nodes: {
    listings: { x: 0, y: 0, w: 111, label: tr('Выдача', 'Listings') },
    filter: { x: 281, y: 0, w: 223, label: tr('Настройка фильтра', 'Filter setup') },
    saved: { x: 674, y: 0, w: 226, label: tr('Сохранённый поиск', 'Saved search') },
    push: { x: 1070, y: 0, w: 250, label: tr('Пуш о новых объектах', 'New listings push'), tone: 'touch' },
    quick: { x: 145, y: 120, w: 197, label: tr('Быстрый подбор', 'Quick match') },
    browse: { x: 556, y: 120, w: 206, label: tr('Работа с выдачей', 'Browsing listings') },
    owner: { x: 949, y: 120, w: 279, label: tr('Контакт с собственником', 'Contacting the owner'), tone: 'success' },
    banners: { x: 478, y: 172, w: 363, label: tr('Баннеры со смежными сервисами', 'Banners for related services') },
    form: { x: 145, y: 292, w: 223, label: tr('Заполнение анкеты', 'Filling in the form') },
    call: { x: 500, y: 292, w: 226, label: tr('Звонок колл-центра', 'Call from the call centre'), tone: 'touch' },
    pdf: { x: 858, y: 292, w: 462, label: tr('PDF на почту с актуальными предложениями', 'PDF by email with current offers') },
  },
  links: [
    ['listings', 'filter', 'h'],
    ['filter', 'saved', 'h'],
    ['saved', 'push', 'h'],
    ['listings', 'quick', 'down'],
    ['filter', 'browse', 'down'],
    ['saved', 'browse', 'down'],
    ['push', 'browse', 'down'],
    ['browse', 'owner', 'h'],
    ['quick', 'form', 'detour'],
    ['form', 'call', 'h'],
    ['call', 'pdf', 'h'],
    ['pdf', 'owner', 'up'],
  ],
};

const mortgage: Diagram = {
  nodes: {
    calc: { x: 0, y: 0, w: 254, label: tr('Калькулятор ипотеки', 'Mortgage calculator') },
    short: { x: 400, y: 0, w: 202, label: tr('Короткая анкета', 'Short application') },
    banks: { x: 748, y: 0, w: 170, label: tr('Выбор банков', 'Choosing banks') },
    push: { x: 1066, y: 0, w: 254, label: tr('Пуш о решении банка', 'Bank decision push'), tone: 'touch' },
    compare: { x: 184, y: 120, w: 233, label: tr('Сравнение программ', 'Comparing programmes') },
    approval: { x: 560, y: 120, w: 306, label: tr('Предварительное одобрение', 'Pre-approval') },
    deal: { x: 1030, y: 120, w: 212, label: tr('Переход к сделке', 'Moving to the deal'), tone: 'success' },
    rest: { x: 507, y: 172, w: 412, label: tr('Дозаполнение анкеты после одобрения', 'Completing the form after approval') },
    consult: { x: 184, y: 292, w: 275, label: tr('Заявка на консультацию', 'Consultation request') },
    manager: { x: 560, y: 292, w: 328, label: tr('Звонок ипотечного менеджера', 'Call from a mortgage manager'), tone: 'touch' },
    picks: { x: 1003, y: 292, w: 317, label: tr('Подборка программ на почту', 'Programme picks by email') },
  },
  links: [
    ['calc', 'short', 'h'],
    ['short', 'banks', 'h'],
    ['banks', 'push', 'h'],
    ['calc', 'compare', 'down'],
    ['short', 'approval', 'down'],
    ['banks', 'approval', 'down'],
    ['push', 'approval', 'down'],
    ['approval', 'deal', 'h'],
    ['compare', 'consult', 'detour'],
    ['consult', 'manager', 'h'],
    ['manager', 'picks', 'h'],
    ['picks', 'deal', 'up'],
  ],
};

type Point = [number, number];
type Dir = 'right' | 'down' | 'up';
const cx = (n: Node) => Math.round(n.x + n.w / 2);
const route = (a: Node, b: Node, kind: LinkSpec[2]): { d: string; from: Point; to: Point; dir: Dir } => {
  if (kind === 'h') {
    const y = a.y + H / 2;
    return { d: `M${a.x + a.w} ${y} H${b.x - 1}`, from: [a.x + a.w, y], to: [b.x - 1, y], dir: 'right' };
  }
  if (kind === 'up') {
    const x = cx(b);
    return { d: `M${x} ${a.y} V${b.y + H + 1}`, from: [x, a.y], to: [x, b.y + H + 1], dir: 'up' };
  }
  const x1 = cx(a);
  const y1 = a.y + H;
  if (kind === 'down') {
    const x2 = cx(b);
    const mid = Math.round((y1 + b.y) / 2);
    const sx = Math.sign(x2 - x1);
    return {
      d: `M${x1} ${y1} V${mid - R} Q${x1} ${mid} ${x1 + sx * R} ${mid} H${x2 - sx * R} Q${x2} ${mid} ${x2} ${mid + R} V${b.y - 1}`,
      from: [x1, y1],
      to: [x2, b.y - 1],
      dir: 'down',
    };
  }
  // detour: вниз, влево за край цели, вниз до её середины и вправо в левый край.
  const mid = Math.round((y1 + b.y) / 2) + 12;
  const xl = b.x - 32;
  const yc = b.y + H / 2;
  return {
    d: `M${x1} ${y1} V${mid - R} Q${x1} ${mid} ${x1 - R} ${mid} H${xl + R} Q${xl} ${mid} ${xl} ${mid + R} V${yc - R} Q${xl} ${yc} ${xl + R} ${yc} H${b.x - 1}`,
    from: [x1, y1],
    to: [b.x - 1, yc],
    dir: 'right',
  };
};
const arrow = ([x, y]: Point, dir: Dir) =>
  dir === 'right'
    ? `M${x - 8} ${y - 7} L${x} ${y} L${x - 8} ${y + 7}`
    : dir === 'down'
      ? `M${x - 7} ${y - 8} L${x} ${y} L${x + 7} ${y - 8}`
      : `M${x - 7} ${y + 8} L${x} ${y} L${x + 7} ${y + 8}`;
const diagrams = [search, mortgage].map((dg) => ({
  nodes: Object.values(dg.nodes),
  links: dg.links.map(([a, b, kind]) => route(dg.nodes[a], dg.nodes[b], kind)),
}));
---


<div class="user-path">
  <div class="user-path__tabs" role="radiogroup">
    {
      steps.map((step, i) => (
        <label class="user-path__tab">
          <input type="radio" name={name} value={i} checked={i === 0} />
          <span>{typograph(step)}</span>
        </label>
      ))
    }
  </div>

  {
    diagrams.map((dg, i) => (
      <div class="user-path__panel" data-step={i}>
        <div class="user-path__frame">
          <svg class="user-path__svg" viewBox="-4 -4 1328 340" role="img" aria-label={steps[i]}>
            <g class="user-path__links">
              {dg.links.map((l) => (
                <>
                  <path d={l.d} />
                  <path d={arrow(l.to, l.dir)} />
                </>
              ))}
            </g>
            <g class="user-path__nodes">
              {dg.nodes.map((n) => (
                <g class:list={['user-path__node', n.tone && `user-path__node--${n.tone}`]}>
                  <rect x={n.x} y={n.y} width={n.w} height={H} rx="10" />
                  <text x={n.x + n.w / 2} y={n.y + H / 2} text-anchor="middle">
                    {n.label}
                  </text>
                </g>
              ))}
            </g>
            {/* Точки начала линий — поверх плашек, на их краю. */}
            <g class="user-path__dots">
              {dg.links.map((l) => (
                <circle cx={l.from[0]} cy={l.from[1]} r="4" />
              ))}
            </g>
          </svg>
        </div>
      </div>
    ))
  }
  <div class="user-path__panel user-path__panel--soon" data-step="2"><Soon /></div>
</div>

<style>
  .user-path {
    margin-block: var(--case-block-gap);
  }

  /* Переключатель этапов — как у воронки: по центру, капсом, выбранный — жёлтый с подчёркиванием. */
  .user-path__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px var(--case-metrics-tabs-gap);
    margin-bottom: var(--case-metrics-tabs-offset);
  }

  .user-path__tab {
    position: relative;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    color: var(--case-muted);
    font-size: var(--case-label-size);
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .user-path__tab:hover {
    color: var(--case-text);
  }

  .user-path__tab:has(input:checked) {
    border-color: var(--case-metrics-tab-line);
    color: var(--case-accent);
  }

  .user-path__tab:has(input:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: 4px;
  }

  .user-path__tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Показан только выбранный этап. */
  .user-path:has(input[value='0']:checked) .user-path__panel:not([data-step='0']),
  .user-path:has(input[value='1']:checked) .user-path__panel:not([data-step='1']),
  .user-path:has(input[value='2']:checked) .user-path__panel:not([data-step='2']) {
    display: none;
  }

  .user-path__panel--soon {
    padding-block: var(--case-tabs-block-gap);
  }

  .user-path__frame {
    padding-bottom: 8px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .user-path__svg {
    display: block;
    width: 100%;
    min-width: var(--case-flow-min-w);
    height: auto;
    overflow: visible;
    font-family: inherit;
    /* 18px — самый крупный, при котором английские подписи влезают в плашки макета с полями. */
    font-size: 18px;
    user-select: none;
  }

  .user-path__svg text {
    dominant-baseline: central;
    fill: var(--case-text);
  }

  .user-path__links path {
    fill: none;
    stroke: var(--case-flow-line);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .user-path__dots circle {
    fill: var(--case-flow-line);
  }

  .user-path__node rect {
    fill: var(--case-flow-node);
  }

  .user-path__node--success rect {
    fill: var(--case-flow-success);
  }

  .user-path__node--touch rect {
    fill: var(--case-flow-touch);
  }
</style>
