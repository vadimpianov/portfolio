---
/**
 * Кейс «Метр квадратный»: сквозной путь пользователя — переключатель этапов («1. Поиск объекта / 2. Ипотека /
 * 3. Сделка») и схема этапа кодом (SVG, наш шрифт, тексты по локали). Геометрия — из макета (Frame 5, 1320 × 332).
 * Готов только «Поиск объекта», у остальных этапов — заглушка «Кейс в разработке».
 * Переключение без JS (радиокнопки + :has). Уже --case-flow-min-w схема листается по горизонтали.
 */
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl } from '../../../i18n/utils';
import Soon from '../Soon.astro';

const en = getLocaleFromUrl(Astro.url) === 'en';
const tr = (ru: string, eng: string) => (en ? eng : ru);

const steps = [tr('1. Поиск объекта', '1. Finding a property'), tr('2. Ипотека', '2. Mortgage'), tr('3. Сделка', '3. Deal')];
const name = `user-path-${Math.random().toString(36).slice(2, 8)}`;

type Node = { x: number; y: number; w: number; label: string; tone?: 'success' | 'touch' };
const H = 40;
const nodes: Node[] = [
  { x: 0, y: 0, w: 111, label: tr('Выдача', 'Listings') },
  { x: 281, y: 0, w: 223, label: tr('Настройка фильтра', 'Filter setup') },
  { x: 674, y: 0, w: 226, label: tr('Сохранённый поиск', 'Saved search') },
  { x: 1070, y: 0, w: 250, label: tr('Пуш о новых объектах', 'New listings push'), tone: 'touch' },
  { x: 145, y: 120, w: 197, label: tr('Быстрый подбор', 'Quick match') },
  { x: 556, y: 120, w: 206, label: tr('Работа с выдачей', 'Browsing listings') },
  { x: 949, y: 120, w: 279, label: tr('Контакт с собственником', 'Contacting the owner'), tone: 'success' },
  { x: 478, y: 172, w: 363, label: tr('Баннеры со смежными сервисами', 'Banners for related services') },
  { x: 145, y: 292, w: 223, label: tr('Заполнение анкеты', 'Filling in the form') },
  { x: 500, y: 292, w: 226, label: tr('Звонок колл-центра', 'Call from the call centre'), tone: 'touch' },
  { x: 858, y: 292, w: 462, label: tr('PDF на почту с актуальными предложениями', 'PDF by email with current offers') },
];

// Связи: линия от точки (кружок) до стрелки. Повороты — скругление 20px.
type Link = { d: string; from: [number, number]; to: [number, number]; dir: 'right' | 'down' | 'up' };
const R = 20;
const elbowDown = (x1: number, y1: number, x2: number, y2: number, mid: number) => {
  const sx = Math.sign(x2 - x1);
  return `M${x1} ${y1} V${mid - R} Q${x1} ${mid} ${x1 + sx * R} ${mid} H${x2 - sx * R} Q${x2} ${mid} ${x2} ${mid + R} V${y2}`;
};
const links: Link[] = [
  { d: 'M111 20 H280', from: [111, 20], to: [280, 20], dir: 'right' },
  { d: 'M504 20 H673', from: [504, 20], to: [673, 20], dir: 'right' },
  { d: 'M900 20 H1069', from: [900, 20], to: [1069, 20], dir: 'right' },
  { d: elbowDown(56, 40, 244, 119, 80), from: [56, 40], to: [244, 119], dir: 'down' },
  { d: elbowDown(392, 40, 659, 119, 80), from: [392, 40], to: [659, 119], dir: 'down' },
  { d: elbowDown(787, 40, 659, 119, 80), from: [787, 40], to: [659, 119], dir: 'down' },
  { d: elbowDown(1195, 40, 659, 119, 80), from: [1195, 40], to: [659, 119], dir: 'down' },
  { d: 'M762 140 H948', from: [762, 140], to: [948, 140], dir: 'right' },
  {
    d: `M244 160 V212 Q244 232 224 232 H133 Q113 232 113 252 V292 Q113 312 133 312 H144`,
    from: [244, 160],
    to: [144, 312],
    dir: 'right',
  },
  { d: 'M368 312 H499', from: [368, 312], to: [499, 312], dir: 'right' },
  { d: 'M726 312 H857', from: [726, 312], to: [857, 312], dir: 'right' },
  { d: 'M1088 292 V161', from: [1088, 292], to: [1088, 161], dir: 'up' },
];
const arrow = ([x, y]: [number, number], dir: Link['dir']) =>
  dir === 'right'
    ? `M${x - 8} ${y - 7} L${x} ${y} L${x - 8} ${y + 7}`
    : dir === 'down'
      ? `M${x - 7} ${y - 8} L${x} ${y} L${x + 7} ${y - 8}`
      : `M${x - 7} ${y + 8} L${x} ${y} L${x + 7} ${y + 8}`;
---

<div class="user-path">
  <div class="user-path__tabs" role="radiogroup">
    {
      steps.map((step, i) => (
        <label class="user-path__tab">
          <input type="radio" name={name} value={i} checked={i === 0} />
          <span>{typograph(step)}</span>
        </label>
      ))
    }
  </div>

  <div class="user-path__panel" data-step="0">
    <div class="user-path__frame">
      <svg class="user-path__svg" viewBox="-4 -4 1328 340" role="img" aria-label={steps[0]}>
        <g class="user-path__links">
          {
            links.map((l) => (
              <>
                <path d={l.d} />
                <path d={arrow(l.to, l.dir)} />
              </>
            ))
          }
        </g>
        <g class="user-path__nodes">
          {
            nodes.map((n) => (
              <g class:list={['user-path__node', n.tone && `user-path__node--${n.tone}`]}>
                <rect x={n.x} y={n.y} width={n.w} height={H} rx="10" />
                <text x={n.x + n.w / 2} y={n.y + H / 2} text-anchor="middle">
                  {n.label}
                </text>
              </g>
            ))
          }
        </g>
        {/* Точки начала линий — поверх плашек, на их краю. */}
        <g class="user-path__dots">{links.map((l) => <circle cx={l.from[0]} cy={l.from[1]} r="4" />)}</g>
      </svg>
    </div>
  </div>
  <div class="user-path__panel user-path__panel--soon" data-step="1"><Soon /></div>
  <div class="user-path__panel user-path__panel--soon" data-step="2"><Soon /></div>
</div>

<style>
  .user-path {
    margin-block: var(--case-block-gap);
  }

  /* Переключатель этапов — как у воронки: по центру, капсом, выбранный — жёлтый с подчёркиванием. */
  .user-path__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px var(--case-metrics-tabs-gap);
    margin-bottom: var(--case-metrics-tabs-offset);
  }

  .user-path__tab {
    position: relative;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    color: var(--case-muted);
    font-size: var(--case-label-size);
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .user-path__tab:hover {
    color: var(--case-text);
  }

  .user-path__tab:has(input:checked) {
    border-color: var(--case-metrics-tab-line);
    color: var(--case-accent);
  }

  .user-path__tab:has(input:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: 4px;
  }

  .user-path__tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Показан только выбранный этап. */
  .user-path:has(input[value='0']:checked) .user-path__panel:not([data-step='0']),
  .user-path:has(input[value='1']:checked) .user-path__panel:not([data-step='1']),
  .user-path:has(input[value='2']:checked) .user-path__panel:not([data-step='2']) {
    display: none;
  }

  .user-path__panel--soon {
    padding-block: var(--case-tabs-block-gap);
  }

  .user-path__frame {
    padding-bottom: 8px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .user-path__svg {
    display: block;
    width: 100%;
    min-width: var(--case-flow-min-w);
    height: auto;
    overflow: visible;
    font-family: inherit;
    /* 18px — самый крупный, при котором английские подписи влезают в плашки макета с полями. */
    font-size: 18px;
    user-select: none;
  }

  .user-path__svg text {
    dominant-baseline: central;
    fill: var(--case-text);
  }

  .user-path__links path {
    fill: none;
    stroke: var(--case-flow-line);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .user-path__dots circle {
    fill: var(--case-flow-line);
  }

  .user-path__node rect {
    fill: var(--case-flow-node);
  }

  .user-path__node--success rect {
    fill: var(--case-flow-success);
  }

  .user-path__node--touch rect {
    fill: var(--case-flow-touch);
  }
</style>
