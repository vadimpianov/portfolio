---
/**
 * Вводная строка и пункты в 2 колонки: вводная — сверху (с отступом абзаца от текста выше),
 * колонки задаёт `<Columns>` внутри (слева и справа — свои списки), пункты начинаются на одном уровне.
 */

interface Props {
  /** Пункты без <Columns>: текст после вводной строки перетекает в две колонки (как Flow). */
  flow?: boolean;
  /** Рядом с высокой обложкой: без `clear` — блок встаёт в колонку рядом с обложкой, а не под неё
      (на широком контейнере `flow` тогда не делит текст на колонки — места хватает только на одну). */
  wrap?: boolean;
}

const { flow = false, wrap = false } = Astro.props;
---

<div class:list={['case-text-columns', { 'case-text-columns--flow': flow && !wrap, 'case-text-columns--wrap': wrap }]}>
  <slot />
</div>

<style>
  /* Всегда ниже обложки кейса (обложка центрируется по высоте до этого блока — CaseDrawer). */
  .case-text-columns {
    clear: both;
    margin: round(1em, 2px) 0 0;
    /* Задачи кейса — акцентным жёлтым. */
    color: var(--case-accent);
  }

  .case-text-columns > :global(:first-child) {
    margin-top: 0;
  }

  .case-text-columns--wrap {
    clear: none;
  }

  /* Маркеры списка рядом с обложкой не залезают под неё. */
  .case-text-columns--wrap > :global(ul) {
    overflow: hidden;
  }

  /* flow: пункты перетекают из левой колонки в правую, колонки — как у <Columns>. */
  @container case (min-width: 800px) {
    .case-text-columns--flow > :global(ul) {
      columns: 2;
      column-gap: var(--case-col-gap);
      orphans: 1;
      widows: 1;
      overflow: visible !important;
    }
  }

  /* Колонки сразу под вводной строкой, без лишних отступов. */
  .case-text-columns > :global(.case-columns) {
    margin: 0;
  }
</style>
