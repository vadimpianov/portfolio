---
/**
 * Селектор сценариев кейса: вкладки в ряд, выбранная — жёлтая. Содержимое выбранной по умолчанию вкладки —
 * в слоте; у остальных пока заглушка «Кейс в разработке». Переключение — без JS (радиокнопки + :has),
 * поэтому работает и в модалке, куда кейс вставляется готовым HTML.
 */
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';
import { typograph } from '../../i18n/typograph';

interface Props {
  items: string[];
  /** Вкладка, открытая сразу; её содержимое — в слоте. */
  active?: number;
}

const { items, active = 0 } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
const name = 'case-tabs';
---

<div class="case-tabs">
  <div class="case-tabs__list" role="radiogroup" aria-label={t('case.tabs')}>
    {items.map((item, i) => (
      <label class="case-tabs__tab">
        <input
          type="radio"
          name={name}
          value={i}
          checked={i === active}
          data-tab={i === active ? 'main' : 'soon'}
        />
        <span>{typograph(item)}</span>
      </label>
    ))}
  </div>

  <div class="case-tabs__panel case-tabs__panel--main">
    <slot />
  </div>

  <div class="case-tabs__panel case-tabs__panel--soon">
    {/* Картинка «в работе»: экран-заготовка, блоки проявляются по очереди. */}
    <svg class="case-tabs__soon-art" viewBox="0 0 160 240" aria-hidden="true">
      <rect class="frame" x="12.5" y="4.5" width="135" height="231" rx="23" />
      <rect class="notch" x="56" y="12" width="48" height="10" rx="5" />
      <rect class="block b1" x="28" y="40" width="64" height="10" rx="5" />
      <rect class="block b2" x="28" y="62" width="104" height="36" rx="8" />
      <rect class="block b3" x="28" y="110" width="104" height="10" rx="5" />
      <rect class="block b4" x="28" y="130" width="80" height="10" rx="5" />
      <rect class="block b5" x="28" y="160" width="104" height="24" rx="8" />
      <rect class="bar" x="56" y="220" width="48" height="4" rx="2" />
    </svg>
    <p class="case-tabs__soon-text">{typograph(t('case.soon'))}</p>
  </div>
</div>

<style>
  /* Чипсы → селектор. */
  .case-tabs {
    margin-top: var(--case-tabs-gap);
  }

  .case-tabs__list {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    border: 1px solid var(--case-tabs-border);
    border-radius: var(--case-tabs-radius);
    overflow: hidden;
  }

  .case-tabs__tab {
    position: relative;
    display: grid;
    place-items: center;
    min-height: var(--case-tabs-h);
    padding: 8px 12px;
    color: var(--case-muted);
    font-size: var(--case-label-size);
    font-weight: 500;
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .case-tabs__tab + .case-tabs__tab {
    border-left: 1px solid var(--case-tabs-border);
  }

  .case-tabs__tab:hover {
    color: var(--case-text);
  }

  .case-tabs__tab:has(input:checked) {
    background: var(--case-accent);
    color: var(--case-tabs-active-text);
  }

  .case-tabs__tab:has(input:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: -4px;
  }

  .case-tabs__tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Мобила: вкладки 2 × 2. */
  @container case (max-width: 599px) {
    .case-tabs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row;
    }

    .case-tabs__tab + .case-tabs__tab {
      border-left: 0;
    }

    .case-tabs__tab:nth-child(n + 3) {
      border-top: 1px solid var(--case-tabs-border);
    }

    .case-tabs__tab:nth-child(even) {
      border-left: 1px solid var(--case-tabs-border);
    }
  }

  /* Показана одна панель: основная — у выбранной по умолчанию вкладки, заглушка — у остальных. */
  .case-tabs:has(input[data-tab='main']:checked) .case-tabs__panel--soon,
  .case-tabs:has(input[data-tab='soon']:checked) .case-tabs__panel--main {
    display: none;
  }

  /* Между блоками сценария (колонки текста, схемы, картинки) — свой отступ, меньше общего. */
  .case-tabs__panel--main {
    --case-block-gap: var(--case-tabs-block-gap);
  }

  /* Заголовок сценария и метки «до / после» — по центру. */
  /* Селектор → заголовок сценария. */
  .case-tabs .case-tabs__panel--main > :global(h2:first-child) {
    margin-top: var(--case-tabs-gap);
    font-weight: 600;
    text-align: center;
  }

  /* Метки «До» / «После»: сверху — 24px от блока выше (у обеих одинаково). */
  .case-tabs .case-tabs__panel--main > :global(h3) {
    margin-top: var(--case-tabs-title-gap);
    color: var(--case-text);
    font-size: var(--text-case-body);
    text-align: center;
    text-transform: none;
    letter-spacing: 0;
  }

  /* Нижний отступ блока над меткой не должен «перебивать» её 24px (отступы схлопываются в больший). */
  .case-tabs .case-tabs__panel--main > :global(:has(+ h3)) {
    margin-bottom: 0;
  }

  /* Картинки/экраны → «После» — 32px (как «После» → текст); заголовок → «До» остаётся 24px. */
  .case-tabs .case-tabs__panel--main > :global(:not(h2) + h3) {
    margin-top: var(--case-tabs-label-gap);
  }

  /* «До» / «После» → текст в две колонки. */
  .case-tabs .case-tabs__panel--main > :global(h3 + .case-columns),
  .case-tabs .case-tabs__panel--main > :global(h3 + .case-flow) {
    margin-top: var(--case-tabs-label-gap);
  }

  .case-tabs__panel--soon {
    display: grid;
    justify-items: center;
    gap: 24px;
    padding: var(--case-section-gap) 0;
  }

  .case-tabs__soon-art {
    width: 160px;
    height: 240px;
  }

  .case-tabs__soon-art .frame {
    fill: none;
    stroke: var(--case-tabs-border-strong);
    stroke-width: 1;
  }

  .case-tabs__soon-art .notch,
  .case-tabs__soon-art .bar {
    fill: var(--case-tabs-border-strong);
  }

  .case-tabs__soon-art .block {
    fill: var(--case-accent);
    opacity: 0.15;
    animation: case-soon 2.4s ease-in-out infinite;
  }

  .case-tabs__soon-art .b2 {
    animation-delay: 0.2s;
  }

  .case-tabs__soon-art .b3 {
    animation-delay: 0.4s;
  }

  .case-tabs__soon-art .b4 {
    animation-delay: 0.6s;
  }

  .case-tabs__soon-art .b5 {
    animation-delay: 0.8s;
  }

  @keyframes case-soon {
    0%,
    100% {
      opacity: 0.15;
    }

    40% {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-tabs__soon-art .block {
      animation: none;
      opacity: 0.4;
    }
  }

  .case-tabs__soon-text {
    color: var(--case-text);
    font-size: var(--text-case-body);
    --lh: var(--leading-body);
    text-align: center;
  }
</style>
