---
/**
 * Селектор сценариев кейса: вкладки в ряд, выбранная — жёлтая. Содержимое выбранной по умолчанию вкладки —
 * в слоте; у остальных — именованные слоты `t0`, `t1`, … (в MDX: `<div slot="t2">…</div>`), а где слота нет —
 * заглушка «Кейс в разработке». Переключение — без JS (радиокнопки + :has),
 * поэтому работает и в модалке, куда кейс вставляется готовым HTML.
 * Без `items` (или с пустым списком) селектора нет — только содержимое со стилями сценария
 * (заголовки разделов по центру, отступы); первый заголовок — на --case-tabs-section-gap от чипсов.
 */
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';
import { typograph } from '../../i18n/typograph';
import Soon from './Soon.astro';

interface Props {
  items?: string[];
  /** Вкладка, открытая сразу; её содержимое — в слоте. */
  active?: number;
}

const { items = [], active = 0 } = Astro.props;
const tabs = items.length > 0;
// Свои рассказы у остальных вкладок (если есть)
const alt = await Promise.all(items.map((_, i) => (i !== active && Astro.slots.has(`t${i}`) ? Astro.slots.render(`t${i}`) : null)));
const t = useTranslations(getLocaleFromUrl(Astro.url));
const name = 'case-tabs';
---

<div class:list={['case-tabs', { 'case-tabs--bare': !tabs }]}>
  {tabs && (
  <div class="case-tabs__list" role="radiogroup" aria-label={t('case.tabs')}>
    {items.map((item, i) => (
      <label class="case-tabs__tab">
        <input
          type="radio"
          name={name}
          value={i}
          checked={i === active}
          data-tab={i === active || alt[i] != null ? 'main' : 'soon'}
        />
        <span>{typograph(item)}</span>
      </label>
    ))}
  </div>
  )}

  <div class="case-tabs__panel case-tabs__panel--main" data-i={active}>
    <slot />
  </div>

  {alt.map((html, i) => html != null && <div class="case-tabs__panel case-tabs__panel--main" data-i={i} set:html={html} />)}

  {tabs && (
    <div class="case-tabs__panel case-tabs__panel--soon">
      <Soon />
    </div>
  )}
</div>

<style>
  /* Чипсы → селектор — 60px. */
  .case-tabs {
    margin-top: var(--case-tabs-section-gap);
  }

  .case-tabs__list {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    border: 1px solid var(--case-tabs-border);
    border-radius: var(--case-tabs-radius);
    overflow: hidden;
  }

  .case-tabs__tab {
    position: relative;
    display: grid;
    place-items: center;
    min-height: var(--case-tabs-h);
    padding: 8px 12px;
    color: var(--case-muted);
    font-size: var(--case-label-size);
    font-weight: 500;
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .case-tabs__tab + .case-tabs__tab {
    border-left: 1px solid var(--case-tabs-border);
  }

  .case-tabs__tab:hover {
    color: var(--case-text);
  }

  .case-tabs__tab:has(input:checked) {
    background: var(--case-accent);
    color: var(--case-tabs-active-text);
  }

  .case-tabs__tab:has(input:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: -4px;
  }

  .case-tabs__tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Мобила: вкладки 2 × 2. */
  @container case (max-width: 599px) {
    .case-tabs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row;
    }

    /* Разделитель — между колонками (у 2-й и 4-й вкладки), у 3-й (начало второго ряда) — нет.
       Селектор той же силы, что и общий «+», иначе он перебивал (вертикальных линий не было). */
    .case-tabs__tab + .case-tabs__tab:nth-child(odd) {
      border-left: 0;
    }

    .case-tabs__tab:nth-child(n + 3) {
      border-top: 1px solid var(--case-tabs-border);
    }
  }

  /* Показана одна панель: у вкладки со своим рассказом — он, у остальных — заглушка. */
  .case-tabs:not(.case-tabs--bare) .case-tabs__panel {
    display: none;
  }

  .case-tabs:has(input[data-tab='soon']:checked) .case-tabs__panel--soon,
  .case-tabs:has(.case-tabs__tab:nth-child(1) input:checked) .case-tabs__panel[data-i='0'],
  .case-tabs:has(.case-tabs__tab:nth-child(2) input:checked) .case-tabs__panel[data-i='1'],
  .case-tabs:has(.case-tabs__tab:nth-child(3) input:checked) .case-tabs__panel[data-i='2'],
  .case-tabs:has(.case-tabs__tab:nth-child(4) input:checked) .case-tabs__panel[data-i='3'],
  .case-tabs:has(.case-tabs__tab:nth-child(5) input:checked) .case-tabs__panel[data-i='4'],
  .case-tabs:has(.case-tabs__tab:nth-child(6) input:checked) .case-tabs__panel[data-i='5'] {
    display: block;
  }

  /* Между блоками сценария (колонки текста, схемы, картинки) — свой отступ, меньше общего. */
  .case-tabs__panel--main {
    --case-block-gap: var(--case-tabs-block-gap);
  }

  /* Заголовок сценария и метки «до / после» — по центру. */
  /* Заголовки разделов сценария — как заголовок сценария: вес 600, сверху 60px (от блока выше). */
  .case-tabs .case-tabs__panel--main > :global(h2) {
    margin-top: var(--case-tabs-section-gap);
    font-weight: 600;
  }

  /* Лента с заголовком внутри (без заголовка раздела над ней) — отступ сверху как у заголовка раздела. */
  .case-tabs .case-tabs__panel--main > :global(:not(h2) + .case-figure--intro) {
    margin-top: var(--case-tabs-section-gap);
  }

  /* Заголовки разделов и подписи под ними — по центру (кроме заголовка над текстом с картинкой рядом,
     «Подробнее о процессе»). */
  .case-tabs .case-tabs__panel--main > :global(h2:not(:has(+ .case-columns))),
  .case-tabs .case-tabs__panel--main > :global(h2 + p) {
    text-align: center;
    /* Подпись — без красной строки, иначе центр смещается. */
    text-indent: 0;
  }

  /* Снизу кейса — отступ как сбоку (поле панели): у последнего блока свой нижний отступ не добавляется. */
  .case-tabs .case-tabs__panel--main > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Абзацы сценария идут подряд, без пустой строки — начало абзаца отмечает красная строка. */
  .case-tabs .case-tabs__panel--main :global(p:not([class]) + p:not([class])) {
    margin-top: 0;
  }

  /* Селектор → заголовок сценария. */
  .case-tabs .case-tabs__panel--main > :global(h2:first-child) {
    margin-top: var(--case-tabs-gap);
    font-weight: 600;
    text-align: center;
  }

  /* Метки «До» / «После»: сверху — 24px от блока выше (у обеих одинаково). */
  .case-tabs .case-tabs__panel--main > :global(h3) {
    margin-top: var(--case-tabs-title-gap);
    /* «До» / «После» — стилем подписей к картинкам: жёлтым, капсом (стили поменяны местами по просьбе). */
    color: var(--case-accent);
    font-size: var(--text-case-body);
    font-weight: var(--weight-regular);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  /* Нижний отступ блока над меткой не должен «перебивать» её 24px (отступы схлопываются в больший). */
  .case-tabs .case-tabs__panel--main > :global(:has(+ h3)) {
    margin-bottom: 0;
  }

  /* Картинки/экраны → «После» — 32px (как «После» → текст); заголовок → «До» остаётся 24px. */
  .case-tabs .case-tabs__panel--main > :global(:not(h2) + h3) {
    margin-top: var(--case-tabs-label-gap);
  }

  /* Заголовок раздела → текст рядом с картинкой («Подробнее о процессе»). */
  .case-tabs .case-tabs__panel--main > :global(h2 + .case-columns) {
    margin-top: var(--case-tabs-heading-text-gap);
  }

  /* «До» / «После» → текст в две колонки. */
  .case-tabs .case-tabs__panel--main > :global(h3 + .case-columns),
  .case-tabs .case-tabs__panel--main > :global(h3 + .case-flow) {
    margin-top: var(--case-tabs-label-gap);
  }

  .case-tabs__panel--soon {
    padding: var(--case-section-gap) 0;
  }

  /* Без селектора: чипсы → первый заголовок — --case-tabs-section-gap (отступ самого блока). */
  .case-tabs--bare .case-tabs__panel--main > :global(h2:first-child) {
    margin-top: 0;
  }

  /* Колонки с заголовком внутри (заголовок и текст рядом с картинкой) — отступ сверху как у раздела. */
  .case-tabs .case-tabs__panel--main > :global(.case-columns:has(h2)) {
    margin-top: var(--case-tabs-section-gap);
  }
</style>
