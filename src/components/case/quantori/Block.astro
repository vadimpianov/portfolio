---
/**
 * Обёртка интерактивных блоков кейса Quantori: подпись-лейбл (как у Figure) и общие стили —
 * переключатель-сегменты (`.q-seg`, радиокнопки без JS) и проявление при прокрутке (`data-reveal`,
 * ставит `src/scripts/case-data.ts`; без скрипта блок просто виден).
 */
import { typograph } from '../../../i18n/typograph';

interface Props {
  caption: string;
  /** Заметка под блоком: источник данных. */
  note?: string;
}

const { caption, note } = Astro.props;
---

<figure class="q-block" data-reveal>
  <figcaption class="q-block__caption">{typograph(caption)}</figcaption>
  <slot />
  {note && <p class="q-block__note">{typograph(note)}</p>}
</figure>

<style>
  .q-block {
    margin-block: var(--case-block-gap);
  }

  /* Подпись — как у картинок кейса: кеглем текста, белым, 500, обычным регистром. */
  .q-block__caption {
    margin-bottom: var(--case-caption-gap);
    font-size: var(--text-case-body);
    font-weight: 500;
    color: var(--case-text);
  }

  .q-block__note {
    margin-top: 16px;
    font-size: var(--case-label-size);
    color: var(--case-muted);
  }

  /* Переключатель-сегменты: выбранный — жёлтая заливка, как вкладки сценариев. */
  .q-block :global(.q-seg) {
    display: inline-grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: 0 0 var(--case-caption-gap);
    border: 1px solid var(--case-tabs-border-strong);
    border-radius: var(--case-tabs-radius);
    overflow: hidden;
  }

  .q-block :global(.q-seg label) {
    position: relative;
    min-width: 96px;
    padding: 8px 20px;
    color: var(--case-muted);
    font-size: var(--case-label-size);
    font-weight: 500;
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .q-block :global(.q-seg label + label) {
    border-left: 1px solid var(--case-tabs-border-strong);
  }

  .q-block :global(.q-seg label:hover) {
    color: var(--case-text);
  }

  .q-block :global(.q-seg label:has(input:checked)) {
    background: var(--case-accent);
    color: var(--case-tabs-active-text);
  }

  .q-block :global(.q-seg label:has(input:focus-visible)) {
    outline: 2px solid var(--case-accent);
    outline-offset: -4px;
  }

  .q-block :global(.q-seg input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
</style>
