---
/**
 * Отчёт по препарату PharmaKB — «живая» страница в окне браузера внутри кейса (из макета пользователя
 * design/cases/quantori/drug-report/drug-report.svg, сборка — build.py там же).
 * Страница — картинки-куски в 2x, поверх — интерактив: вкладки ведут к разделам, разделы и группы
 * сворачиваются, переключатели FDA/EMA и валют, подвкладки, чипсы, меню «Download Report» и «Events»,
 * избранное, копирование, тултипы как в макете, наведение на ссылки, строки таблиц и точки графиков.
 * Вся страница — в координатах макета (1440px), под ширину окна её масштабирует `zoom`
 * (src/scripts/drug-report.ts, запускает CaseDrawer).
 */
import '@fontsource-variable/roboto/wght.css';
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl, useTranslations } from '../../../i18n/utils';
import DrugReportNode from './DrugReportNode.astro';
import drug from './drug-report.json';
import company from './company-report.json';

interface Props {
  caption?: string;
  alt: string;
  /** Какой отчёт: по препарату (с каркасом и бегунком) или по компании (живые графики из слотов `l0…l2`). */
  report?: 'drug' | 'company';
}

const { caption, alt, report = 'drug' } = Astro.props;
const data = report === 'company' ? company : drug;
const dir = report === 'company' ? 'company' : 'report';
const wireframe = report === 'drug';
// Живые графики (StockChart, RevenueChart, PatentChart) — из слотов; скрипт переносит их на место узлов `live`.
const live = report === 'company' ? await Promise.all([0, 1, 2].map((n) => Astro.slots.render(`l${n}`))) : [];
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<figure class="case-figure dr">
  {caption && <figcaption>{typograph(caption)}</figcaption>}
  <div class="dr__window">
    <div class="dr__frame" data-drug-report tabindex="0" aria-label={alt} data-lenis-prevent>
      <div class="dr__page" style={`width: ${data.width}px`}>
        {data.nodes.map((n) => <DrugReportNode node={n as any} data={data} dir={dir} wireframe={wireframe} />)}
        {live.map((html, n) => <div class="dr-live-src" data-dr-live-src={n} set:html={html} />)}
        <div class="dr__tip" role="tooltip" hidden></div>
      </div>
    </div>
    {wireframe && (<div class="dr-split" data-dr-split>
      <button
        type="button"
        class="dr-split__knob"
        role="slider"
        aria-label={t('case.compare')}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="5"
        data-dr-knob
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M9 7l-5 5 5 5M15 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>)}
    <button type="button" class="dr__top" data-dr-top>Go<br />{typograph('to top')}</button>
  </div>
</figure>

<style is:global>
  .dr {
    margin-block: var(--case-block-gap);
  }

  .dr > figcaption {
    margin-bottom: var(--case-caption-gap);
    font-size: var(--text-case-body);
    font-weight: 500;
    color: var(--case-text);
  }

  .dr__window {
    position: relative;
    overflow: hidden;
    border-radius: var(--tile-radius);
    background: #fff;
  }

  .dr__frame {
    /* На 20% выше рамок-карт кейса (720px). */
    height: calc(var(--case-figure-box-h) * 1.2);
    overflow: auto;
    overscroll-behavior: auto;
    scrollbar-width: thin;
    scrollbar-color: #c4c6cc transparent;
    outline: none;
  }

  .dr__page {
    position: relative;
    /* Масштаб до ширины окна ставит скрипт (zoom); до него страница просто шире окна. */
    font-family: 'Roboto Variable', sans-serif;
    color: #262626;
    font-size: 16px;
    letter-spacing: normal;
    -webkit-font-smoothing: antialiased;
  }

  .dr__page * {
    line-height: normal;
  }

  .dr__page button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    cursor: pointer;
  }

  .dr-s {
    position: relative;
  }

  /* Кусок с открытым меню — над липкой полосой вкладок (меню «Download Report» иначе уходило под неё) */
  .dr-s:has(.dr-menu__list:not([hidden])) {
    z-index: 8;
  }

  .dr-s > img {
    display: block;
    width: 1440px;
    height: 100%;
    user-select: none;
  }

  .dr-s > :not(img) {
    position: absolute;
    z-index: 1;
  }

  /* Раскрывающиеся разделы и группы */
  .dr-head__btn {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dr-s > .dr-head__btn {
    z-index: 1;
  }

  .dr-sec:not(.dr-sec--grp) > .dr-head .dr-head__btn {
    left: 120px;
    width: 1200px;
  }

  .dr-sec:not(.dr-sec--grp) > .dr-head .dr-head__btn:hover {
    background: rgb(13 105 235 / 0.04);
  }

  .dr-head .dr-head__btn:focus-visible {
    outline: 2px solid #0d69eb;
    outline-offset: -2px;
  }

  .dr-s > .dr-tabs,
  .dr-s > .dr-seg,
  .dr-s > .dr-menu,
  .dr-s > .dr-fav,
  .dr-s > .dr-copy,
  .dr-s > .dr-info,
  .dr-s > .dr-a,
  .dr-s > .dr-pt,
  .dr-s > .dr-zone,
  .dr-s > .dr-chips,
  .dr-s > .dr-sub,
  .dr-s > .dr-btn {
    z-index: 2;
  }

  .dr-chev {
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .dr-chev svg {
    overflow: visible;
    transition: rotate 0.35s ease;
  }

  .dr-sec.is-closed > .dr-head .dr-chev svg {
    rotate: 180deg;
  }

  .dr-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .dr-sec.is-closed > .dr-body {
    grid-template-rows: 0fr;
  }

  .dr-body__in {
    min-height: 0;
  }

  .dr-sec.is-closed > .dr-body > .dr-body__in,
  .dr-sec.is-anim > .dr-body > .dr-body__in {
    overflow: hidden;
  }

  /* Строки таблиц, ссылки, кнопки */
  .dr-row {
    pointer-events: auto;
    mix-blend-mode: multiply;
  }

  .dr-row:hover {
    background: #e9f1fd;
  }

  .dr-a {
    cursor: pointer;
  }

  /* Ссылки чёрным текстом (меню сайта, хлебные крошки) — подчёркивание цветом текста */
  .dr-a--plain:hover::after {
    top: auto !important;
    bottom: 3px;
    background: #262626 !important;
  }

  /* Живые графики в отчёте о компании (Stock Price, Revenue by Drug, Patents) — в полях страницы, как в макете */
  .dr-live {
    margin: 0 120px;
    padding: 8px 0 32px;
  }

  .dr-live .sc {
    overflow: visible;
    border-radius: 0;
  }

  .dr-live-src {
    display: none;
  }

  .dr-sub--big .dr-sub__tab {
    font-size: 17px;
  }

  .dr-sub--big .dr-sub__tab::after {
    top: 25px;
  }

  .dr-a:not(.dr-a--multi):hover::after {
    content: '';
    position: absolute;
    top: 15px;
    right: 0;
    left: 0;
    height: 1px;
    background: #0d69eb;
  }

  .dr-a--multi:hover {
    background: rgb(13 105 235 / 0.06);
    border-radius: 2px;
  }

  .dr-btn {
    border-radius: 4px;
    mix-blend-mode: multiply;
  }

  .dr-btn:hover {
    background: #e3eefd;
  }

  .dr-btn:active {
    background: #cfe0fb;
  }

  .dr-info {
    border-radius: 50%;
    cursor: help;
  }

  .dr-info:hover {
    box-shadow: inset 0 0 0 3px #fff, inset 0 0 0 30px color-mix(in srgb, var(--c) 18%, transparent);
  }

  .dr-pt,
  .dr-zone {
    border-radius: 50%;
    cursor: crosshair;
  }

  .dr-pt:hover::after,
  .dr-zone:hover::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 2px solid #0d69eb;
    border-radius: 50%;
    background: rgb(13 105 235 / 0.12);
  }

  /* Вайрфрейм ↔ дизайн: каркас поверх страницы, виден слева от бегунка (--split — в px страницы) */
  .dr-s > .dr-wf {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 1440px;
    height: 100%;
    clip-path: inset(0 calc(100% - var(--split, 144px)) 0 0);
    user-select: none;
  }

  .dr-nav__wf {
    position: absolute;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    border: 1px solid #d9dce1;
    background: #fff;
    clip-path: inset(-12px calc(100% - var(--split, 144px) + 120px) -12px -120px);
  }

  .dr-nav__wf span {
    display: grid;
    place-items: center;
  }

  .dr-nav__wf span + span {
    border-left: 1px solid #d9dce1;
  }

  .dr-nav__wf span.is-active {
    background: #9fa6b0;
  }

  .dr-nav__wf i {
    height: 10px;
    border-radius: 5px;
    background: #c4c9d0;
  }

  .dr-nav__wf .is-active i {
    background: #fff;
  }

  .dr-split {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 5%);
    z-index: 8; /* выше липкой полосы вкладок */
    width: 1px;
    background: #9fa6b0;
    cursor: ew-resize;
    touch-action: none;
  }

  .dr-split::before {
    content: '';
    position: absolute;
    inset: 0 -12px;
  }

  .dr-split__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: #9fa6b0;
    color: #fff;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.2);
    translate: -50% -50%;
    cursor: ew-resize;
    touch-action: none;
    transition:
      scale 0.2s,
      background 0.2s;
  }

  .dr-split__knob svg {
    width: 14px;
    height: 14px;
  }

  .dr-split__knob:hover,
  .dr-split.is-dragging .dr-split__knob {
    scale: 1.15;
    background: #858d98;
  }

  .dr-split__knob:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Вкладки разделов — одна полоса, прилипает к верху окна */
  .dr-nav {
    position: sticky;
    top: 0;
    z-index: 7; /* выше каркаса кусков (5) */
    box-sizing: border-box;
    background: #fff;
  }

  .dr-nav .dr-tabs {
    height: 52px;
  }

  .dr-nav.is-stuck {
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);
  }

  .dr-anchor {
    display: block;
  }

  /* Иконки, легенда, события таймлайна */
  .dr-icon {
    border-radius: 4px;
    transition: background 0.15s;
  }

  .dr-icon:hover {
    background: rgb(56 58 62 / 0.08) !important;
  }

  .dr-leg {
    border-radius: 2px;
  }

  .dr-leg:hover {
    background: rgb(56 58 62 / 0.05) !important;
  }

  .dr-leg::after {
    content: '';
    position: absolute;
    top: 2px;
    left: var(--xx);
    width: 16px;
    height: 16px;
    border-radius: 50%;
  }

  .dr-leg:hover::after {
    background: rgb(56 58 62 / 0.12);
  }

  .dr-leg[aria-pressed='false'],
  .dr-ev.is-off {
    background: rgb(255 255 255 / 0.72) !important;
  }

  .dr-ev {
    border-radius: 3px;
    transition:
      box-shadow 0.15s,
      scale 0.15s;
  }

  .dr-ev:hover {
    scale: 1.12;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.25);
  }

  .dr-ev.is-off {
    pointer-events: none;
  }

  .dr-s > .dr-leg,
  .dr-s > .dr-ev,
  .dr-s > .dr-icon {
    z-index: 2;
  }

  .dr-s > .dr-evp {
    z-index: 3;
  }

  /* Панель событий слева в рамке графика */
  .dr-evp {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    border: 1px solid #dfdddf;
    background: #fff;
    animation: dr-evp 0.25s ease;
  }

  .dr-evp[hidden] {
    display: none;
  }

  .dr-evp__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 12px 24px;
  }

  .dr-evp__head i {
    width: 20px;
    height: 20px;
    background: var(--c);
  }

  .dr-evp__head b {
    flex: 1;
    font-weight: 600;
  }

  .dr-evp__close {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
  }

  .dr-evp__close:hover {
    background: #f5f5f6 !important;
  }

  .dr-evp__list {
    flex: 1;
    overflow: auto;
    padding: 0 16px 16px 24px;
    font-size: 14px;
    color: #383a3e;
    scrollbar-width: thin;
  }

  .dr-evp__list * {
    line-height: 20px !important;
  }

  .dr-evp__item + .dr-evp__item {
    margin-top: 16px;
  }

  .dr-evp__date {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    font-size: 15px;
    font-weight: 600;
  }

  .dr-evp__date a {
    display: grid;
    color: #0d69eb;
  }

  .dr-evp__date a:hover {
    color: #0357cc;
  }

  .dr-evp__item strong {
    font-weight: 600;
  }

  @keyframes dr-evp {
    from {
      opacity: 0;
      translate: -12px 0;
    }
  }

  /* Меню Events: группы с чекбоксами */
  .dr-ev-menu {
    width: 290px;
    padding: 12px 0 8px !important;
    border: 0 !important;
    border-radius: 8px !important;
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.12) !important;
  }

  .dr-ev-menu__group + .dr-ev-menu__group {
    margin-top: 12px;
  }

  .dr-ev-menu__group b {
    display: block;
    padding: 4px 16px 8px;
    font-size: 15px;
    font-weight: 600;
    color: #383a3e;
  }

  .dr-ev-menu__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    font-size: 15px;
    color: #383a3e;
    cursor: pointer;
  }

  .dr-ev-menu__item:hover {
    background: #f0f5fb;
  }

  .dr-ev-menu__item i {
    width: 14px;
    height: 14px;
  }

  .dr-ev-menu__item span {
    flex: 1;
  }

  .dr-ev-menu__item input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: #0d69eb;
    cursor: pointer;
  }

  .dr-ev-menu__all {
    display: block;
    margin: 8px 16px 0 auto !important;
    color: #0d69eb !important;
    font-size: 15px;
  }

  .dr-ev-menu__all:hover {
    text-decoration: underline;
  }

  /* Вкладки разделов */
  .dr-tabs {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    border: 1px solid #dfdddf;
    background: #fff;
  }

  .dr-tabs__tab {
    color: #595959;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .dr-tabs__tab + .dr-tabs__tab {
    border-left: 1px solid #dfdddf !important;
  }

  .dr-tabs__tab:hover {
    background: #f5f5f6 !important;
    color: #262626 !important;
  }

  .dr-tabs__tab.is-active,
  .dr-tabs__tab.is-active:hover {
    background: #0d69eb !important;
    color: #fff !important;
  }

  /* Чипсы в шапке */
  .dr-chips {
    display: flex;
    gap: 13px;
  }

  .dr-chips__chip {
    height: 36px;
    padding-inline: 16px !important;
    border: 1px solid #dfdddf !important;
    border-radius: 2px;
    background: #f5f5f6 !important;
    color: #0d69eb !important;
    white-space: nowrap;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .dr-chips__chip:hover {
    border-color: #0d69eb !important;
    background: #0d69eb !important;
    color: #fff !important;
  }

  /* Переключатели FDA / EMA и валют */
  .dr-seg {
    display: flex;
    padding: 1px;
    background: #fff;
  }

  .dr-seg__item {
    flex: 1;
    font-size: 15px;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .dr-seg__item:hover {
    color: #0d69eb !important;
  }

  .dr-seg__item.is-active,
  .dr-seg__item.is-active:hover {
    background: #0d69eb !important;
    color: #fff !important;
  }

  /* Подвкладки с подчёркиванием */
  .dr-sub__tab {
    position: absolute;
    top: 3px;
    color: #595959 !important;
    font-size: 16px;
    line-height: 20px !important;
    white-space: nowrap;
  }

  .dr-sub__tab::after {
    content: '';
    position: absolute;
    top: 27px;
    right: -1px;
    left: -1px;
    height: 2px;
    background: #0d69eb;
    scale: 0 1;
    transition: scale 0.25s ease;
  }

  .dr-sub__tab:hover {
    color: #262626 !important;
  }

  .dr-sub__tab.is-active {
    color: #262626 !important;
    font-weight: 500 !important;
  }

  .dr-sub__tab.is-active::after {
    scale: 1 1;
  }

  /* Меню */
  .dr-menu__btn {
    position: absolute;
    inset: 0;
    border-radius: 4px;
  }

  .dr-menu--download .dr-menu__btn:hover,
  .dr-menu--download .dr-menu__btn[aria-expanded='true'] {
    background: rgb(13 105 235 / 0.08) !important;
  }

  .dr-menu--events .dr-menu__btn:hover {
    text-decoration: underline;
  }

  .dr-menu__list {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 5;
    min-width: 100%;
    margin: 0;
    padding: 4px 0;
    list-style: none;
    border: 1px solid #dfdddf;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .dr-menu--events .dr-menu__list {
    min-width: 180px;
  }

  /* Меню экспорта — как в макете: иконка файла + формат, наведение — голубая строка */
  .dr-menu--download .dr-menu__list {
    padding: 4px 0;
    border: 0;
    border-radius: 2px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.14);
  }

  .dr-menu--download .dr-menu__list button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    height: 36px;
    padding: 0 18px !important;
    color: #383a3e !important;
    font-size: 16px;
    text-align: left;
  }

  .dr-menu--download .dr-menu__list button:hover {
    background: #f0f5fb !important;
  }

  .dr-menu__list button.is-active {
    color: #0d69eb !important;
    font-weight: 500 !important;
  }

  /* Избранное, коллекция, оповещения */
  .dr-fav svg {
    position: absolute;
    overflow: visible;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 0.2s,
      scale 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .dr-fav[aria-pressed='true'] svg,
  .dr-fav svg.dr-fav__base {
    opacity: 1;
    scale: 1;
  }

  .dr-fav:hover {
    text-decoration: underline;
  }

  .dr-copy {
    border-radius: 4px;
  }

  .dr-copy:hover {
    background: rgb(13 105 235 / 0.1) !important;
  }

  /* Тултип — как в макете */
  .dr__tip {
    position: absolute;
    z-index: 10;
    max-width: 400px;
    padding: 8px 12px;
    border-radius: 4px;
    background: #383a3e;
    color: #fff;
    font-size: 14px;
    white-space: nowrap;
    pointer-events: none;
    animation: dr-tip 0.15s ease;
  }

  .dr__tip * {
    line-height: 20px !important;
  }

  .dr__tip::after {
    content: '';
    position: absolute;
    left: var(--ax, 50%);
    width: 12px;
    height: 7px;
    margin-left: -6px;
    background: #383a3e;
  }

  .dr__tip[data-pos='top']::after {
    top: 100%;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

