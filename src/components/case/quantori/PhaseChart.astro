---
/**
 * Вероятность перехода между фазами: столбики, источник — переключатель «Все / FDA / EMA» (без JS:
 * высота столбика — от `--v`, который берётся из `--all/--fda/--ema` выбранного источника, и плавно
 * меняется). Под графиком — доля дошедших до рынка из фазы I (произведение переходов).
 */
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl } from '../../../i18n/utils';
import Block from './Block.astro';
import { phases } from './data';

interface Props {
  caption: string;
  note?: string;
}

const { caption, note } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
const locale = lang === 'ru' ? 'ru-RU' : 'en-US';
const pct = (v: number) => `${v.toLocaleString(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`;
const keys = ['all', 'fda', 'ema'] as const;
const total = Object.fromEntries(
  keys.map((k) => [k, phases.steps.reduce((acc, s) => (acc * s[k]) / 100, 100)]),
) as Record<(typeof keys)[number], number>;
---

<Block caption={caption} note={note}>
  <div class="q-phase">
    <div class="q-seg" role="radiogroup" aria-label={typograph(phases.hint[lang])}>
      {phases.sources.map((s, i) => (
        <label>
          <input type="radio" name="q-phase" value={s.key} checked={i === 0} />
          {typograph(s.label[lang])}
        </label>
      ))}
    </div>
    <ol class="q-phase__chart">
      {phases.steps.map((step, i) => (
        <li
          class="q-phase__col"
          style={`--i: ${i}; --all: ${step.all / 100}; --fda: ${step.fda / 100}; --ema: ${step.ema / 100}`}
        >
          <p class="q-phase__value">
            {keys.map((k) => <span data-src={k}>{pct(step[k])}</span>)}
          </p>
          <div class="q-phase__track">
            <div class="q-phase__bar" />
          </div>
          <p class="q-phase__label">{typograph(step.label[lang])}</p>
        </li>
      ))}
    </ol>
    <p class="q-phase__total">
      <span class="q-phase__total-value">
        {keys.map((k) => <span data-src={k}>{pct(total[k])}</span>)}
      </span>
      <span class="q-phase__total-label">{typograph(phases.total[lang])}</span>
    </p>
  </div>
</Block>

<style>
  .q-phase {
    --q-color: var(--case-accent);
  }

  .q-phase:has(input[value='fda']:checked) {
    --q-color: var(--case-data-fda);

    .q-phase__col {
      --v: var(--fda);
    }
  }

  .q-phase:has(input[value='ema']:checked) {
    --q-color: var(--case-data-ema);

    .q-phase__col {
      --v: var(--ema);
    }
  }

  /* Подписи выбранного источника. */
  .q-phase [data-src] {
    display: none;
  }

  .q-phase:has(input[value='all']:checked) [data-src='all'],
  .q-phase:has(input[value='fda']:checked) [data-src='fda'],
  .q-phase:has(input[value='ema']:checked) [data-src='ema'] {
    display: inline;
  }

  .q-phase__chart {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .q-phase__col {
    --v: var(--all);
    cursor: default;
  }

  .q-phase__value {
    margin-bottom: 12px;
    font-size: var(--case-metric-size);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    color: var(--case-text);
    font-variant-numeric: tabular-nums;
  }

  .q-phase__track {
    display: flex;
    align-items: flex-end;
    height: var(--case-bar-h);
    border-bottom: 1px solid var(--case-tabs-border-strong);
  }

  .q-phase__bar {
    width: 100%;
    height: round(calc(var(--v) * var(--case-bar-h)), 2px);
    border-radius: 12px 12px 0 0;
    background: var(--q-color);
    transform-origin: bottom;
    transition:
      height 0.8s var(--case-slide-ease),
      background-color 0.6s,
      filter 0.3s,
      transform 1s var(--case-slide-ease) calc(var(--i) * 120ms);
  }

  .q-phase__col:hover .q-phase__bar {
    filter: brightness(1.15);
  }

  .q-phase__col:hover .q-phase__value {
    color: var(--q-color);
  }

  /* Проявление при прокрутке: столбики вырастают по очереди. */
  :global([data-reveal='pending']) .q-phase__bar {
    transform: scaleY(0);
  }

  .q-phase__label {
    margin-top: 12px;
    color: var(--case-muted);
  }

  .q-phase__total {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    align-items: baseline;
    margin-top: 32px;
  }

  .q-phase__total-value {
    font-size: var(--case-metric-size);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    color: var(--q-color);
    transition: color 0.6s;
  }

  .q-phase__total-label {
    color: var(--case-text);
  }

  @container case (max-width: 599px) {
    .q-phase__chart {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .q-phase__bar {
      transition: none;
    }
  }
</style>
