---
/**
 * Рабочий график курса акций (Stock Price) — по макетам пользователя (design/cases/quantori/stock/*.svg).
 * Разметку и поведение строит `src/scripts/stock-chart.ts` (`initStockCharts` в CaseDrawer);
 * виджет свёрстан в ширину 1120px и масштабируется под колонку (`zoom`, на телефоне не уже 760px — листается вбок).
 */
import '@fontsource-variable/roboto/wght.css';

interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<div class="sc" data-stock-chart role="figure" aria-label={alt}></div>

<style is:global>
  .sc {
    overflow-x: auto;
    border-radius: var(--tile-radius);
    background: #fff;
    scrollbar-width: thin;
  }

  .sc__page {
    position: relative;
    box-sizing: border-box;
    width: 1120px;
    padding: 32px 40px 28px;
    color: #262626;
    font-family: 'Roboto Variable', sans-serif;
    font-size: 14px;
    letter-spacing: normal;
    -webkit-font-smoothing: antialiased;
  }

  .sc__page * {
    line-height: normal;
  }

  .sc__page button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .sc__head {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .sc__sym {
    color: #b6b8bb;
    font-size: 56px;
    font-weight: 700;
    line-height: 56px !important;
  }

  .sc__quote {
    display: grid;
    gap: 8px;
    padding-top: 4px;
    font-size: 16px;
  }

  .sc__quote b {
    font-weight: 600;
  }

  .sc__neg {
    color: #e5484d;
  }

  .sc__muted {
    color: #595959;
    font-size: 14px;
  }

  .sc__muted-dark {
    color: #383a3e;
    font-size: 15px;
  }

  .sc__cur {
    margin-left: auto;
    color: #595959;
    font-size: 13px;
  }

  .sc__controls {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
    font-size: 15px;
  }

  .sc__dd {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sc__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #0d69eb !important;
  }

  .sc__link:hover {
    text-decoration: underline;
  }

  .sc__plain {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #383a3e;
  }

  .sc__plain:hover,
  .sc__plain.is-on {
    color: #0d69eb !important;
  }

  .sc__periods {
    display: flex;
    gap: 16px;
  }

  .sc__periods button {
    position: relative;
    color: #595959 !important;
  }

  .sc__periods button:hover {
    color: #262626 !important;
  }

  .sc__periods button.is-active {
    color: #262626 !important;
    font-weight: 600 !important;
  }

  .sc__periods button::after {
    content: '';
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    left: 0;
    height: 2px;
    background: #0d69eb;
    scale: 0 1;
    transition: scale 0.2s;
  }

  .sc__periods button.is-active::after {
    scale: 1 1;
  }

  .sc__right {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: auto;
  }

  /* Меню */
  .sc__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 5;
    padding: 12px 0;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.14);
    font-size: 14px;
  }

  .sc__menu[hidden] {
    display: none;
  }

  .sc__menu--type {
    left: 72px;
    right: auto;
    min-width: 120px;
    padding: 4px 0;
  }

  .sc__menu--type button {
    display: block;
    width: 100%;
    padding: 8px 16px !important;
    text-align: left;
  }

  .sc__menu--type button:hover {
    background: #f0f5fb !important;
  }

  .sc__menu--events {
    width: 290px;
  }

  .sc__menu--events b {
    display: block;
    margin-top: 8px;
    padding: 4px 16px;
    font-weight: 600;
    color: #383a3e;
  }

  .sc__menu--events b:first-child {
    margin-top: 0;
  }

  .sc__menu--events label,
  .sc__tk-list label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    color: #383a3e;
    cursor: pointer;
  }

  .sc__menu--events label:hover,
  .sc__tk-list label:hover {
    background: #f0f5fb;
  }

  .sc__menu--events i,
  .sc__rev-row i {
    width: 12px;
    height: 12px;
    flex: none;
  }

  .sc__menu--events span {
    flex: 1;
  }

  .sc__page input[type='checkbox'] {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: #0d69eb;
    cursor: pointer;
  }

  .sc__all {
    display: block !important;
    margin: 8px 16px 0 auto !important;
    text-align: right;
  }

  .sc__search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid #dfdddf;
    border-radius: 4px;
  }

  .sc__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    font: inherit;
  }

  .sc__menu--tickers {
    width: 480px;
    padding: 12px 0 8px;
  }

  .sc__tk-top {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
  }

  .sc__tk-top .sc__search {
    flex: 1;
  }

  /* Быстрые тикеры — одной строкой. */
  .sc__quick {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
  }

  .sc__quick button {
    padding: 4px 8px !important;
    border: 1px solid #dfdddf !important;
    border-radius: 4px;
    color: #0d69eb !important;
    font-size: 13px;
  }

  .sc__quick button:hover,
  .sc__quick button.is-on {
    border-color: #0d69eb !important;
    background: #e9f1fd !important;
  }

  .sc__qtip {
    position: absolute;
    z-index: 6;
    padding: 6px 10px;
    border-radius: 4px;
    background: #383a3e;
    color: #fff;
    font-size: 13px;
    white-space: nowrap;
    pointer-events: none;
  }

  .sc__tk-list {
    max-height: 300px;
    overflow: auto;
    scrollbar-width: thin;
  }

  .sc__tk-list label span:first-child {
    flex: 1;
  }

  .sc__tk-list label span:nth-child(2) {
    color: #8a8d93;
    font-size: 13px;
  }

  .sc__tk-list label.is-main {
    color: #b6b8bb;
  }

  .sc__tk-list label[hidden],
  .sc__rev-row[hidden] {
    display: none;
  }

  .sc__menu--revenue {
    width: 420px;
    padding: 12px 16px;
  }

  .sc__rev-head,
  .sc__rev-row {
    display: grid;
    grid-template-columns: 1fr 64px 64px 96px;
    align-items: center;
    justify-items: center;
  }

  .sc__rev-head {
    margin-top: 12px;
    padding-bottom: 6px;
    color: #595959;
    font-size: 13px;
  }

  .sc__rev-list {
    max-height: 320px;
    overflow: auto;
    scrollbar-width: thin;
  }

  .sc__rev-row {
    padding: 6px 0;
    color: #383a3e;
  }

  .sc__rev-row:hover {
    background: #f0f5fb;
  }

  .sc__rev-row > span {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
  }

  .sc__rev-row--all {
    font-weight: 500;
  }

  /* Чипсы тикеров */
  .sc__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  /* Плашка тикера: символ слева, цена и % — друг под другом по правому краю; колонка значений фиксированной
     ширины и цифры одной ширины — при наведении на график плашка не меняет размер. */
  .sc__chip {
    display: grid;
    grid-template-columns: auto 80px;
    column-gap: 12px;
    align-items: center;
    padding: 6px 12px 6px 18px;
    border: 1px solid #ececee;
    border-left: 6px solid var(--c);
    border-radius: 2px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .sc__chip b {
    font-weight: 500;
  }

  .sc__chip--x {
    grid-template-columns: auto 80px auto;
  }

  .sc__chip span {
    grid-column: 2;
    justify-self: end;
    white-space: nowrap;
  }

  .sc__chip button {
    grid-column: 3;
    grid-row: 1 / 3;
    margin-left: 4px !important;
    color: #383a3e !important;
    font-size: 18px !important;
  }

  .sc__chip button:hover {
    color: #e5484d !important;
  }

  .sc__ev-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
    color: #383a3e;
    font-size: 13px;
  }

  .sc__ev-legend:empty {
    display: none;
  }

  .sc__ev-legend span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sc__ev-legend i {
    width: 12px;
    height: 12px;
  }

  .sc__ev-legend button {
    color: #606165 !important;
  }

  .sc__ev-legend button:hover {
    color: #e5484d !important;
  }

  /* График */
  .sc__plot-wrap {
    position: relative;
    margin-top: 8px;
  }

  .sc__svg {
    display: block;
    overflow: visible;
    user-select: none;
  }

  .sc__ax {
    fill: #383a3e;
    font-size: 12px;
  }

  .sc__ax--small {
    font-size: 11px;
    fill: #595959;
  }

  .sc__ax--inv {
    fill: #fff;
  }

  .sc__ev {
    cursor: pointer;
  }

  .sc__ev:hover rect {
    filter: brightness(1.1);
  }

  .sc__ev-n {
    fill: #fff;
    font-size: 11px;
    pointer-events: none;
  }

  .sc__nav-win {
    cursor: grab;
  }

  .sc__nav-h {
    cursor: ew-resize;
  }

  .sc__ohlc {
    position: absolute;
    display: grid;
    gap: 2px;
    padding: 8px 12px;
    border: 1px solid #ececee;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.92);
    font-size: 12px;
    pointer-events: none;
  }

  .sc__ohlc[hidden],
  .sc__tip[hidden],
  .sc__panel[hidden] {
    display: none;
  }

  .sc__ohlc div {
    display: grid;
    grid-template-columns: 64px 16px auto;
  }

  .sc__ohlc .sc__ohlc-date {
    display: block;
    margin-bottom: 4px;
    font-weight: 600;
  }

  .sc__ohlc i {
    color: #8a8d93;
    font-style: normal;
  }

  .sc__ohlc b {
    font-weight: 500;
  }

  .sc__tip {
    position: absolute;
    z-index: 4;
    display: grid;
    gap: 2px;
    padding: 8px 12px;
    border-radius: 4px;
    background: #383a3e;
    color: #fff;
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
  }

  .sc__tip b {
    font-weight: 600;
  }

  .sc__tip span {
    color: #d5d7da;
  }

  .sc__tip-row {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #fff !important;
  }

  .sc__tip-row i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  /* Панель событий слева — поверх графика до низа навигатора */
  .sc__panel {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 360px;
    border: 1px solid #dfdddf;
    background: #fff;
    animation: sc-panel 0.25s ease;
  }

  .sc__panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 12px 20px;
    font-size: 16px;
  }

  .sc__panel-head i {
    width: 20px;
    height: 20px;
  }

  .sc__panel-head b {
    flex: 1;
    font-weight: 600;
  }

  .sc__panel-head button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
  }

  .sc__panel-head button:hover {
    background: #f5f5f6 !important;
  }

  .sc__panel-list {
    flex: 1;
    overflow: auto;
    padding: 0 16px 16px 20px;
    color: #383a3e;
    font-size: 14px;
    scrollbar-width: thin;
  }

  .sc__panel-list > div + div {
    margin-top: 16px;
  }

  .sc__panel-date {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    font-size: 15px;
    font-weight: 600;
  }

  .sc__panel-date a {
    display: grid;
    color: #0d69eb;
  }

  .sc__panel-list strong {
    font-weight: 600;
  }

  @keyframes sc-panel {
    from {
      opacity: 0;
      translate: -12px 0;
    }
  }
</style>
