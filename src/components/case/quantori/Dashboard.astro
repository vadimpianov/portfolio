---
/**
 * Мок страницы BioHarmony «было / стало»: одни и те же таблицы в двух раскладках. Было — таблицы
 * разного размера, кегля, плотности и цвета шапок; стало — общая сетка, одна высота строки, числа
 * по правому краю. Переключение без JS (радиокнопки + :has): раскладка перестраивается, карточки
 * «оседают» по очереди. Уже `--case-dash-min-w` листается по горизонтали.
 */
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl } from '../../../i18n/utils';
import Block from './Block.astro';
import { dashboard as d } from './data';

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
const text = (v: string | Record<string, string>) => typograph(typeof v === 'string' ? v : v[lang]);
const isNum = (v: unknown) => typeof v === 'string' && /^[\d.,%\s]+$/.test(v);
const isSource = (v: unknown) => v === 'FDA' || v === 'EMA';
---

<Block caption={caption}>
  <div class="q-dash">
    <div class="q-seg" role="radiogroup" aria-label={text(d.switch)}>
      <label><input type="radio" name="q-dash" value="before" checked />{text(d.before)}</label>
      <label><input type="radio" name="q-dash" value="after" />{text(d.after)}</label>
    </div>
    <div class="q-dash__scroll">
      <div class="q-dash__app">
        <div class="q-dash__bar">
          <span class="q-dash__logo">{text(d.app)}</span>
          <span class="q-dash__crumbs">{text(d.crumbs)}</span>
        </div>
        <ul class="q-dash__filters">
          {d.filters.map((f) => <li>{text(f)}</li>)}
        </ul>
        <div class="q-dash__grid">
          {d.tables.map((table, i) => (
            <section class={`q-dash__card q-dash__card--${table.key}`} style={`--i: ${i}`}>
              <h4 class="q-dash__title">{text(table.title)}</h4>
              <table class="q-dash__table">
                <thead>
                  <tr>
                    {table.cols.map((col, c) => (
                      <th class:list={{ num: c > 0 && isNum(table.rows[0][c]) }}>{text(col)}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {table.rows.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td class:list={{ num: isNum(cell) }}>
                          {isSource(cell) ? (
                            <span class={`q-badge q-badge--${String(cell).toLowerCase()}`}>{cell}</span>
                          ) : (
                            text(cell)
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</Block>

<style>
  .q-dash {
    --q-ui-bg: #ffffff;
    --q-ui-text: #1d2733;
    --q-ui-muted: #6b7785;
    --q-ui-line: #e3e8ee;
    --q-ui-surface: #f3f5f8;
    --q-ease: cubic-bezier(0.32, 0.72, 0, 1);
  }

  .q-dash__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    border-radius: var(--tile-radius);
  }

  .q-dash__app {
    min-width: var(--case-dash-min-w);
    padding: 0 0 24px;
    background: var(--q-ui-bg);
    color: var(--q-ui-text);
    font-size: 13px;
    --lh: var(--leading-lead);
    transition: background-color 0.5s;
  }

  .q-dash__bar {
    display: flex;
    gap: 24px;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    background: #222d38;
    color: #fff;
    transition: background-color 0.5s;
  }

  .q-dash__logo {
    font-weight: 700;
  }

  .q-dash__crumbs {
    color: rgb(255 255 255 / 0.6);
  }

  .q-dash__filters {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 16px 24px 0;
    list-style: none;
  }

  .q-dash__filters li {
    padding: 4px 12px;
    border: 1px solid var(--q-ui-line);
    border-radius: 6px;
    color: var(--q-ui-muted);
    font-size: 12px;
  }

  /* —— Было: каждая таблица живёт своей жизнью. —— */
  .q-dash__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
    padding: 16px 24px 0;
    font-family: Arial, Helvetica, sans-serif;
  }

  .q-dash__card {
    min-width: 0;
    animation: q-settle-b 0.6s var(--q-ease) both;
    animation-delay: calc(var(--i) * 70ms);
  }

  .q-dash__title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 700;
  }

  .q-dash__table {
    width: 100%;
    border-collapse: collapse;
  }

  .q-dash__table :is(th, td) {
    padding: 4px 6px;
    border: 1px solid #c9c9c9;
    text-align: left;
    white-space: nowrap;
    transition:
      padding 0.5s var(--q-ease),
      font-size 0.5s var(--q-ease),
      background-color 0.5s,
      color 0.5s,
      border-color 0.5s;
  }

  .q-dash__table th {
    font-weight: 700;
  }

  .q-dash__card--programs {
    grid-column: 1 / 8;
    font-size: 11px;
  }

  .q-dash__card--programs th {
    background: #337ab7;
    color: #fff;
  }

  .q-dash__card--fda {
    grid-column: 8 / 13;
    font-size: 16px;
  }

  .q-dash__card--fda :is(th, td) {
    padding: 10px 14px;
    text-align: center;
  }

  .q-dash__card--fda th {
    background: #e6e6e6;
  }

  .q-dash__card--ema {
    grid-column: 1 / 5;
    font-size: 13px;
  }

  .q-dash__card--ema th {
    background: #dff0d8;
  }

  .q-dash__card--ema .q-dash__title {
    font-size: 12px;
    text-transform: uppercase;
  }

  .q-dash__card--phases {
    grid-column: 5 / 10;
    font-size: 12px;
  }

  .q-dash__card--phases :is(th, td) {
    padding: 2px 4px;
    border: 3px double #999;
  }

  .q-dash__card--phases th {
    background: #fcf8e3;
  }

  .q-dash__card--phases .q-dash__title {
    font-size: 20px;
  }

  .q-dash__card--refusals {
    grid-column: 10 / 13;
    font-size: 14px;
  }

  .q-dash__card--refusals th {
    background: #f2dede;
    color: #a94442;
  }

  .q-badge {
    font-weight: 700;
  }

  /* —— Стало: общая сетка, одна высота строки, один кегль, числа по правому краю. —— */
  .q-dash:has(input[value='after']:checked) {
    .q-dash__app {
      background: var(--q-ui-surface);
    }

    .q-dash__bar {
      background: #fff;
      color: var(--q-ui-text);
      box-shadow: inset 0 -1px 0 var(--q-ui-line);
    }

    .q-dash__crumbs {
      color: var(--q-ui-muted);
    }

    .q-dash__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      align-items: stretch;
      font-family: inherit;
    }

    .q-dash__card {
      grid-column: auto;
      padding: 16px 20px 8px;
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 1px 2px rgb(16 24 40 / 0.06);
      font-size: 13px;
      animation-name: q-settle-a;
    }

    .q-dash__card--programs {
      grid-column: 1 / -1;
    }

    .q-dash__title {
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 600;
      text-transform: none;
    }

    .q-dash__table :is(th, td) {
      padding: 10px 12px;
      border: 0;
      border-top: 1px solid var(--q-ui-line);
      background: none;
      color: inherit;
      text-align: left;
      font-variant-numeric: tabular-nums;
    }

    .q-dash__table th {
      border-top: 0;
      color: var(--q-ui-muted);
      font-size: 12px;
      font-weight: 500;
    }

    .q-dash__table :is(th, td):first-child {
      padding-left: 0;
    }

    .q-dash__table :is(th, td):last-child {
      padding-right: 0;
    }

    .q-dash__table .num {
      text-align: right;
    }

    .q-badge {
      display: inline-block;
      padding: 0 8px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }

    .q-badge--fda {
      background: #ffe4da;
      color: #9a3412;
    }

    .q-badge--ema {
      background: #dcecff;
      color: #1d4f91;
    }
  }

  /* Две одинаковые анимации — чтобы «оседание» запускалось заново при каждом переключении. */
  @keyframes q-settle-a {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  @keyframes q-settle-b {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .q-dash__card {
      animation: none !important;
    }
  }
</style>
