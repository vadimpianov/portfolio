---
/**
 * Таблица терапевтических областей: сортировка по любой колонке (клик по заголовку — скрипт
 * `src/scripts/case-data.ts`, строки переезжают на новые места), у доли дошедших до рынка — полоска.
 * Уже `--case-table-min-w` листается по горизонтали.
 */
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl } from '../../../i18n/utils';
import Block from './Block.astro';
import { areas } from './data';

interface Props {
  caption: string;
  note?: string;
}

const { caption, note } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);
const locale = lang === 'ru' ? 'ru-RU' : 'en-US';
const maxLoa = Math.max(...areas.rows.map((r) => r.loa));
const fmt = (key: string, v: number) =>
  v.toLocaleString(locale, key === 'loa' || key === 'years' ? { minimumFractionDigits: 1 } : {});
---

<Block caption={caption} note={note}>
  <div class="q-table__scroll">
    <table class="q-table" data-sortable>
      <thead>
        <tr>
          {areas.cols.map((col, i) => (
            <th class:list={{ num: col.type === 'num' }} aria-sort={i === 2 ? 'descending' : undefined}>
              <button type="button" data-sort-col={i} data-sort-type={col.type}>
                {typograph(col.label[lang])}
                <span class="q-table__arrow" aria-hidden="true" />
              </button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {[...areas.rows]
          .sort((a, b) => b.loa - a.loa)
          .map((row, r) => (
            <tr style={`--i: ${r}`}>
              {areas.cols.map((col) => {
                const v = row[col.key];
                return typeof v === 'number' ? (
                  <td class="num" data-value={v}>
                    {col.key === 'loa' ? (
                      <span class="q-table__loa">
                        <span class="q-table__meter" style={`--share: ${v / maxLoa}`} />
                        <span class="q-table__num">{fmt(col.key, v)}</span>
                      </span>
                    ) : (
                      fmt(col.key, v)
                    )}
                  </td>
                ) : (
                  <td data-value={v[lang]}>{typograph(v[lang])}</td>
                );
              })}
            </tr>
          ))}
      </tbody>
    </table>
  </div>
</Block>

<style>
  .q-table__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .q-table {
    width: 100%;
    min-width: var(--case-table-min-w);
    border-collapse: collapse;
    color: var(--case-text);
    font-variant-numeric: tabular-nums;
  }

  .q-table :is(th, td) {
    padding: 14px 12px;
    border-bottom: 1px solid var(--case-tabs-border);
    text-align: left;
    white-space: nowrap;
  }

  .q-table :is(th, td):first-child {
    padding-left: 0;
  }

  .q-table :is(th, td):last-child {
    padding-right: 0;
  }

  .q-table .num {
    text-align: right;
  }

  .q-table th {
    border-bottom-color: var(--case-tabs-border-strong);
    font-weight: 400;
  }

  .q-table th button {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--case-muted);
    font: inherit;
    font-size: var(--case-label-size);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s;
  }

  .q-table th.num button {
    flex-direction: row-reverse;
  }

  .q-table th button:hover,
  .q-table th[aria-sort] button {
    color: var(--case-accent);
  }

  .q-table th button:focus-visible {
    outline: 2px solid var(--case-accent);
    outline-offset: 4px;
  }

  /* Стрелка сортировки: видна у выбранной колонки, у остальных — при наведении. */
  .q-table__arrow {
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    opacity: 0;
    transform: translateY(-2px) rotate(45deg);
    transition:
      opacity 0.2s,
      transform 0.3s;
  }

  .q-table th button:hover .q-table__arrow,
  .q-table th[aria-sort] .q-table__arrow {
    opacity: 1;
  }

  .q-table th[aria-sort='ascending'] .q-table__arrow {
    transform: translateY(2px) rotate(-135deg);
  }

  .q-table tbody tr {
    transition: background-color 0.2s;
  }

  .q-table tbody tr:hover {
    background: rgb(255 255 255 / 0.04);
  }

  .q-table__loa {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    justify-content: flex-end;
  }

  .q-table__num {
    min-width: 40px;
  }

  .q-table__meter {
    width: 120px;
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(var(--case-accent), var(--case-accent)) no-repeat 0 0 /
      calc(var(--share) * 100%) 100%;
    background-color: var(--case-tabs-border);
    transition: background-size 1s var(--case-slide-ease) calc(var(--i) * 80ms);
  }

  :global([data-reveal='pending']) .q-table__meter {
    background-size: 0 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .q-table__num {
    min-width: 40px;
  }

  .q-table__meter {
      transition: none;
    }
  }
</style>
