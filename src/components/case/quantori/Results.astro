---
/**
 * Результаты «было → стало» — в стиле масштаба PharmaKB (`Scale.astro`): слева крупное число «стало»
 * (досчитывает при прокрутке, `data-count` — `src/scripts/case-data.ts`), справа — название и серая подпись
 * «было N», под ними полоска: жёлтая — стало, бледная под ней — было (доля от большего из двух).
 */
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl } from '../../../i18n/utils';
import Block from './Block.astro';
import { results as main, stories } from './data';

interface Props {
  caption?: string;
  note?: string;
  was: string;
  /** Набор цифр: итоги кейса (по умолчанию) или одна из историй «что мы улучшили». */
  set?: keyof typeof stories;
}

const { caption, note, was, set } = Astro.props;
const results = set ? stories[set] : main;
const lang = getLocaleFromUrl(Astro.url);
const locale = lang === 'ru' ? 'ru-RU' : 'en-US';
const decimals = (v: number) => (Number.isInteger(v) ? 0 : 1);
const fmt = (v: number, d: number) => v.toLocaleString(locale, { minimumFractionDigits: d, maximumFractionDigits: d });
---

<Block caption={caption} note={note}>
  <ul class="q-results">
    {results.map((item, i) => {
      const d = Math.max(decimals(item.from), decimals(item.to));
      const max = Math.max(item.from, item.to);
      return (
        <li class="q-results__row" style={`--i: ${i}`}>
          <p class="q-results__value">
            <span data-count={item.to} data-count-from={item.from} data-decimals={d}>
              {fmt(item.to, d)}
            </span>
          </p>
          <div class="q-results__chart">
            <p class="q-results__label">
              {typograph(item.label[lang])}
              <span class="q-results__was">{typograph(`${was} ${fmt(item.from, d)}`)}</span>
            </p>
            <div class="q-results__track" aria-hidden="true">
              <span class="q-results__bar q-results__bar--from" style={`--share: ${item.from / max}`} />
              <span class="q-results__bar q-results__bar--to" style={`--share: ${item.to / max}`} />
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</Block>

<style>
  .q-results {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0 !important;
    list-style: none;
    overflow: visible !important;
  }

  .q-results__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 20px;
    align-items: end;
  }

  .q-results__value {
    color: var(--case-accent);
    font-size: round(calc(var(--case-metric-size) * 1.5), 1px);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    /* Пропорциональные цифры — числа начинаются ровно по левому краю колонки (у моноширинной «1» отступ слева). */
    white-space: nowrap;
  }

  /* Название — слева, серое «было» — справа, над концом полоски. */
  .q-results__label {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    justify-content: space-between;
    margin-bottom: 12px;
    color: var(--case-text);
  }

  .q-results__was {
    color: var(--case-muted);
    text-align: right;
  }

  .q-results__track {
    position: relative;
    height: 12px;
    border-radius: 6px;
    background: var(--case-tabs-border);
    overflow: hidden;
  }

  .q-results__bar {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    background: var(--case-accent);
    transform-origin: left;
    scale: var(--share) 1;
    transition: scale 1.4s var(--case-slide-ease) calc(var(--i) * 140ms);
  }

  /* «Было» — бледная полоска под жёлтой: видна, где было больше, чем стало. */
  .q-results__bar--from {
    background: var(--case-tabs-border-strong);
  }

  :global([data-reveal='pending']) .q-results__bar {
    scale: 0 1;
  }

  @container case (max-width: 599px) {
    .q-results__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .q-results__was {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .q-results__bar {
      transition: none;
    }
  }
</style>
