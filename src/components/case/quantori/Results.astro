---
/**
 * Результаты «было → стало»: крупное число «стало» досчитывает при прокрутке (`data-count`,
 * `src/scripts/case-data.ts`), под ним — две полоски для сравнения: было (серая) и стало (жёлтая).
 */
import { typograph } from '../../../i18n/typograph';
import { getLocaleFromUrl } from '../../../i18n/utils';
import Block from './Block.astro';
import { results as main, stories } from './data';

interface Props {
  caption: string;
  note?: string;
  was: string;
  /** Набор цифр: итоги кейса (по умолчанию) или одна из историй «что мы улучшили». */
  set?: keyof typeof stories;
}

const { caption, note, was, set } = Astro.props;
const results = set ? stories[set] : main;
const lang = getLocaleFromUrl(Astro.url);
const locale = lang === 'ru' ? 'ru-RU' : 'en-US';
const decimals = (v: number) => (Number.isInteger(v) ? 0 : 1);
const fmt = (v: number, d: number) => v.toLocaleString(locale, { minimumFractionDigits: d, maximumFractionDigits: d });
---

<Block caption={caption} note={note}>
  <ul class="q-results">
    {results.map((item, i) => {
      const d = Math.max(decimals(item.from), decimals(item.to));
      const max = Math.max(item.from, item.to);
      return (
        <li class="q-results__item" style={`--i: ${i}`}>
          <p class="q-results__value">
            <span data-count={item.to} data-count-from={item.from} data-decimals={d}>
              {fmt(item.to, d)}
            </span>
          </p>
          <p class="q-results__was">{typograph(`${was} ${fmt(item.from, d)}`)}</p>
          <div class="q-results__bars" aria-hidden="true">
            <span class="q-results__bar q-results__bar--from" style={`--share: ${item.from / max}`} />
            <span class="q-results__bar q-results__bar--to" style={`--share: ${item.to / max}`} />
          </div>
          <p class="q-results__label">{typograph(item.label[lang])}</p>
        </li>
      );
    })}
  </ul>
</Block>

<style>
  .q-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container case (max-width: 899px) {
    .q-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  .q-results__item {
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    border: 1px solid var(--case-tabs-border-strong);
    border-radius: var(--case-tabs-radius);
  }

  .q-results__value {
    color: var(--case-accent);
    font-size: round(calc(var(--case-metric-size) * 1.5), 1px);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    font-variant-numeric: tabular-nums;
  }

  .q-results__was {
    margin-top: 4px;
    color: var(--case-muted);
  }

  .q-results__bars {
    display: grid;
    gap: 6px;
    margin: 20px 0;
  }

  .q-results__bar {
    height: 6px;
    border-radius: 4px;
    background: var(--case-tabs-border-strong);
    transform-origin: left;
    scale: var(--share) 1;
    transition: scale 1.2s var(--case-slide-ease) calc(var(--i) * 120ms);
  }

  .q-results__bar--to {
    background: var(--case-accent);
  }

  :global([data-reveal='pending']) .q-results__bar {
    scale: 0 1;
  }

  .q-results__label {
    margin-top: auto;
    color: var(--case-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .q-results__bar {
      transition: none;
    }
  }
</style>
