---
/**
 * Обложка кейса — слайдер экранов: текущий экран впереди, соседние — меньше, за ним и приглушены
 * до 55% (затемнением цветом фона, а не прозрачностью — при смене экраны не просвечивают друг сквозь друга).
 * Экраны кликабельны (сосед — к нему, текущий — к следующему), соседи на наведение чуть поворачиваются;
 * автопрокрутка (стоит под курсором и при фокусе с клавиатуры). При переключении новый экран плавно
 * проявляется и увеличивается. Логика — `src/scripts/cover-slider.ts` (подключает CaseDrawer).
 */
import { readFileSync } from 'node:fs';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';
import { asset } from '../../utils/asset';

interface Props {
  /** Экраны слева направо: имена в `public/images/cases/` без `.webp`. */
  slides: string[];
}

const { slides } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
// Первым показан средний экран.
const start = Math.floor(slides.length / 2);
const pos = (i: number) => {
  const d = (i - start + slides.length) % slides.length;
  return d === 0 ? 'current' : d === 1 ? 'next' : d === slides.length - 1 ? 'prev' : 'hidden';
};

// Размеры экранов (WebP с альфой, заголовок VP8X) — пропорция сцены.
const size = (name: string) => {
  const head = readFileSync(`public/images/cases/${name}.webp`).subarray(0, 30);
  return { width: head.readUIntLE(24, 3) + 1, height: head.readUIntLE(27, 3) + 1 };
};
const first = size(slides[0]);
---

<div
  class="case-slider"
  data-slider
  role="group"
  aria-roledescription="carousel"
  style={`--slide-ratio: ${first.width} / ${first.height}`}
>
  {slides.map((name, i) => {
    const { width, height } = size(name);
    const src = asset(`/images/cases/${name}.webp`);
    return (
      <button
        class="case-slider__slide"
        type="button"
        data-pos={pos(i)}
        aria-label={t('case.slider.show')}
        style={`--src: url("${src}")`}
      >
        <img
          src={src}
          width={width}
          height={height}
          alt=""
          decoding="async"
          draggable="false"
          fetchpriority={i === start ? 'high' : undefined}
        />
      </button>
    );
  })}
</div>

<style>
  /* Текущий экран — по центру (доля ширины --case-slide-w); соседи уменьшены и выглядывают из-за него,
     их внешний край — ровно по краю обложки. */
  .case-slider {
    position: relative;
    /* Композиция — во всю ширину обложки (правой колонки). */
    width: var(--case-slider-w);
    margin-inline: auto;
    aspect-ratio: calc(var(--slide-ratio) / var(--case-slide-w));
  }

  .case-slider__slide {
    position: absolute;
    top: 0;
    left: calc(50% * (1 - var(--case-slide-w)));
    width: calc(100% * var(--case-slide-w));
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform: translateX(var(--x, 0)) scale(var(--s, 1)) rotate(var(--r, 0deg));
    transition: transform var(--case-slide-duration) var(--case-slide-ease);
    -webkit-tap-highlight-color: transparent;
  }

  .case-slider__slide img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
  }

  /* Приглушение соседей: слой цвета фона по форме экрана (маска — сама картинка). Картинки всегда
     непрозрачные, поэтому при переходе один экран не просвечивает сквозь другой. */
  .case-slider__slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--case-surface);
    mask: var(--src) center / 100% 100% no-repeat;
    opacity: var(--dim, 0);
    transition: opacity var(--case-slide-duration) var(--case-slide-ease);
    pointer-events: none;
  }

  .case-slider__slide[data-pos='current'] {
    z-index: 3;
  }

  /* Новый текущий сразу выходит вперёд — поэтому светлеет быстро, в начале движения: вперёд
     выезжает уже яркий экран, а не тёмный поверх светлого. */
  .case-slider__slide[data-pos='current']::after {
    transition-duration: calc(var(--case-slide-duration) * 0.4);
    transition-timing-function: ease-out;
  }

  .case-slider__slide[data-pos='prev'],
  .case-slider__slide[data-pos='next'] {
    z-index: 2;
    --s: var(--case-slide-side-scale);
    --dim: calc(1 - var(--case-slide-side-opacity));
  }

  /* Сдвиг соседа в долях его ширины: внешний край — по краю обложки. */
  .case-slider__slide[data-pos='prev'] {
    --x: calc(-100% * (0.5 / var(--case-slide-w) - var(--case-slide-side-scale) / 2));
  }

  .case-slider__slide[data-pos='next'] {
    --x: calc(100% * (0.5 / var(--case-slide-w) - var(--case-slide-side-scale) / 2));
  }

  /* Экран, который переезжает с одного края на другой, идёт позади всех. */
  .case-slider__slide[data-wrap] {
    z-index: 1;
  }

  .case-slider__slide[data-pos='hidden'] {
    z-index: 0;
    --s: 0.6;
    --dim: 1;
  }

  /* Наведение (мышь) — только на соседей: чуть поворачиваются и светлеют. Текущий на наведение не реагирует. */
  @media (hover: hover) {
    .case-slider__slide[data-pos='prev']:hover {
      --r: -1.5deg;
      --dim: calc((1 - var(--case-slide-side-opacity)) / 2);
    }

    .case-slider__slide[data-pos='next']:hover {
      --r: 1.5deg;
      --dim: calc((1 - var(--case-slide-side-opacity)) / 2);
    }
  }

  .case-slider__slide:focus-visible {
    outline: 2px solid var(--case-accent);
    outline-offset: 4px;
    border-radius: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-slider__slide,
    .case-slider__slide::after {
      transition: none;
    }
  }
</style>
