---
/**
 * Воронка результатов: жёлтые столбики, высота — доля от первого шага (по процентам под ними),
 * под столбиком — процент (при появлении «досчитывает» от 0, CaseDrawer) и название шага. Столбики — с текстурой из макета (`texture`), «линия пола»
 * светится, над ней — жёлтая дымка. При докрутке до графика столбики вырастают с лёгким отскоком
 * (запускает CaseDrawer: `data-anim` hidden → play; если уйти вверх так, что график целиком ниже экрана, —
 * снова прячутся и при возвращении вырастают заново).
 */
import { typograph } from '../../i18n/typograph';
import { getLocaleFromUrl } from '../../i18n/utils';
import { asset } from '../../utils/asset';

type Item = { value: number; label: string; texture?: string };

interface Props {
  /** `label`: «\n» — принудительный перенос строки. `texture` — имя картинки в `public/images/cases/` без `.webp` (текстура столбика, 2x). */
  items?: Item[];
  /** Несколько графиков с переключателем над ними (например «Старая / Новая»); `active` — открытый сразу. */
  sets?: { label: string; items: Item[] }[];
  active?: number;
}

const { items = [], sets, active = 0 } = Astro.props;
const charts = sets ?? [{ label: '', items }];
// Шкала общая для всех графиков — высоты сравнимы между «старой» и «новой».
const max = Math.max(...charts.flatMap((set) => set.items.map((item) => item.value)));
const locale = getLocaleFromUrl(Astro.url) === 'ru' ? 'ru-RU' : 'en-US';
const format = (value: number) => `${value.toLocaleString(locale, { maximumFractionDigits: 2 })}%`;
const name = `metrics-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="case-metrics" data-metrics data-locale={locale}>
  {
    sets && (
      <div class="case-metrics__tabs" role="radiogroup">
        {sets.map((set, i) => (
          <label class="case-metrics__tab">
            <input type="radio" name={name} value={i} checked={i === active} data-metrics-tab />
            <span>{typograph(set.label)}</span>
          </label>
        ))}
      </div>
    )
  }
  {
    charts.map((set, k) => (
      <ol class="case-metrics__chart" data-set={k}>
        {set.items.map(({ value, label, texture }, i) => (
          <li class="case-metrics__col" style={`--share: ${value / max}; --i: ${i}`}>
            <div class="case-metrics__track">
              <div
                class="case-metrics__bar"
                style={texture ? `background-image: url(${asset(`/images/cases/${texture}.webp`)})` : undefined}
              />
            </div>
            <p class="case-metrics__value" data-value={value}>
              {format(value)}
            </p>
            <p class="case-metrics__label">
              {label.split('\n').map((line, j) => (
                <>
                  {j > 0 && <br />}
                  {typograph(line)}
                </>
              ))}
            </p>
          </li>
        ))}
      </ol>
    ))
  }
</div>

<style>
  /* Доля роста столбика (0 → 1, с отскоком) — числом, чтобы анимировать высоту через переменную. */
  .case-metrics {
    margin-block: var(--case-block-gap);
  }

  /* Переключатель графиков: по центру, капсом; выбранный — жёлтый с подчёркиванием. Без JS (радиокнопки + :has). */
  .case-metrics__tabs {
    display: flex;
    justify-content: center;
    gap: var(--case-metrics-tabs-gap);
    margin-bottom: var(--case-metrics-tabs-offset);
  }

  .case-metrics__tab {
    position: relative;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    color: var(--case-muted);
    font-size: var(--case-label-size);
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .case-metrics__tab:hover {
    color: var(--case-text);
  }

  .case-metrics__tab:has(input:checked) {
    border-color: var(--case-metrics-tab-line);
    color: var(--case-accent);
  }

  .case-metrics__tab:has(input:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: 4px;
  }

  .case-metrics__tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Показан только выбранный график. */
  .case-metrics:has(.case-metrics__tab input[value='0']:checked) .case-metrics__chart:not([data-set='0']),
  .case-metrics:has(.case-metrics__tab input[value='1']:checked) .case-metrics__chart:not([data-set='1']),
  .case-metrics:has(.case-metrics__tab input[value='2']:checked) .case-metrics__chart:not([data-set='2']),
  .case-metrics:has(.case-metrics__tab input[value='3']:checked) .case-metrics__chart:not([data-set='3']) {
    display: none;
  }

  /* Все шаги — всегда в один ряд. На узком контейнере (телефон) — лента с прокруткой вбок. */
  .case-metrics__chart {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: var(--case-metrics-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container case (max-width: 599px) {
    .case-metrics__chart {
      grid-auto-columns: var(--case-metrics-col-mobile);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .case-metrics__chart::-webkit-scrollbar {
      display: none;
    }

    .case-metrics {
      --case-metrics-radius: var(--case-metrics-radius-mobile);
    }

    /* В ленте колонки шире — подпись обычным кеглем текста кейса. */
    .case-metrics .case-metrics__label {
      font-size: var(--text-case-body);
    }
  }

  .case-metrics__track {
    --bar-h: round(calc(var(--share) * var(--case-bar-h)), 2px);
    position: relative;
    display: flex;
    align-items: flex-end;
    height: var(--case-bar-h);
  }

  /* Светящаяся линия пола — через зазоры, сплошной полосой. */
  .case-metrics__track::before,
  .case-metrics__track::after {
    content: '';
    position: absolute;
    left: calc(var(--case-metrics-gap) / -2);
    right: calc(var(--case-metrics-gap) / -2);
    bottom: 0;
    pointer-events: none;
  }

  /* Крайние столбики — линия и дымка не выходят за поля. */
  .case-metrics__col:first-child .case-metrics__track::before,
  .case-metrics__col:first-child .case-metrics__track::after {
    left: 0;
  }

  .case-metrics__col:last-child .case-metrics__track::before,
  .case-metrics__col:last-child .case-metrics__track::after {
    right: 0;
  }

  /* Дымка у крайних столбиков растворяется к краю (иначе у скруглённого угла торчал её прямоугольник). */
  .case-metrics__col:first-child .case-metrics__track::after {
    mask-image: linear-gradient(to right, transparent, #000 var(--case-metrics-radius));
  }

  .case-metrics__col:last-child .case-metrics__track::after {
    mask-image: linear-gradient(to left, transparent, #000 var(--case-metrics-radius));
  }

  .case-metrics__track::before {
    z-index: 2;
    height: 4px;
    background: var(--case-metrics-floor);
    box-shadow: 0 1px 14px 2px var(--case-metrics-floor);
  }

  /* Дымка над полом: снизу жёлтая, к верху прозрачная (поверх столбиков и зазоров). */
  .case-metrics__track::after {
    z-index: 1;
    height: round(calc(var(--case-bar-h) * 0.284), 2px);
    background: linear-gradient(to top, var(--case-metrics-haze), transparent);
  }

  .case-metrics__bar {
    width: 100%;
    height: var(--bar-h);
    /* Рост — трансформацией (на видеокарте, без перерисовки страницы): плавно и не дёргается. */
    transform-origin: bottom;
    border-radius: var(--case-metrics-radius) var(--case-metrics-radius) 0 0;
    background-color: var(--case-metrics-bar);
    /* Текстура — на весь столбик (растягивается вместе с ним, в том числе на отскоке). */
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  .case-metrics[data-anim='hidden'] .case-metrics__bar {
    transform: scaleY(0);
  }

  .case-metrics[data-anim='play'] .case-metrics__bar {
    animation: case-metrics-grow var(--case-metrics-duration) both;
    animation-delay: calc(var(--i) * var(--case-metrics-stagger));
  }

  /* Рост → чуть выше нужного → чуть ниже → на месте. */
  @keyframes case-metrics-grow {
    0% {
      transform: scaleY(0);
      animation-timing-function: cubic-bezier(0.25, 0.7, 0.35, 1);
    }

    62% {
      transform: scaleY(1.07);
      animation-timing-function: ease-in-out;
    }

    82% {
      transform: scaleY(0.98);
      animation-timing-function: ease-in-out;
    }

    100% {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-metrics .case-metrics__bar {
      transform: none !important;
      animation: none !important;
    }
  }

  .case-metrics__value {
    margin-top: 24px;
    /* Число уменьшается вместе с колонкой, чтобы помещаться в одну строку. */
    font-size: round(min(var(--case-metric-size), max(24px, 3.4cqi)), 1px);
    font-weight: var(--weight-heavy);
    white-space: nowrap;
    --lh: var(--leading-title);
    color: var(--case-text);
  }

  .case-metrics__label {
    margin-top: 4px;
    /* Подпись мельче на средних экранах, чтобы колонки не вытягивались. */
    font-size: round(min(var(--text-case-body), max(13px, 1.6cqi)), 1px);
    color: var(--case-muted);
  }
</style>
