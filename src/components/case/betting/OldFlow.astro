---

<figure class="flow">
  {label && <figcaption class="flow__label">{label}</figcaption>}
  <div class="flow__frame" tabindex="0">
    <svg class="flow__svg" viewBox="0 0 1320 849" role="img" aria-label={title}>
      <g class="flow__groups">
        {groups.map((g) => (
          <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="19.5" />
        ))}
      </g>
      <g class="flow__links">
        {links.map((d) => (
          <path d={d} />
        ))}
      </g>
      <g class="flow__notes">
        {notes.map((n) => (
          <text x={n.x} y={n.y - ((n.lines.length - 1) * LINE) / 2} text-anchor={n.anchor ?? 'middle'}>
            {n.lines.map((line, i) => (
              <tspan x={n.x} dy={i === 0 ? 0 : LINE}>
                {line}
              </tspan>
            ))}
          </text>
        ))}
      </g>
      <g class="flow__nodes">
        {nodes.map((n) => (
          <g class:list={['flow__node', n.tone && `flow__node--${n.tone}`]}>
            <rect x={n.x} y={n.y} width={n.w} height={H} rx="12" />
            <text x={n.x + n.w / 2} y={n.y + H / 2} text-anchor="middle">
              {n.label}
            </text>
          </g>
        ))}
      </g>
    </svg>
  </div>
</figure>

<style>
  .flow {
    margin-block: var(--case-block-gap);
  }

  .flow__label {
    margin-bottom: 1.25rem;
    font-size: var(--case-label-size);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--case-muted);
  }

  /* Уже --case-flow-min-w — схема листается по горизонтали, текст не мельчит. */
  .flow__frame {
    padding-bottom: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .flow__svg {
    display: block;
    width: 100%;
    min-width: var(--case-flow-min-w);
    height: auto;
    overflow: visible;
    font-family: inherit;
    font-size: 16px;
    user-select: none;
  }

  .flow__svg text {
    dominant-baseline: central;
  }

  .flow__groups rect {
    fill: none;
    stroke: var(--case-flow-node);
  }

  .flow__links path {
    fill: var(--case-flow-line);
  }

  /* Подписи поверх линий: обводка цветом фона «вырезает» линию под текстом. */
  .flow__notes text {
    fill: var(--case-muted);
    stroke: var(--case-surface);
    stroke-width: 10px;
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .flow__node rect {
    fill: var(--case-flow-node);
  }

  .flow__node text {
    fill: var(--case-text);
  }

  .flow__node--success rect {
    fill: var(--case-flow-success);
  }

  .flow__node--fail rect {
    fill: var(--case-flow-fail);
  }
</style>
