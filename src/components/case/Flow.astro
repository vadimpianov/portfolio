---
/**
 * Текст, перетекающий из левой колонки в правую (как в газете): абзацы идут подряд, колонки
 * выравниваются по высоте, абзац может переноситься в следующую колонку. Одна колонка — на узком контейнере.
 */
---

<div class="case-flow">
  <slot />
</div>

<style>
  .case-flow {
    margin-block: var(--case-block-gap);
  }

  /* Абзацы — без пустой строки между ними (начало абзаца отмечает только красная строка). */
  .case-flow > :global(*) {
    margin-top: 0 !important;
  }

  @container case (min-width: 800px) {
    .case-flow {
      columns: 2;
      column-gap: var(--case-col-gap);
      /* Колонку можно закончить и начать любой строкой — иначе висячие строки ломают равенство колонок. */
      orphans: 1;
      widows: 1;
    }

    /* Списки внутри тоже переносятся в следующую колонку (overflow у списков рядом с обложкой здесь не нужен). */
    .case-flow :global(ul) {
      overflow: visible !important;
    }
  }
</style>
