---
/** Подпись под экраном кейса: заголовок экрана (пояснения «Проблема / Решение» — в подсказках точек на экране). */
import type { SkyCopy } from './copy';

interface Props {
  c: SkyCopy;
  i: number;
}
const { c, i } = Astro.props;
const screen = c.screens[i]!;
---

<div class="notes">
  <h3>{screen.title}</h3>
</div>
