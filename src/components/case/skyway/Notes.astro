---
/** Пояснения под экраном кейса Skyway: «Проблема · …» и «Решение · …». */
import type { SkyCopy } from './copy';

interface Props {
  c: SkyCopy;
  i: number;
}
const { c, i } = Astro.props;
const screen = c.screens[i]!;
---

<div class="notes">
  <h3>{screen.title}</h3>
  {
    screen.pairs.map((p) => (
      <div class="pair">
        <div class="pb">
          <span class="lbl">{c.problem}</span>
          <span class="no2">{p.no}</span>
          {p.problem}
        </div>
        <div class="sl">
          <span class="lbl">{c.solution}</span>
          {p.solution}
        </div>
      </div>
    ))
  }
</div>
