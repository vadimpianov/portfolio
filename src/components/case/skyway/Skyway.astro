---
/**
 * Кейс Skyway (раздел «Прожарка»): вёрстка и интерактив — по странице пользователя «Skyway Tickets»
 * (свой светлый стиль, проблемы карточками, четыре живых экрана телефона с пояснениями).
 * Экраны оживляет `src/scripts/skyway.ts` (`initSkyway` в CaseDrawer). Тексты — `copy.ts`.
 */
import { getLocaleFromUrl } from '../../../i18n/utils';
import { COPY } from './copy';
import Notes from './Notes.astro';
import './skyway.css';

const lang = getLocaleFromUrl(Astro.url);
const c = COPY[lang];
const back = '<svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>';
---

<div class="sky" data-skyway data-lang={lang}>
  <div class="sky-intro">
    <div>
      <div class="sky-eyebrow">{c.eyebrow}</div>
      <h1 class="sky-h1">{c.title}</h1>
    </div>
    <div class="sky-lead">
      {c.lead.map((t) => <p>{t}</p>)}
      <p>{c.leadListTitle}</p>
      <ul>
        {c.leadList.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </div>

  <div class="sky-problems">
    {
      c.problems.map(([title, text, screens], i) => (
        <button type="button" class="sky-pr" data-go={screens[0] - 1}>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <b>{title}</b>
          <p>{text.replace(/\.$/, '')}</p>
        </button>
      ))
    }
  </div>

  <div class="sky-slider" data-k="bar">
  <div class="sky-screens" data-k="track">
    <!-- 1 · выдача -->
    <div class="sky-shot">
      <Notes c={c} i={0} />
      <div class="sky-phone">
        <div class="status"><span>9:41</span><span>●●● ▮</span></div>
        <div class="body">
          <div class="route">
            <div class="round" set:html={back} />
            <div class="txt">
              <b>{c.from} <svg width="14" height="14" viewBox="0 0 24 24" style="stroke:var(--accent)"><path d="M5 12h14M13 6l6 6-6 6" /></svg> {c.to}</b>
              <small>{c.routeSub}</small>
            </div>
            <div class="round"><svg width="16" height="16" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16z" /></svg></div>
          </div>
          <div class="dates" data-k="dates"></div>
          <div class="insight"><span set:html={c.insight} /><button type="button" class="follow" data-k="follow">{c.follow}</button></div>
          <div class="bagbar">
            <svg width="22" height="22" viewBox="0 0 24 24"><rect x="6" y="7" width="12" height="14" rx="2" /><path d="M9 7V4h6v3" /></svg>
            <div><b>{c.bag}</b><small data-k="bagsub">{c.bagOff}</small></div>
            <button type="button" class="sw" data-k="bagsw" aria-label={c.ariaBag}></button>
          </div>
          <div class="flights" data-k="flights"></div>
        </div>
      </div>
    </div>

    <!-- 2 · тариф -->
    <div class="sky-shot">
      <Notes c={c} i={1} />
      <div class="sky-phone">
        <div class="status"><span>9:41</span><span>●●● ▮</span></div>
        <div class="body">
          <div class="top"><div class="round" set:html={back} /><b>{c.fareTop}</b><small>{c.step(1)}</small></div>
          <div class="steps"><i class="on"></i><i></i><i></i></div>
          <div class="leg">
            <div class="t"><b>06:40</b><small>SVO</small></div>
            <div class="mid">{c.durations[0]}<div class="line"></div>{c.direct}</div>
            <div class="t"><b>09:25</b><small>AER</small></div>
          </div>
          <div class="fares" data-k="fares"></div>
          <div class="tip" data-k="ftip"></div>
        </div>
        <div class="sheet">
          <div class="row">
            <div><small data-k="f-sum"></small><div class="tot" data-k="f-tot"></div></div>
            <small class="right" set:html={c.allIn} />
          </div>
          <button type="button" class="btn" data-k="f-go"></button>
        </div>
      </div>
    </div>

    <!-- 3 · места -->
    <div class="sky-shot">
      <Notes c={c} i={2} />
      <div class="sky-phone">
        <div class="status"><span>9:41</span><span>●●● ▮</span></div>
        <div class="body">
          <div class="top"><div class="round" set:html={back} /><b>{c.seatsTop}</b><small>{c.step(2)}</small></div>
          <div class="steps"><i class="on"></i><i class="on"></i><i></i></div>
          <div class="together" data-k="together"></div>
          <div class="pax" data-k="pax"></div>
          <div class="legend">
            <span><i class="lg-free"></i>{c.free}</span>
            <span><i class="lg-xl"></i><span data-k="xl-price">{c.xl}</span></span>
            <span><i class="lg-taken"></i>{c.taken}</span>
          </div>
          <div class="cabin" data-k="cabin"></div>
        </div>
        <div class="sheet">
          <div class="exitwarn" data-k="exitwarn"></div>
          <div class="row">
            <div><small data-k="s-line"></small><div class="tot" data-k="s-tot"></div></div>
            <small class="right" set:html={c.regularFree} />
          </div>
          <button type="button" class="btn" data-k="s-go"></button>
          <button type="button" class="skip" data-k="skip"><b>{c.skip}</b><small>{c.skipSub}</small></button>
        </div>
      </div>
    </div>

    <!-- 4 · оформление -->
    <div class="sky-shot">
      <Notes c={c} i={3} />
      <div class="sky-phone">
        <div class="status"><span>9:41</span><span>●●● ▮</span></div>
        <div class="body">
          <div class="top"><div class="round" set:html={back} /><b>{c.checkTop}</b><small>{c.step(3)}</small></div>
          <div class="steps"><i class="on"></i><i class="on"></i><i class="on"></i></div>
          <div class="trip"><div><b>{c.tripDay}</b> <span>{c.tripTime}</span></div><span>SVO → AER</span></div>
          <div class="lock slim">
            <svg width="18" height="18" viewBox="0 0 24 24" style="flex-shrink:0"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
            <div set:html={c.locked} />
            <span class="tm" data-k="timer">18:00</span>
          </div>
          <div class="pcard slim">
            <div class="hd">{c.passenger1} <small>{c.saved}</small></div>
            <div class="sub">{c.passport}</div>
          </div>
          <div class="pcard">
            <div class="hd">
              {c.pax(2)}
              <button type="button" class="scan"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M7 12h10" /></svg>{c.scan}</button>
            </div>
            <div class="fields">
              <label class="fl"><small>{c.fields[0]}</small><input value={c.fieldValues[0]} /></label>
              <label class="fl"><small>{c.fields[1]}</small><input value={c.fieldValues[1]} /></label>
              <label class="fl"><small>{c.fields[2]}</small><input value="14.03.1990" /></label>
              <label class="fl" data-k="docf"><small>{c.fields[3]}</small><input data-k="doc" value="4510 12345" inputmode="numeric" /></label>
              <div class="ferr" data-k="docerr"></div>
            </div>
          </div>
          <label class="fl contact"><span><small>{c.contact}</small><input value="anna@example.ru" inputmode="email" /></span><span class="chip">{c.noReg}</span></label>
          <div class="addon">
            <div><span set:html={c.ins} /><small>{c.insSub}</small></div>
            <button type="button" class="sw" data-k="ins" aria-label={c.ariaIns}></button>
          </div>
        </div>
        <div class="sheet">
          <div class="row">
            <div><small>{c.toPay}</small><div class="tot" data-k="c-tot"></div></div>
            <button type="button" class="toggle" data-k="brk-t">{c.brkShow}</button>
          </div>
          <div class="brk" data-k="brk"></div>
          <button type="button" class="btn" data-k="pay"></button>
          <div class="fine" set:html={c.fine} />
        </div>
      </div>
    </div>
  </div>
    <div class="sky-ctrl">
      <button type="button" data-k="prev" aria-label={c.prev}><svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
      <button type="button" data-k="next" aria-label={c.next}><svg width="18" height="18" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
    </div>
  </div>
</div>
