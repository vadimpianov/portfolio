---
/** Две колонки текста рядом (на мобиле — одна под другой). Каждый ребёнок-`<div>` — колонка. */
---

<div class="case-columns">
  <slot />
</div>

<style>
  .case-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem var(--case-col-gap);
    margin-block: var(--case-block-gap);
  }

  @media (min-width: 1024px) {
    .case-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-columns > :global(*) > :global(:first-child) {
    margin-top: 0;
  }
</style>
