---
/** Две колонки текста рядом (на мобиле — одна под другой). Каждый ребёнок-`<div>` — колонка.
    `center` — колонки по середине друг друга (текст рядом с высокой картинкой). */
interface Props {
  center?: boolean;
}
const { center = false } = Astro.props;
---

<div class:list={['case-columns', { 'case-columns--center': center }]}>
  <slot />
</div>

<style>
  .case-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px var(--case-col-gap);
    margin-block: var(--case-block-gap);
  }

  /* Ширина — по контейнеру кейса (страница или модалка), не по экрану. */
  @container case (min-width: 800px) {
    .case-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .case-columns--center {
    align-items: center;
  }

  .case-columns--center > :global(*) > :global(:last-child) {
    margin-bottom: 0;
  }

  .case-columns > :global(*) > :global(:first-child) {
    margin-top: 0;
  }
</style>
