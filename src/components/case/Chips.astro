---
/** Чипсы внутри текста кейса (например, чем занимался в проекте). */
import { typograph } from '../../i18n/typograph';

interface Props {
  items: string[];
  /** Во всю ширину под обложкой (`clear`), даже если текст выше стоит рядом с ней (`TextColumns wrap`). */
  clear?: boolean;
  /** С `clear`: первые `split` чипсов — строкой рядом с обложкой (под текстом слева),
      остальные — во всю ширину сразу под обложкой. */
  split?: number;
}

const { items, clear = false, split = 0 } = Astro.props;
const beside = items.slice(0, split);
const rest = items.slice(split);
---

{
  beside.length > 0 && (
    <ul class="case-chips case-chips--beside">
      {beside.map((item) => (
        <li>{typograph(item)}</li>
      ))}
    </ul>
  )
}
<ul
  class:list={['case-chips', { 'case-chips--clear': clear, 'case-chips--after': beside.length > 0 }]}
  data-cover-below={clear ? '' : undefined}
>
  {rest.map((item) => (
    <li>{typograph(item)}</li>
  ))}
</ul>

<style>
  .case-chips {
    display: flex;
    flex-wrap: wrap;
    /* Между чипсами — как между тегами под заголовком (вдвое больше обычного зазора). */
    gap: calc(var(--chip-gap) * 2);
    /* От текста выше — 24px. */
    margin: var(--case-chips-gap) 0 0;
    padding: 0 !important;
    list-style: none;
  }

  .case-chips--clear {
    clear: both;
  }

  /* Строка рядом с обложкой — не уходит под неё (свой контекст, ужимается до левой колонки). */
  .case-chips--beside {
    overflow: hidden;
  }

  /* Рядом с обложкой не поместилась (CaseDrawer, centerCover) — под обложкой, как остальные. */
  .case-chips--beside:global(.is-under) {
    clear: both;
  }

  /* Продолжение под обложкой: от строки выше — как между чипсами. */
  .case-chips--after {
    margin-top: calc(var(--chip-gap) * 2);
  }

  .case-chips li {
    margin: 0 !important;
    /* По бокам — 12px (как у тегов под заголовком). */
    padding: var(--chip-pad-y) var(--case-chip-pad-x);
    border: 1px solid var(--case-chip-border);
    border-radius: var(--case-chip-radius);
    /* Шрифт — как у тегов под заголовком (основной текст кейса). */
    font-size: var(--text-case-body);
    --lh: var(--leading-tight);
    color: var(--color-text);
  }
</style>
