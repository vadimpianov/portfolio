---
/** Чипсы внутри текста кейса (например, чем занимался в проекте). */
import { typograph } from '../../i18n/typograph';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="case-chips">
  {items.map((item) => (
    <li>{typograph(item)}</li>
  ))}
</ul>

<style>
  .case-chips {
    display: flex;
    flex-wrap: wrap;
    /* Между чипсами — как между тегами под заголовком (вдвое больше обычного зазора). */
    gap: calc(var(--chip-gap) * 2);
    /* От текста выше — 24px. */
    margin: var(--case-chips-gap) 0 0;
    padding: 0 !important;
    list-style: none;
  }

  .case-chips li {
    margin: 0 !important;
    /* По бокам — 12px (как у тегов под заголовком). */
    padding: var(--chip-pad-y) var(--case-chip-pad-x);
    border: 1px solid var(--case-chip-border);
    border-radius: var(--case-chip-radius);
    /* Шрифт — как у тегов под заголовком (основной текст кейса). */
    font-size: var(--text-case-body);
    --lh: var(--leading-tight);
    color: var(--color-text);
  }
</style>
