---
import type { Locale } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import { asset } from '../utils/asset';

/** Слайд «Обо мне»: заголовок и четыре абзаца; ключевые фразы — тёмным маркером. */
const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const KEYS = ['about.p1', 'about.p2', 'about.p3', 'about.p4'] as const;
// В строках ui.ts выделение размечено **так**: чётные куски — обычный текст, нечётные — маркер.
const paragraphs = KEYS.map((key) => t(key).split(/\*\*(.+?)\*\*/));

// Контакты справа от текста: LinkedIn, телефон и QR-коды мессенджеров (по нажатию — открывают чат).
const LINKEDIN = 'https://www.linkedin.com/in/vadimpianov/';
// LinkedIn пока скрыт (пользователь попросил не удалять — вернуть: true).
const SHOW_LINKEDIN = false;
const PHONE = { href: 'tel:+79162946526', text: '+7 916 294-65-26' };
const QR = [
  { name: 'Telegram', href: 'https://t.me/V_PIANOV', src: '/images/contacts/telegram-qr.webp', width: 720, height: 720 },
  { name: 'MAX', href: 'https://max.ru/u/f9LHodD0cOLIhe5GYj0MB-fjlALlV6RZFHeCcu9iy5OBGh9YrfBTmLg7MTA', src: '/images/contacts/max-qr.webp', width: 720, height: 720 },
];
---

<section class="about" data-snap aria-labelledby="about-title">
  <h2 class="about__title" id="about-title">
    {t('about.title')}
  </h2>
  <div class="about__body">
    <div class="about__text">
      {paragraphs.map((parts) => (
        <p>{parts.map((part, i) => (i % 2 ? <mark>{part}</mark> : part))}</p>
      ))}
    </div>
    <aside class="about__contacts" aria-label={t('about.contacts')}>
      <p class="about__label">{t('about.contacts')}</p>
      <a class="about__phone" href={PHONE.href} aria-label={`${t('about.phone.label')} ${PHONE.text}`}>{PHONE.text}</a>
      {SHOW_LINKEDIN && (
        <a class="about__row" href={LINKEDIN} target="_blank" rel="noopener">
          <span>LinkedIn</span>
          <svg class="about__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </a>
      )}
      <div class="about__qrs">
        {QR.map((qr) => (
          <a class="about__qr" href={qr.href} target="_blank" rel="noopener">
            <span class="about__qr-card">
              <img src={asset(qr.src)} width={qr.width} height={qr.height} alt={`QR ${qr.name}`} loading="lazy" decoding="async" />
            </span>
            <span class="about__qr-name">
              {qr.name}
              <svg class="about__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</section>

<style>
  /* Отдельный слайд поверх того же серого фона hero; контент — в полях сетки.
     Как у карточек: доводка ставит верх слайда на --tiles-final-top от верха экрана (под шапкой). */
  .about {
    min-height: round(calc(100svh - var(--tiles-final-top)), 2px);
    padding: 0 var(--gutter) var(--tile-gap);
    color: var(--color-text);
  }

  .about__title {
    color: #fff;
    font-size: var(--text-display);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  /* Текст слева, контакты справа (на узких — под текстом). */
  .about__body {
    display: grid;
    grid-template-columns: minmax(0, 832px);
    gap: 48px;
    margin-top: round(clamp(24px, 16px + 1.5vw, 48px), 2px);
  }

  @media (min-width: 1024px) {
    .about__body {
      grid-template-columns: minmax(0, 832px) auto;
      justify-content: space-between;
      align-items: start;
    }
  }

  .about__text {
    font-size: var(--text-about);
    --lh: 1.55;
    /* Текст — белый, выделения — чёрной плашкой (по просьбе пользователя). */
    color: #fff;
  }

  .about__text p + p {
    margin-top: round(1.1em, 2px);
  }

  /* Маркер: жёлтая плашка (акцент сайта), чёрный текст; на переносе строки плашка не рвётся. */
  .about__text mark {
    padding: 2px round(0.25em, 2px);
    background: var(--case-accent);
    color: var(--color-text);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* Контакты — тёмная карточка в цвет маркеров текста: крупный телефон, LinkedIn со стрелкой,
     QR-коды мессенджеров (на наведении карточка QR выпрямляется из наклона и поднимается). */
  .about__contacts {
    display: grid;
    gap: 20px;
    width: round(clamp(320px, 24vw, 420px), 2px);
    padding: 32px;
    border-radius: 24px;
    background: rgb(20 20 20 / 0.92);
    color: #fff;
    box-shadow: 0 24px 48px rgb(0 0 0 / 0.18);
  }

  @media (max-width: 1023px) {
    .about__contacts {
      width: 100%;
      max-width: 480px;
      padding: 24px;
    }
  }

  .about__label {
    color: rgb(255 255 255 / 0.56);
    font-size: var(--text-tile-lead);
    --lh: var(--leading-tight);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .about__phone {
    margin-top: -8px;
    color: #fff;
    font-size: round(clamp(24px, 14px + 1.2vw, 34px), 1px);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    letter-spacing: var(--tracking-title);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .about__phone:hover {
    color: var(--case-accent);
  }

  .about__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    border-block: 1px solid rgb(255 255 255 / 0.14);
    color: #fff;
    font-size: var(--text-about);
    --lh: var(--leading-tight);
    text-decoration: none;
  }

  .about__arrow {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.25s ease;
  }

  .about__row:hover .about__arrow,
  .about__qr:hover .about__arrow {
    translate: 4px -4px;
  }

  .about__qrs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 4px;
  }

  .about__qr {
    display: grid;
    gap: 12px;
    color: #fff;
    text-decoration: none;
  }

  /* QR — ровно, на белой подложке: на тёмной карточке без неё цветной код (особенно плотный MAX) не считывается.
     Наведение — как у LinkedIn: сдвигается только стрелка. */
  .about__qr-card {
    display: block;
    padding: 10px;
    border-radius: 16px;
    background: #fff;
  }

  .about__qr-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .about__qr-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Как у строки LinkedIn: тот же кегль, обычное начертание. */
    font-size: var(--text-about);
    --lh: var(--leading-tight);
  }

</style>
