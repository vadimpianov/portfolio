---
import type { Locale } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
import { typograph } from '../i18n/typograph';
import { asset } from '../utils/asset';

/** Слайд «Обо мне»: заголовок и четыре абзаца; ключевые фразы — тёмным маркером. */
const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const KEYS = ['about.p1', 'about.p2', 'about.p3', 'about.p4'] as const;
// В строках ui.ts выделение размечено **так**: чётные куски — обычный текст, нечётные — маркер.
const paragraphs = KEYS.map((key) => t(key).split(/\*\*(.+?)\*\*/));

// Контакты справа от текста: LinkedIn, телефон и QR-коды мессенджеров (по нажатию — открывают чат).
const LINKEDIN = 'https://www.linkedin.com/in/vadimpianov/';
const PHONE = { href: 'tel:+79162946526', text: '+7 916 294-65-26' };
const QR = [
  { name: 'Telegram', href: 'https://t.me/V_PIANOV', src: '/images/contacts/telegram-qr.webp', width: 1695, height: 2000 },
  { name: 'MAX', href: 'https://max.ru/u/f9LHodD0cOLIhe5GYj0MB-fjlALlV6RZFHeCcu9iy5OBGh9YrfBTmLg7MTA', src: '/images/contacts/max-qr.webp', width: 530, height: 780 },
];
---

<section class="about" data-snap aria-labelledby="about-title">
  <h2 class="about__title" id="about-title">
    {t('about.title')}
  </h2>
  <div class="about__body">
    <div class="about__text">
      {paragraphs.map((parts) => (
        <p>{parts.map((part, i) => (i % 2 ? <mark>{part}</mark> : part))}</p>
      ))}
    </div>
    <aside class="about__contacts" aria-label={t('about.contacts')}>
      <a class="about__link" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
      <a class="about__link" href={PHONE.href} aria-label={`${t('about.phone.label')} ${PHONE.text}`}>{PHONE.text}</a>
      <div class="about__qrs">
        {QR.map((qr) => (
          <a class="about__qr" href={qr.href} target="_blank" rel="noopener">
            <span class="about__qr-card">
              <img src={asset(qr.src)} width={qr.width} height={qr.height} alt={`QR ${qr.name}`} loading="lazy" decoding="async" />
            </span>
            <span class="about__qr-name">{qr.name}</span>
          </a>
        ))}
      </div>
      <p class="about__hint">{typograph(t('about.qr.hint'))}</p>
    </aside>
  </div>
</section>

<style>
  /* Отдельный слайд поверх того же серого фона hero; контент — в полях сетки.
     Как у карточек: доводка ставит верх слайда на --tiles-final-top от верха экрана (под шапкой). */
  .about {
    min-height: round(calc(100svh - var(--tiles-final-top)), 2px);
    padding: 0 var(--gutter) var(--tile-gap);
    color: var(--color-text);
  }

  .about__title {
    font-size: var(--text-display);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  /* Текст слева, контакты справа (на узких — под текстом). */
  .about__body {
    display: grid;
    grid-template-columns: minmax(0, 832px);
    gap: 48px;
    margin-top: round(clamp(24px, 16px + 1.5vw, 48px), 2px);
  }

  @media (min-width: 1024px) {
    .about__body {
      grid-template-columns: minmax(0, 832px) auto;
      justify-content: space-between;
      align-items: start;
    }
  }

  .about__text {
    font-size: var(--text-about);
    --lh: 1.55;
    /* Текст — белый, выделения — чёрной плашкой (по просьбе пользователя). */
    color: #fff;
  }

  .about__text p + p {
    margin-top: round(1.1em, 2px);
  }

  /* Маркер: чёрная плашка, белый текст; на переносе строки плашка не рвётся. */
  .about__text mark {
    padding: 2px round(0.25em, 2px);
    background: var(--color-text);
    color: #fff;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .about__contacts {
    display: grid;
    justify-items: start;
    gap: 12px;
    color: #fff;
    font-size: var(--text-about);
    --lh: 1.55;
  }

  .about__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: opacity 0.2s;
  }

  .about__link:hover {
    opacity: 0.7;
  }

  /* QR-коды — белые карточки одной высоты; по нажатию открывают чат. */
  .about__qrs {
    display: flex;
    gap: 16px;
    margin-top: 12px;
  }

  .about__qr {
    display: grid;
    justify-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .about__qr-card {
    display: block;
    padding: 12px;
    border-radius: 16px;
    background: #fff;
    transition: translate 0.2s;
  }

  .about__qr:hover .about__qr-card {
    translate: 0 -4px;
  }

  .about__qr-card img {
    display: block;
    width: auto;
    height: round(clamp(160px, 12vw, 220px), 2px);
  }

  .about__qr-name,
  .about__hint {
    font-size: var(--text-tile-lead);
    --lh: var(--leading-tight);
  }

  .about__hint {
    opacity: 0.8;
  }
</style>
