---
import type { Locale } from '../i18n/ui';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

/** Слайд «Обо мне»: заголовок и четыре абзаца; ключевые фразы — тёмным маркером. */
const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const KEYS = ['about.p1', 'about.p2', 'about.p3', 'about.p4'] as const;
// В строках ui.ts выделение размечено **так**: чётные куски — обычный текст, нечётные — маркер.
const paragraphs = KEYS.map((key) => t(key).split(/\*\*(.+?)\*\*/));
---

<section class="about" data-snap aria-labelledby="about-title">
  <h2 class="about__title" id="about-title">
    {t('about.title')}
  </h2>
  <div class="about__text">
    {paragraphs.map((parts) => (
      <p>{parts.map((part, i) => (i % 2 ? <mark>{part}</mark> : part))}</p>
    ))}
  </div>
</section>

<style>
  /* Отдельный слайд поверх того же серого фона hero; контент — в полях сетки.
     Как у карточек: доводка ставит верх слайда на --tiles-final-top от верха экрана (под шапкой). */
  .about {
    min-height: round(calc(100dvh - var(--tiles-final-top)), 2px);
    padding: 0 var(--gutter) var(--tile-gap);
    color: var(--color-text);
  }

  .about__title {
    font-size: var(--text-display);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .about__text {
    max-width: 832px;
    margin-top: round(clamp(24px, 16px + 1.5vw, 48px), 2px);
    font-size: var(--text-about);
    --lh: 1.55;
    color: var(--color-text-body);
  }

  .about__text p + p {
    margin-top: round(1.1em, 2px);
  }

  /* Маркер: белая плашка, тёмный текст; на переносе строки плашка не рвётся. */
  .about__text mark {
    padding: 2px round(0.25em, 2px);
    background: #fff;
    color: var(--color-text);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>
