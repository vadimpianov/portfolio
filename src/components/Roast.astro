---
/**
 * Раздел «Отраслевая прожарка» под «Обо мне»: небольшие плитки кейсов, все четыре — в один ряд на ширину экрана
 * (на телефоне — 2 × 2). Пока кейсов нет — плитки-заготовки с меткой «Кейс в разработке».
 */
import { getLocaleFromUrl, localePath, useTranslations } from '../i18n/utils';
import SkywayArt from './roast/SkywayArt.astro';
import BankingArt from './roast/BankingArt.astro';

interface Props {
  /** Блок «Другие кейсы» внизу кейса прожарки: те же плитки в два раза компактнее, без текущего кейса. */
  compact?: boolean;
  /** Слаг текущего кейса — его плитку не показываем. */
  current?: string;
}
const { compact = false, current } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
// Плитки по порядку; у готового кейса — название, подпись и ссылка (открывается в модалке, как остальные кейсы).
// Обложка плитки — постер в общем стиле раздела (см. `roast/SkywayArt.astro`): у каждого кейса своя картинка.
const ITEMS: { n: string; slug?: string; title?: string; lead?: string; art?: typeof SkywayArt; accent?: string }[] = [
  { n: '01', slug: 'banking', title: t('roast.banking'), art: BankingArt, accent: '#5b5bd6' },
  { n: '02', slug: 'skyway', title: t('roast.skyway'), art: SkywayArt, accent: '#ff5b36' },
  { n: '03' },
  { n: '04' },
];
const items = ITEMS.filter((item) => !item.slug || item.slug !== current);
const titleId = compact ? 'roast-others-title' : 'roast-title';
// В кейсе — не h2: кейсы со своими стилями (`.sky`) сбрасывают заголовки.
const Title = compact ? 'div' : 'h2';
---

<section class:list={['roast', { 'roast--compact': compact }]} data-snap={compact ? undefined : ''} aria-labelledby={titleId}>
  <Title class="roast__title" id={titleId} role={compact ? 'heading' : undefined} aria-level={compact ? 2 : undefined}>
    {compact ? t('case.others') : t('roast.title')}
  </Title>
  <ul class="roast__list">
    {
      items.map((item) =>
        item.slug ? (
          <li class="roast__item roast__item--case" style={item.accent && `--roast-accent: ${item.accent}`}>
            {item.art && <item.art />}
            <span class="roast__num">{item.n}</span>
            <span class="roast__name">
              <a class="roast__link" href={localePath(locale, `cases/${item.slug}`)} data-case-link>
                {item.title}
              </a>
              {item.lead && <small>{item.lead}</small>}
            </span>
          </li>
        ) : (
          <li class="roast__item">
            <span class="roast__num">{item.n}</span>
            <span class="roast__soon">
              <i aria-hidden="true" />
              {t('case.soon')}
            </span>
          </li>
        ),
      )
    }
  </ul>
</section>

<style>
  /* Слайд на том же фоне, что «Обо мне»; доводка ставит его верх на --tiles-final-top. */
  .roast {
    padding: 0 var(--gutter) var(--tile-gap);
  }

  .roast__title {
    color: #fff;
    font-size: var(--text-display);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  /* Все четыре плитки — в ряд на ширину между полями; на телефоне — 2 × 2. */
  .roast__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: round(clamp(24px, 16px + 1.5vw, 48px), 2px) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .roast__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: round(clamp(16px, 8px + 1vw, 24px), 2px);
    }
  }

  /* Плитка — тёмная карточка, как контакты на «Обо мне». */
  .roast__item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    aspect-ratio: 3 / 4;
    padding: round(clamp(16px, 8px + 1vw, 24px), 2px);
    border-radius: 24px;
    background: rgb(20 20 20 / 0.92);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.16);
    color: #fff;
  }

  /* Готовый кейс: ссылка растянута на всю плитку; на наведении плитка приподнимается. */
  .roast__item--case {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #f4efe8;
    color: #1a1a1f;
    transition:
      translate 0.3s ease,
      box-shadow 0.3s ease;
  }

  .roast__item--case:hover {
    translate: 0 -6px;
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.2);
  }

  .roast__item--case .roast__num {
    /* Цвет номера — акцент кейса (ITEMS). */
    color: var(--roast-accent, #ff5b36);
  }

  .roast__name {
    display: grid;
    gap: 4px;
  }

  .roast__link {
    color: inherit;
    font-size: round(clamp(22px, 14px + 1vw, 32px), 1px);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    letter-spacing: var(--tracking-title);
    text-decoration: none;
  }

  .roast__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .roast__link:focus-visible {
    outline: none;
  }

  .roast__item--case:has(.roast__link:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: 4px;
  }

  .roast__name small {
    color: #7b7770;
    font-size: var(--text-chip);
    --lh: var(--leading-tight);
  }

  .roast__num {
    color: var(--case-accent);
    font-size: round(clamp(28px, 16px + 1.6vw, 48px), 1px);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
  }

  .roast__soon {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgb(255 255 255 / 0.72);
    font-size: var(--text-chip);
    --lh: var(--leading-tight);
  }

  .roast__soon i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--case-accent);
    animation: roast-pulse 1.6s ease-in-out infinite;
  }

  @keyframes roast-pulse {
    50% {
      opacity: 0.3;
    }
  }

  /* «Другие кейсы» внизу кейса: 3 плитки в ряд на всю ширину текста кейса; размеры — от ширины
     контейнера кейса (на 1728 — почти как на главной, на телефоне — мельче). */
  /* Заголовок — как заголовки разделов в кейсах: --text-tile-title, вес 600, сверху 80px, до плиток 24px. */
  .roast--compact {
    margin-top: var(--case-tabs-section-gap);
    padding: 0;
  }

  .roast--compact .roast__title {
    color: var(--color-text);
    font-size: var(--text-tile-title);
    font-weight: 600;
    --lh: var(--leading-title);
    letter-spacing: var(--tracking-title);
  }

  .roast--compact .roast__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--case-col-gap);
    margin-top: var(--case-tabs-heading-text-gap);
  }

  .roast--compact .roast__item {
    gap: 8px;
    padding: round(clamp(12px, 2cqi, 24px), 2px);
    border-radius: round(clamp(12px, 2cqi, 24px), 2px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
  }

  .roast--compact .roast__item--case:hover {
    translate: 0 -6px;
  }

  .roast--compact .roast__num {
    font-size: round(clamp(24px, 4cqi, 44px), 1px);
  }

  /* На телефоне плитка около 100px: длинное слово («авиабилетов») — мельче и с переносом. */
  .roast--compact .roast__link {
    font-size: round(clamp(12px, 2.6cqi, 28px), 1px);
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .roast--compact .roast__soon {
    gap: 6px;
    font-size: round(clamp(11px, 1.4cqi, 15px), 1px);
  }

  .roast--compact .roast__soon i {
    width: 6px;
    height: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .roast__soon i {
      animation: none;
    }
  }
</style>
