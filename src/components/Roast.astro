---
/**
 * Раздел «Прожарка» под «Обо мне»: небольшие плитки кейсов, все четыре — в один ряд на ширину экрана
 * (на телефоне — 2 × 2). Пока кейсов нет — плитки-заготовки с меткой «Кейс в разработке».
 */
import { getLocaleFromUrl, localePath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
// Плитки по порядку; у готового кейса — название, подпись и ссылка (открывается в модалке, как остальные кейсы).
const ITEMS: { n: string; slug?: string; title?: string; lead?: string }[] = [
  { n: '01' },
  { n: '02', slug: 'skyway', title: 'Skyway', lead: 'Travel booking' },
  { n: '03' },
  { n: '04' },
];
---

<section class="roast" data-snap aria-labelledby="roast-title">
  <h2 class="roast__title" id="roast-title">{t('roast.title')}</h2>
  <ul class="roast__list">
    {
      ITEMS.map((item) =>
        item.slug ? (
          <li class="roast__item roast__item--case">
            <span class="roast__num">{item.n}</span>
            <span class="roast__name">
              <a class="roast__link" href={localePath(locale, `cases/${item.slug}`)} data-case-link>
                {item.title}
              </a>
              <small>{item.lead}</small>
            </span>
          </li>
        ) : (
          <li class="roast__item">
            <span class="roast__num">{item.n}</span>
            <span class="roast__soon">
              <i aria-hidden="true" />
              {t('case.soon')}
            </span>
          </li>
        ),
      )
    }
  </ul>
</section>

<style>
  /* Слайд на том же фоне, что «Обо мне»; доводка ставит его верх на --tiles-final-top. */
  .roast {
    padding: 0 var(--gutter) var(--tile-gap);
  }

  .roast__title {
    color: #fff;
    font-size: var(--text-display);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  /* Все четыре плитки — в ряд на ширину между полями; на телефоне — 2 × 2. */
  .roast__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: round(clamp(24px, 16px + 1.5vw, 48px), 2px) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .roast__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: round(clamp(16px, 8px + 1vw, 24px), 2px);
    }
  }

  /* Плитка — тёмная карточка, как контакты на «Обо мне». */
  .roast__item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    aspect-ratio: 3 / 4;
    padding: round(clamp(16px, 8px + 1vw, 24px), 2px);
    border-radius: 24px;
    background: rgb(20 20 20 / 0.92);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.16);
    color: #fff;
  }

  /* Готовый кейс: ссылка растянута на всю плитку; на наведении плитка приподнимается. */
  .roast__item--case {
    position: relative;
    background: #f4efe8;
    color: #1a1a1f;
    transition:
      translate 0.3s ease,
      box-shadow 0.3s ease;
  }

  .roast__item--case:hover {
    translate: 0 -6px;
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.2);
  }

  .roast__item--case .roast__num {
    color: #ff5b36;
  }

  .roast__name {
    display: grid;
    gap: 4px;
  }

  .roast__link {
    color: inherit;
    font-size: round(clamp(22px, 14px + 1vw, 32px), 1px);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
    letter-spacing: var(--tracking-title);
    text-decoration: none;
  }

  .roast__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .roast__link:focus-visible {
    outline: none;
  }

  .roast__item--case:has(.roast__link:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: 4px;
  }

  .roast__name small {
    color: #7b7770;
    font-size: var(--text-chip);
    --lh: var(--leading-tight);
  }

  .roast__num {
    color: var(--case-accent);
    font-size: round(clamp(28px, 16px + 1.6vw, 48px), 1px);
    font-weight: var(--weight-heavy);
    --lh: var(--leading-title);
  }

  .roast__soon {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgb(255 255 255 / 0.72);
    font-size: var(--text-chip);
    --lh: var(--leading-tight);
  }

  .roast__soon i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--case-accent);
    animation: roast-pulse 1.6s ease-in-out infinite;
  }

  @keyframes roast-pulse {
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roast__soon i {
      animation: none;
    }
  }
</style>
