---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

/**
 * Кейс в модалке поверх главной: панель выезжает справа, главная затемнена и остаётся на месте.
 * Ссылки с `data-case-link` открывают кейс здесь; содержимое берётся со страницы кейса
 * (`/<lang>/cases/<slug>/`, она же открывается напрямую и после перезагрузки).
 * Адрес меняется на адрес кейса — «Назад» закрывает панель.
 */
interface Props {
  /** Открыта сразу (адрес кейса: прямой заход или перезагрузка); кейс — в слоте. */
  open?: boolean;
}

const { open = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const close = t('case.close');
---

{/* Фокус при открытии — на сам диалог (не на кнопку и не на панель за краем экрана:
    фокус на ней прокручивал диалог вбок, и панель дёргалась при выезде). */}
<dialog
  class="case-drawer"
  data-case-drawer
  data-bleed
  aria-label={close}
  tabindex="-1"
  autofocus
  data-open-on-load={open ? '' : undefined}
  data-home-url={`/${locale}/`}
  data-home-title={t('site.title')}
>
  <div class="case-drawer__backdrop" data-case-close></div>
  <div class="case-drawer__panel">
    <button class="case-drawer__close" type="button" aria-label={close} data-case-close>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
    {/* После выезда фокус — на содержимое: стрелки и пробел листают кейс. */}
    <div class="case-drawer__scroll" tabindex="-1" data-lenis-prevent data-case-body>
      <slot />
    </div>
  </div>
</dialog>

<style>
  .case-drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    /* clip, а не hidden: hidden-контейнер можно прокрутить программно (фокусом) — панель прыгала. */
    overflow: clip;
    outline: none;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .case-drawer::backdrop {
    background: transparent;
  }

  .case-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: var(--case-panel-backdrop);
    opacity: 0;
    transition: opacity var(--case-panel-duration) ease;
  }

  .case-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--case-panel-w);
    transform: translateX(100%);
    transition: transform var(--case-panel-duration) var(--case-panel-ease);
    will-change: transform;
    box-shadow: -24px 0 64px rgb(0 0 0 / 0.18);
  }

  .case-drawer.is-open .case-drawer__backdrop {
    opacity: 1;
  }

  .case-drawer.is-open .case-drawer__panel {
    transform: none;
  }

  /* Внутри панели — свои поля, кейс считает ширину по панели (container query). */
  .case-drawer__scroll {
    --gutter: var(--case-panel-gutter);
    /* Сверху до контента — столько же, сколько слева (поле панели). */
    --case-pad-top: var(--case-panel-gutter);
    /* Панель уже экрана — шрифты кейса мельче, чем на отдельной странице (целые px). */
    --text-display: round(clamp(28px, 18px + 1.8vw, 44px), 1px);
    --text-tile-title: round(clamp(22px, 18px + 0.8vw, 32px), 1px);
    --text-case-body: round(clamp(15px, 14px + 0.15vw, 17px), 1px);
    --case-label-size: round(clamp(13px, 12px + 0.12vw, 15px), 1px);
    --case-metric-size: round(clamp(24px, 18px + 1vw, 36px), 1px);
    --text-chip: round(clamp(13px, 12px + 0.1vw, 14px), 1px);
    height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    /* Без «резинки»: панель не оттягивается от верха/низа и не болтается вбок — только листается. */
    overscroll-behavior: none;
    outline: none;
  }

  /* Закрыть — крестик в квадрате со скруглением. */
  .case-drawer__close {
    position: absolute;
    top: calc((var(--header-h) - var(--case-close-size)) / 2);
    right: var(--case-panel-gutter);
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--case-close-size);
    height: var(--case-close-size);
    padding: 0;
    border: 0;
    border-radius: var(--case-close-radius);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: background-color 0.2s ease;
  }

  .case-drawer__close svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .case-drawer__close:hover {
    background: rgb(255 255 255 / 0.2);
  }

  .case-drawer__close:focus-visible {
    outline: 2px solid rgb(255 255 255 / 0.6);
    outline-offset: 2px;
  }

  /* Открыта при загрузке (адрес кейса) — сразу на месте, без выезда. */
  .case-drawer.is-instant .case-drawer__backdrop,
  .case-drawer.is-instant .case-drawer__panel {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-drawer__backdrop,
    .case-drawer__panel {
      transition: none;
    }
  }
</style>

<script>
  import { getLenis } from '../scripts/motion';

  // caseDrawer — кейс открыт ссылкой с главной (закрыть = «назад»);
  // caseDirect — открыт сразу по адресу кейса (закрыть = заменить адрес на главную).
  type State = { caseDrawer?: string; caseDirect?: boolean } | null;

  declare global {
    interface Window {
      __casePopstate?: (event: PopStateEvent) => boolean;
    }
  }

  const pages = new Map<string, Promise<Document>>();
  const load = (url: string) => {
    let page = pages.get(url);
    if (!page) {
      page = fetch(url)
        .then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))))
        .then((html) => new DOMParser().parseFromString(html, 'text/html'));
      page.catch(() => pages.delete(url));
      pages.set(url, page);
    }
    return page;
  };

  /** Стили страницы кейса (компоненты кейса) — в текущий документ, если их там ещё нет. */
  const addStyles = (doc: Document) => {
    const waits: Promise<unknown>[] = [];
    doc.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]').forEach((l) => {
      const href = l.getAttribute('href');
      if (!href || document.head.querySelector(`link[rel="stylesheet"][href="${CSS.escape(href)}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      waits.push(new Promise((done) => (link.onload = link.onerror = done)));
      document.head.append(link);
    });
    const have = new Set([...document.head.querySelectorAll('style')].map((s) => s.textContent));
    doc.head.querySelectorAll('style').forEach((s) => {
      if (have.has(s.textContent)) return;
      const style = document.createElement('style');
      style.textContent = s.textContent;
      document.head.append(style);
    });
    return Promise.all(waits);
  };

  const drawer = () => document.querySelector<HTMLDialogElement>('[data-case-drawer]');
  const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const duration = () =>
    reducedMotion()
      ? 0
      : parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--case-panel-duration')) *
        1000;

  let pageTitle = '';
  let openedByPointer = false;
  let closing = 0;

  async function open(url: string, push: boolean) {
    const dialog = drawer();
    const body = dialog?.querySelector<HTMLElement>('[data-case-body]');
    if (!dialog || !body) return (location.href = url);
    let doc: Document;
    try {
      doc = await load(url);
    } catch {
      return (location.href = url);
    }
    const article = doc.querySelector('article.case');
    if (!article) return (location.href = url);
    await addStyles(doc);

    clearTimeout(closing);
    body.replaceChildren(document.importNode(article, true));
    body.scrollTop = 0;
    if (!dialog.open) pageTitle = document.title;
    document.title = doc.title;
    if (push) history.pushState({ ...history.state, caseDrawer: url }, '', url);
    if (!dialog.open) {
      dialog.showModal();
      // Панель выезжает, только когда кейс уже разложен и обложка готова: иначе первые кадры
      // анимации теряются на раскладке и панель «прыгает».
      const cover = body.querySelector<HTMLImageElement>('.case__cover');
      await Promise.race([cover?.decode().catch(() => {}), new Promise((r) => setTimeout(r, 400))]);
      await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
    }
    document.documentElement.classList.add('case-open');
    getLenis()?.stop();
    dialog.classList.add('is-open');
    // После выезда — фокус на содержимое (без прокрутки к нему).
    window.setTimeout(() => {
      if (dialog.classList.contains('is-open')) body.focus({ preventScroll: true });
    }, duration());
  }

  /** Скрыть панель (адрес уже вернулся на главную). */
  function hide(immediate = false) {
    const dialog = drawer();
    if (!dialog?.open) return;
    dialog.classList.remove('is-open');
    document.title = pageTitle;
    const done = () => {
      dialog.close();
      // Открыли мышью — фокус, который браузер вернул на плитку, без рамки.
      if (openedByPointer) (document.activeElement as HTMLElement | null)?.blur();
      dialog.querySelector('[data-case-body]')?.replaceChildren();
      getLenis()?.start();
      document.documentElement.classList.remove('case-open');
    };
    clearTimeout(closing);
    if (immediate) done();
    else closing = window.setTimeout(done, duration());
  }

  /** Закрыть по кнопке, клику мимо или Esc: шаг назад по истории, если панель открыта ссылкой. */
  function close() {
    const state = history.state as State;
    if (state?.caseDrawer) return history.back();
    if (state?.caseDirect) {
      // Открыта по адресу кейса: назад — некуда (или чужой сайт), поэтому адрес меняем на главную.
      const home = drawer()?.dataset.homeUrl ?? '/';
      const { caseDirect: _, ...rest } = state;
      history.replaceState(rest, '', home);
      // Переключатель языка вёл на тот же кейс на другом языке — теперь на главную.
      document.querySelectorAll<HTMLAnchorElement>('a[data-set-lang]').forEach((a) => {
        a.href = `/${a.dataset.setLang}/`;
      });
    }
    hide();
  }

  /** Адрес кейса: модалка уже открыта при загрузке — без выезда, главная за ней стоит на месте. */
  function openOnLoad() {
    const dialog = drawer();
    const body = dialog?.querySelector<HTMLElement>('[data-case-body]');
    if (!dialog || !body || dialog.open || !('openOnLoad' in dialog.dataset)) return;
    delete dialog.dataset.openOnLoad;
    pageTitle = dialog.dataset.homeTitle ?? document.title;
    history.replaceState({ ...history.state, caseDirect: true }, '');
    dialog.classList.add('is-instant', 'is-open');
    dialog.showModal();
    document.documentElement.classList.add('case-open');
    getLenis()?.stop();
    body.focus({ preventScroll: true });
    requestAnimationFrame(() => requestAnimationFrame(() => dialog.classList.remove('is-instant')));
  }

  document.addEventListener(
    'click',
    (event) => {
      const target = event.target as Element | null;
      if (target?.closest('[data-case-close]') && drawer()?.open) return close();
      const link = target?.closest<HTMLAnchorElement>('a[data-case-link]');
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      // Фаза захвата — раньше слушателя ClientRouter: он не переходит, если событие уже отменено.
      event.preventDefault();
      openedByPointer = event.detail > 0;
      open(link.href, true);
    },
    { capture: true },
  );

  // «Назад»/«Вперёд» между главной и открытым кейсом — только панель, без перехода страницы.
  // Вызывается из слушателя в <head> (BaseLayout), который стоит раньше слушателя ClientRouter.
  window.__casePopstate = (event) => {
    const dialog = drawer();
    if (!dialog) return false;
    const url = (event.state as State)?.caseDrawer;
    if (url) open(url, false);
    else if (dialog.open) hide();
    else return false;
    return true;
  };

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer()?.open) {
      event.preventDefault();
      close();
    }
  });

  // Перед сменой страницы панель закрывается сразу, прокрутка страницы включается.
  document.addEventListener('astro:before-swap', () => hide(true));

  // Кейсы загружаются заранее — панель открывается без ожидания.
  document.addEventListener('astro:page-load', () => {
    openOnLoad();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-case-link]')];
    if (!links.length) return;
    const idle = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 1500));
    // Стили кейса — только в кэш браузера: в документ они попадут при открытии.
    const warm = (doc: Document) =>
      doc.head
        .querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')
        .forEach((l) => fetch(l.href).catch(() => {}));
    idle(() =>
      links.forEach((l) =>
        load(l.href)
          .then(warm)
          .catch(() => {}),
      ),
    );
  });
</script>
